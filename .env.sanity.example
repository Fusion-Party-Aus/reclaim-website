# Sanity Studio Environment Variables
# Copy this to .env and fill in your values

# Get these by running: npx sanity init --project-id <your-id> --dataset production
# Or create a new project at https://www.sanity.io/manage

SANITY_STUDIO_PROJECT_ID=your-project-id-here
SANITY_STUDIO_DATASET=production

# For Astro to read Sanity content (public token, read-only)
PUBLIC_SANITY_PROJECT_ID=your-project-id-here
PUBLIC_SANITY_DATASET=production

# Visual Editing — set to "true" in the Astro app to edit content in-place
# (drafts perspective + stega overlays). Leave unset/"false" in production.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
# Viewer-only API token, required when PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true
# (sanity.io/manage > project > API > Add API token, permission: Viewer)
SANITY_API_READ_TOKEN=

# Where the Studio's Presentation tool should preview the Astro site
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Set in the Studio's own env when running `npm run dev:sanity`, so the
# Presentation tool knows which Astro origin to preview against
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
