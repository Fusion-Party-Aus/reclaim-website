# Astro App Environment Variables
# Copy this to .env and fill in your values

# Branch theme for this deployment: 'vic' (default) or 'qld'.
# See config/deployment.mjs and src/styles/themes/.
PUBLIC_BRANCH=vic

# Sanity — see .env.sanity.example for the full set (including Visual Editing)
PUBLIC_SANITY_PROJECT_ID=qwl3f8jb
# Victoria: production. Queensland: qld (same project).
PUBLIC_SANITY_DATASET=production
# Optional canonical origin override; defaults to the selected branch domain.
# SITE_URL=https://vic.fusionparty.org.au
# Write-access token, used by the scripts/migration/* import scripts
SANITY_WRITE_TOKEN=

# Passphrase for the /login member-area gate
SECRET_PASSPHRASE=reclaim

# NationBuilder — powers the footer newsletter signup and membership sync
# (see nationbuilder/nationbuilder.js and nationbuilder/oauth.js)
NATIONBUILDER_SLUG=
# Static API token (used as fallback before OAuth is set up, or in local dev)
NATIONBUILDER_API_TOKEN=
# OAuth2 app credentials — register at https://{slug}.nationbuilder.com/admin/settings/developer
NATIONBUILDER_CLIENT_ID=
NATIONBUILDER_CLIENT_SECRET=
