---
export const prerender = false

import { Hero } from '@/components/layout/Hero'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Sidebar } from '@/features/page-rendering'
import { Icon } from 'astro-icon/components'
import { BrutalCard, BrutalButton, BrutalBadge } from '@/components/ui'
import { getDocumentBySlug, getResearchForPolicy } from '../../lib/sanity'
import { PortableText } from 'astro-portabletext'
import CustomLink from '../../components/portable-text/CustomLink.astro'
import TableBlock from '../../components/portable-text/TableBlock.astro'
import type { PortableTextBlock } from '../../lib/portableText'
import type { PolicyKeyPoint } from '../../types/sanity'
import '../../styles/global.css'
import '../../styles/editorial.css'

interface ProofStat {
  number: string
  label: string
  source?: string
}

interface Policy {
  _id: string
  title: string
  slug: { current: string }
  pillar?: string
  category?: string
  thisTerm?: boolean
  publishedAt?: string
  icon?: string
  summary: string
  keyPoints?: PolicyKeyPoint[]
  // Campaign Voice fields
  hook?: string
  villain?: string
  proofStat?: ProofStat
  shareableQuote?: string
  seoDescription?: string
  // Further Detail fields
  designRationale?: string
  systemInteraction?: string
  economicLogic?: string
  riskAndFailureModes?: string
  evidenceAndPrecedent?: string
  implementationOutline?: string
  // Metadata
  _updatedAt?: string
  cost?: string
  funding?: string
  body?: PortableTextBlock[]
}

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const policy = await getDocumentBySlug<Policy>('policy', slug)

if (!policy) {
  return Astro.redirect('/404')
}

const relatedResearch = await getResearchForPolicy(policy._id)

const sectionColors = ['bg-magenta', 'bg-mint text-black', 'bg-yellow']

const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')

// Split blocks into h2-delimited sections
const bodySections: Array<{ title: string; id: string; blocks: PortableTextBlock[] }> = []
const preamble: PortableTextBlock[] = []
let currentSection: { title: string; id: string; blocks: PortableTextBlock[] } | null = null

if (policy.body) {
  for (const block of policy.body) {
    if (block._type === 'block' && block.style === 'h2') {
      const title = block.children?.map((c: any) => c.text).join('') || ''
      const id = slugify(title)
      currentSection = { title, id, blocks: [block] }
      bodySections.push(currentSection)
    } else if (currentSection) {
      currentSection.blocks.push(block)
    } else {
      preamble.push(block)
    }
  }
}

const applyHash = slugify

const getPolicyIcon = (icon?: string) => {
  if (!icon) return null
  if (icon.includes(':')) return { type: 'icon', value: icon }
  if (/^[a-z0-9-]+$/i.test(icon)) return { type: 'icon', value: `mdi:${icon}` }
  return { type: 'emoji', value: icon }
}

const headingBlocks =
  policy.body?.filter(
    (block: PortableTextBlock) =>
      (block as { _type?: string; style?: string })._type === 'block' &&
      (block as { _type?: string; style?: string }).style === 'h2'
  ) || []

const contentSections = headingBlocks
  .map((block: PortableTextBlock) => {
    const b = block as { children?: { text?: string }[] }
    const title = (b.children || [])
      .map((child) => child.text || '')
      .join(' ')
      .trim()
    return title ? { id: applyHash(title), title } : null
  })
  .filter(Boolean)

const pillarConfig: Record<string, { variant: 'magenta' | 'mint' | 'yellow'; textColor: string }> =
  {
    'RECLAIM OUR ECONOMY': { variant: 'magenta', textColor: 'text-white' },
    'RECLAIM OUR INFRASTRUCTURE': { variant: 'mint', textColor: 'text-black' },
    'RECLAIM OUR DEMOCRACY': { variant: 'yellow', textColor: 'text-white' },
  }
const pillarCfg = (policy.pillar && pillarConfig[policy.pillar]) || {
  variant: 'magenta' as const,
  textColor: 'text-white',
}

const detailSections = [
  { id: 'design-rationale', title: 'Design Rationale', content: policy.designRationale },
  { id: 'system-interaction', title: 'System Interaction', content: policy.systemInteraction },
  { id: 'economic-logic', title: 'Economic & Institutional Logic', content: policy.economicLogic },
  { id: 'risks', title: 'Risk & Failure Modes', content: policy.riskAndFailureModes },
  { id: 'evidence', title: 'Evidence & Precedent', content: policy.evidenceAndPrecedent },
  { id: 'implementation', title: 'Implementation Outline', content: policy.implementationOutline },
].filter((s) => !!s.content)

// Source content is often a single unbroken block. Fall back to grouping
// sentences into short paragraphs so the detail dropdowns don't render as
// one wall of text when the CMS field has no blank-line breaks.
const splitIntoParagraphs = (text: string): string[] => {
  const byBlankLine = text
    .split(/\n\n+/)
    .map((p) => p.trim())
    .filter(Boolean)
  if (byBlankLine.length > 1) return byBlankLine

  // A period isn't a sentence break when it's a decimal point (e.g. "$1.2-1.5 billion").
  const sentences = text.match(/(?:[^.!?]|\.(?=\d))+[.!?]+(?:\s+|$)/g) || [text]
  const paragraphs: string[] = []
  for (let i = 0; i < sentences.length; i += 2) {
    paragraphs.push(
      sentences
        .slice(i, i + 2)
        .join('')
        .trim()
    )
  }
  return paragraphs.filter(Boolean)
}

const sidebarSections = [
  { id: 'top', title: policy.title },
  ...(policy.hook ? [{ id: 'the-problem', title: 'The Problem' }] : []),
  ...(policy.keyPoints && policy.keyPoints.length > 0
    ? [{ id: 'key-points', title: 'Key Points' }]
    : []),
  ...(relatedResearch.length > 0 ? [{ id: 'research', title: 'Research' }] : []),
  ...(detailSections.length > 0 ? [{ id: 'further-detail', title: 'Further Detail' }] : []),
  ...contentSections.filter(
    (section): section is { id: string; title: string } => section !== null
  ),
]

const metaDescription = policy.seoDescription || policy.summary
const canonicalUrl = `https://vic.fusionparty.org.au/policies/${policy.slug.current}`
const policyStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: policy.title,
  description: metaDescription,
  inLanguage: 'en-AU',
  datePublished: policy.publishedAt || undefined,
  dateModified: policy._updatedAt || policy.publishedAt || undefined,
  isPartOf: {
    '@type': 'CollectionPage',
    '@id': 'https://vic.fusionparty.org.au/policies',
    url: 'https://vic.fusionparty.org.au/policies',
    name: 'Fusion Party Victoria Policy Platform',
  },
  about: [
    policy.pillar,
    policy.category,
    policy.thisTerm === true
      ? 'Current-term policy priority'
      : policy.thisTerm === false
        ? 'Long-term policy direction'
        : null,
  ].filter(Boolean),
  publisher: {
    '@id': 'https://vic.fusionparty.org.au/#organization',
  },
}
---

<BaseLayout
  title={`${policy.title} | Fusion Party Victoria`}
  description={metaDescription}
  image={`/og/policies/${policy.slug.current}.png`}
  imageAlt={policy.title}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(policyStructuredData).replace(/</g, '\\u003c')}
  />
  <Header />

  <Hero
    title={policy.title}
    subtitle={policy.summary}
    eyebrow={policy.pillar || 'Victorian policy'}
    compact
  >
    {
      policy._updatedAt && (
        <p class="editorial-meta mt-5">
          Updated{' '}
          <time datetime={policy._updatedAt}>
            {new Date(policy._updatedAt).toLocaleDateString('en-AU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
        </p>
      )
    }
  </Hero>

  <main
    id="main-content"
    class="max-w-7xl mx-auto px-4 md:px-8 py-10 md:py-16 lg:grid lg:grid-cols-[1fr_280px] lg:gap-10 lg:items-start"
  >
    <div class="min-w-0">
      {/* ── Breadcrumbs ── */}
      <nav
        class="flex items-center flex-wrap gap-1 mb-10 text-xs font-black uppercase tracking-widest"
      >
        <a
          href="/"
          class="px-3 py-1.5 rounded-sm bg-yellow text-white hover:bg-mint hover:text-black transition-colors"
          >Home</a
        >
        <span class="text-white/30">›</span>
        <a
          href="/policies"
          class="px-3 py-1.5 rounded-sm bg-white/10 text-white hover:bg-mint hover:text-black transition-colors"
          >Policies</a
        >
        <span class="text-white/30">›</span>
        <span
          class="px-3 py-1.5 rounded-sm bg-black/30 text-white max-w-xs truncate"
          title={policy.title}>{policy.title}</span
        >
      </nav>

      {/* ── Hook Block (Populist accusation) ── */}
      {
        policy.slug.current === 'build-housing-at-stations' && (
          <aside class="mb-8 rounded-sm border border-yellow/40 bg-yellow/10 p-6">
            <p class="text-xs font-black uppercase tracking-widest text-[#a9c8ff] mb-2">
              Fusion Victoria policy
            </p>
            <h2 class="text-xl font-display font-black text-white mb-2">Homes and Stations Code</h2>
            <p class="text-sm text-white/80 leading-relaxed mb-3">
              The Code allows modest infill housing across serviced suburbs and more homes near
              high-capacity stations. Affordable housing rules and public costs need legal,
              infrastructure and viability tests.
            </p>
            <a
              class="font-bold text-[#a9c8ff] underline underline-offset-4"
              href="/policies/homes-and-stations-code"
            >
              Explore the policy
            </a>
          </aside>
        )
      }
      {
        policy.hook && (
          <section id="the-problem" class="mb-8 scroll-mt-28">
            <div class="border-l-4 border-magenta bg-black/40 px-6 py-5 rounded-r-sm">
              <p class="text-lg md:text-xl font-bold text-white leading-snug">{policy.hook}</p>
              {policy.villain && (
                <p class="mt-3 text-sm font-semibold text-white/75 leading-relaxed">
                  {policy.villain}
                </p>
              )}
            </div>
          </section>
        )
      }

      {/* ── Proof Stat ── */}
      {
        policy.proofStat && (
          <div class="mb-8 flex items-start gap-4 bg-magenta/10 border border-magenta/30 rounded-sm px-6 py-4">
            <div class="text-3xl md:text-4xl font-black text-magenta font-mono leading-none shrink-0">
              {policy.proofStat.number}
            </div>
            <div>
              <p class="text-sm font-black uppercase tracking-wide text-white/80 leading-tight">
                {policy.proofStat.label}
              </p>
              {policy.proofStat.source && (
                <p class="text-xs text-white/60 mt-1 italic">{policy.proofStat.source}</p>
              )}
            </div>
          </div>
        )
      }

      {/* ── Transport Score Callout ── */}
      {
        policy.pillar === 'RECLAIM OUR INFRASTRUCTURE' && (
          <div class="mb-8 bg-mint/10 border border-mint/30 rounded-sm p-6 relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
              <Icon name="mdi:train" class="w-32 h-32 text-mint" />
            </div>
            <div class="relative z-10 max-w-2xl">
              <h3 class="text-xl font-display font-black text-mint mb-2 tracking-tight">
                📊 Check Your Local Transport Score
              </h3>
              <p class="text-sm font-semibold text-white/80 leading-relaxed mb-4">
                How does your electorate stack up? Use our Victoria-wide transport scoring tool to
                check public transport frequency, coverage, and connectivity in your area.
              </p>
              <BrutalButton
                href="https://transportscore.fusionparty.org.au"
                target="_blank"
                rel="noopener noreferrer"
                variant="mint"
                size="sm"
                icon="mdi:launch"
              >
                Go to Transport Score Tool
              </BrutalButton>
            </div>
          </div>
        )
      }

      {/* ── Costing block ── */}
      {
        (policy.cost || policy.funding) && (
          <BrutalCard id="top" variant="yellow" padding="md" class="mb-8 scroll-mt-28">
            <div class="flex items-center gap-2 mb-2">
              <Icon name="mdi:currency-usd" class="w-5 h-5 text-white" />
              <span class="text-xs font-black uppercase tracking-widest text-white/70">
                What it costs
              </span>
            </div>
            {policy.cost && (
              <p class="font-black text-2xl text-white leading-tight">{policy.cost}</p>
            )}
            {policy.funding && (
              <p class="text-sm font-semibold text-white/80 mt-1 border-l-4 border-white/40 pl-3">
                Paid for by: {policy.funding}
              </p>
            )}
          </BrutalCard>
        )
      }

      {/* ── Key Points ── */}
      {
        policy.keyPoints && policy.keyPoints.length > 0 && (
          <section id="key-points" class="mb-8 scroll-mt-28">
            <BrutalCard
              variant="surface"
              shadow="magenta"
              padding="md"
              class="!p-0 overflow-hidden"
            >
              <div class="bg-magenta border-b border-white/10 px-6 py-4">
                <h2 class="text-xl font-display font-black text-white tracking-tight">
                  What it does
                </h2>
              </div>
              <ul class="divide-y divide-white/10">
                {policy.keyPoints.map((kp) => (
                  <li class="px-6 py-5 flex items-start gap-4">
                    <span class="shrink-0 w-7 h-7 bg-mint rounded-sm flex items-center justify-center font-black text-black text-sm mt-0.5">
                      ✓
                    </span>
                    <div>
                      <p class="font-black text-base uppercase leading-tight text-white mb-1">
                        {kp.point}
                      </p>
                      {kp.description && (
                        <p class="text-sm font-normal text-white/70 leading-snug">
                          {kp.description}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </BrutalCard>
          </section>
        )
      }

      {/* ── Research behind this policy ── */}
      {
        relatedResearch.length > 0 && (
          <section id="research" class="mb-8 scroll-mt-28">
            <div class="border border-mint/30 bg-mint/[0.04] rounded-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-mint/20 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-mint mb-1">
                    Show the work
                  </p>
                  <h2 class="text-xl font-display font-black text-white">
                    Research behind this policy
                  </h2>
                </div>
                <a
                  href="/research"
                  class="text-xs font-black uppercase tracking-wide text-white/50 hover:text-mint"
                >
                  Full research library →
                </a>
              </div>
              <div class="divide-y divide-white/10">
                {relatedResearch.slice(0, 4).map((resource) => (
                  <a
                    href={`/research/${resource.slug.current}`}
                    class="group block px-6 py-5 hover:bg-white/[0.03] transition-colors"
                  >
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-3">
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                          <span class="text-[10px] font-black uppercase tracking-widest text-mint">
                            {resource.researchArea || resource.resourceType}
                          </span>
                          {resource.version && (
                            <span class="text-[10px] font-mono text-white/30">
                              v{resource.version}
                            </span>
                          )}
                        </div>
                        <h3 class="text-lg font-display font-black text-white group-hover:text-mint leading-tight">
                          {resource.title}
                        </h3>
                        <p class="mt-2 text-sm text-white/60 leading-relaxed">
                          {resource.abstract}
                        </p>
                        {resource.keyFindings?.[0] && (
                          <p class="mt-3 text-xs text-white/42 border-l-2 border-yellow/50 pl-3 leading-relaxed">
                            {resource.keyFindings[0]}
                          </p>
                        )}
                      </div>
                      <Icon
                        name="mdi:arrow-right"
                        class="w-5 h-5 text-mint shrink-0 mt-1 group-hover:translate-x-1 transition-transform"
                      />
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {/* ── Shareable Quote ── */}
      {
        policy.shareableQuote && (
          <div class="mb-8 relative">
            <div class="border border-yellow/30 bg-yellow/5 rounded-sm px-7 py-6">
              <Icon name="mdi:format-quote-open" class="w-8 h-8 text-yellow/40 mb-3" />
              <p class="text-lg md:text-xl font-black text-white/90 leading-snug italic">
                {policy.shareableQuote}
              </p>
              <div class="mt-4">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(policy.shareableQuote)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-black uppercase text-yellow hover:text-yellow/80 transition-colors"
                >
                  <Icon name="mdi:twitter" class="w-4 h-4" /> Post this
                </a>
              </div>
            </div>
          </div>
        )
      }

      {/* ── Further Detail ── */}
      {
        detailSections.length > 0 && (
          <section id="further-detail" class="mb-8 scroll-mt-28">
            <BrutalCard variant="surface" shadow="mint" padding="md" class="!p-0 overflow-hidden">
              <div class="bg-black/30 border-b border-white/10 px-6 py-4 flex items-center gap-3">
                <Icon name="mdi:book-open-variant" class="w-6 h-6 text-mint" />
                <h2 class="text-xl font-display font-black text-white">Further Detail</h2>
              </div>
              <div class="divide-y divide-white/10">
                {detailSections.map((section, idx) => {
                  const accentClasses = ['bg-magenta', 'bg-mint', 'bg-yellow']
                  const accentClass = accentClasses[idx % 3]
                  return (
                    <details class="group">
                      <summary class="px-6 py-4 flex items-center justify-between gap-4 cursor-pointer select-none hover:bg-white/5 transition-colors list-none">
                        <div class="flex items-center gap-3">
                          <div class={`w-2 h-6 shrink-0 rounded-sm ${accentClass}`} />
                          <span class="font-black uppercase text-sm tracking-wide text-white">
                            {section.title}
                          </span>
                        </div>
                        <Icon
                          name="mdi:chevron-down"
                          class="w-5 h-5 text-white/40 transition-transform group-open:rotate-180 shrink-0"
                        />
                      </summary>
                      <div class="px-6 pb-6 pt-2 border-t border-white/10 space-y-4">
                        {splitIntoParagraphs(section.content || '').map((para: string) => (
                          <p class="text-base font-normal text-white/75 leading-relaxed">{para}</p>
                        ))}
                      </div>
                    </details>
                  )
                })}
              </div>
            </BrutalCard>
          </section>
        )
      }

      {/* ── Body (portable text) ── */}
      {
        bodySections.length > 0 || preamble.length > 0 ? (
          <article class="prose prose-lg max-w-none">
            {preamble.length > 0 && (
              <PortableText
                value={preamble}
                components={{
                  mark: { link: CustomLink },
                  type: { table: TableBlock },
                }}
              />
            )}
            {bodySections.map((section, i) => {
              const bgColor = sectionColors[i % sectionColors.length]
              return (
                <div class="brutal-section mb-12">
                  <h2 class={`brutal-section-header ${bgColor}`} id={section.id}>
                    {section.title}
                  </h2>
                  <div class="brutal-section-content">
                    <PortableText
                      value={section.blocks}
                      components={{
                        mark: { link: CustomLink },
                        type: { table: TableBlock },
                      }}
                    />
                  </div>
                </div>
              )
            })}
          </article>
        ) : null
      }

      {/* ── Back / CTA row ── */}
      <div class="mt-10 border-t border-white/10 pt-8">
        <BrutalCard variant="black" shadow="magenta" padding="md" class="mb-6">
          <p class="text-sm font-black uppercase tracking-widest text-white/50 mb-2">
            This policy won't pass itself.
          </p>
          <h3 class="text-xl md:text-2xl font-display font-black text-white mb-4 leading-tight">
            Every vote we get is a vote against the system that's taking from you.
          </h3>
          <div class="flex flex-wrap gap-3">
            <BrutalButton variant="magenta" href="/get-involved" icon="mdi:hand-heart">
              Join the Movement
            </BrutalButton>
            <BrutalButton variant="mint" href="/get-involved#donate" icon="mdi:cash-heart">
              Chip In
            </BrutalButton>
            <BrutalButton variant="black" href="/policies" icon="mdi:arrow-left">
              All Policies
            </BrutalButton>
          </div>
        </BrutalCard>
      </div>
    </div>

    <Sidebar sections={sidebarSections} page="policy" />
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
