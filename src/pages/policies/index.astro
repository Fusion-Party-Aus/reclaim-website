---
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { getPolicies, getPoliciesPage } from '../../lib/sanity'
import '../../styles/global.css'
import '../../styles/platform-pages.css'

const policies = await getPolicies()
const pageData = await getPoliciesPage()
const pillars = [...new Set(policies.map((policy) => policy.pillar || 'Other'))]
const slug = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
const descriptions: Record<string, string> = {
  'RECLAIM OUR INFRASTRUCTURE':
    'Homes, transport and public assets that work for the people who pay for them.',
  'RECLAIM OUR DEMOCRACY': 'Power you can see, question and share.',
  'RECLAIM OUR ECONOMY': 'Keep the value Victoria creates in Victorian hands.',
}
---

<BaseLayout
  title={`${pageData?.title || 'Policies'} | Fusion Party Victoria`}
  description={pageData?.seoDescription ||
    'Explore Fusion Party Victoria’s policy platform and long-term direction.'}
  image="/og/policies.png"
>
  <Header />
  <main id="main-content" class="platform-page">
    <section class="platform-hero platform-hero--policy" aria-labelledby="policy-heading">
      <div class="platform-wrap platform-hero__inner">
        <div class="platform-hero__copy">
          <p class="platform-kicker">Fusion Victoria / The platform</p>
          <h1 id="policy-heading">Build it.<br /><em>Keep it.</em><br />Share the return.</h1>
          <p class="platform-lede">
            Victoria can build homes and better transport, keep public value in public hands, and
            give people a real say in what comes next.
          </p>
          <div class="platform-hero__actions">
            <a href="#explore" class="platform-button"
              >Explore the policies <span aria-hidden="true">↘</span></a
            ><a href="/vision" class="platform-text-link"
              >See the vision <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <div class="platform-hero__mark" aria-hidden="true">
          <span>PUBLIC<br />VALUE</span><span>↗</span>
        </div>
      </div>
      <div class="platform-hero__footer platform-wrap">
        <span>01 / The case</span><span>02 / The platform</span><span>03 / Your part</span>
      </div>
    </section>

    <section class="platform-thesis platform-wrap" aria-labelledby="thesis-heading">
      <p class="platform-section-label">The case for change / 01</p>
      <div>
        <h2 id="thesis-heading">The public pays.<br /><span>Who gets the return?</span></h2><p>
          Victoria has built valuable infrastructure while handing away too much of its upside. Our
          answer is to scrutinise the deals, build where services already exist, and make public
          investment deliver lasting public benefit.
        </p><p class="platform-small">
          Each proposal has its own detail page. Read the evidence and qualifications there before
          treating any estimate as a settled return.
        </p>
      </div>
    </section>

    <section class="platform-index" id="explore" aria-labelledby="explore-heading">
      <div class="platform-wrap">
        <div class="platform-index__head">
          <div>
            <p class="platform-section-label">The platform / 02</p><h2 id="explore-heading">
              Find the change<br />you came for.
            </h2>
          </div><p>
            One platform, across immediate priorities and longer-term reforms. Browse by theme or
            narrow the delivery horizon.
          </p>
        </div>
        <div class="platform-controls">
          <div class="platform-tabs" role="group" aria-label="Filter policies by delivery horizon">
            <button type="button" data-horizon-filter="all" aria-pressed="true"
              >All policies <span>{policies.length}</span></button
            >
            <button type="button" data-horizon-filter="current" aria-pressed="false"
              >This term <span>{policies.filter((p) => p.thisTerm === true).length}</span></button
            >
            <button type="button" data-horizon-filter="long" aria-pressed="false"
              >Long-term <span>{policies.filter((p) => p.thisTerm !== true).length}</span></button
            >
          </div>
          <label class="platform-search"
            ><span class="sr-only">Search policies</span><input
              id="policy-search"
              type="search"
              placeholder="Search the platform"
              autocomplete="off"
            /><span aria-hidden="true">⌕</span></label
          >
        </div>
        <nav class="platform-jump" aria-label="Jump to policy themes">
          {
            pillars.map((pillar, index) => (
              <a href={`#${slug(pillar)}`}>
                <span>0{index + 1}</span> {pillar.replace('RECLAIM OUR ', '')}
              </a>
            ))
          }
        </nav>
        <p id="policy-results" class="platform-results" role="status" aria-live="polite"></p>
        {
          pillars.map((pillar, index) => (
            <section
              class="platform-chapter"
              id={slug(pillar)}
              data-policy-pillar
              aria-labelledby={`${slug(pillar)}-heading`}
            >
              <div class="platform-chapter__intro">
                <p>{descriptions[pillar] || 'Explore the proposals and the case behind them.'}</p>
                {pillar === 'RECLAIM OUR INFRASTRUCTURE' && (
                  <a href="https://transportscore.fusionparty.org.au" class="platform-inline-link">
                    Check your local transport score ↗
                  </a>
                )}
              </div>
              <div class="platform-chapter__list">
                {policies
                  .filter((policy) => (policy.pillar || 'Other') === pillar)
                  .map((policy, itemIndex) => (
                    <article
                      class="platform-policy"
                      data-policy-card
                      data-horizon={policy.thisTerm === true ? 'current' : 'long'}
                      data-search={`${policy.title} ${policy.summary || ''} ${policy.category || ''}`.toLowerCase()}
                    >
                      <a
                        href={`/policies/${policy.slug.current}`}
                        class="platform-policy__link"
                        aria-label={`Read ${policy.title}`}
                      >
                        <span class="platform-policy__number">
                          {String(itemIndex + 1).padStart(2, '0')}
                        </span>
                        <span class="platform-policy__body">
                          <span class="platform-policy__meta">
                            {policy.category || 'Policy'} <span aria-hidden="true">/</span>{' '}
                            {policy.thisTerm === true ? 'This term' : 'Long-term direction'}
                          </span>
                          <strong>{policy.title}</strong>
                          <span class="platform-policy__summary">{policy.summary}</span>
                        </span>
                        <span class="platform-policy__arrow" aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    </article>
                  ))}
              </div>
            </section>
          ))
        }
        <p class="platform-empty" id="policy-empty" hidden>
          No policies match that search. Try another term or clear the filter.
        </p>
      </div>
    </section>
    <section class="platform-end">
      <div class="platform-wrap platform-end__inner">
        <div>
          <p class="platform-section-label">The next step / 03</p><h2>
            This is a plan<br />to argue for.
          </h2><p>Read it. Challenge it. Help make it better.</p>
        </div><div class="platform-end__links">
          <a href="/get-involved">Get involved <span>↗</span></a><a href="/costings"
            >Examine the costings <span>↗</span></a
          ><a href="/vision">See the long view <span>↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline>
    ;(() => {
      const buttons = [...document.querySelectorAll('[data-horizon-filter]')]
      const cards = [...document.querySelectorAll('[data-policy-card]')]
      const chapters = [...document.querySelectorAll('[data-policy-pillar]')]
      const search = document.querySelector('#policy-search')
      const results = document.querySelector('#policy-results')
      const empty = document.querySelector('#policy-empty')
      let filter = new URL(location.href).searchParams.get('horizon')
      if (filter !== 'current' && filter !== 'long') filter = 'all'
      const update = () => {
        const query = search.value.trim().toLocaleLowerCase()
        let count = 0
        cards.forEach((card) => {
          const visible =
            (filter === 'all' || card.dataset.horizon === filter) &&
            (!query || card.dataset.search.includes(query))
          card.hidden = !visible
          if (visible) count++
        })
        chapters.forEach((chapter) => {
          chapter.hidden = !chapter.querySelector('[data-policy-card]:not([hidden])')
        })
        buttons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.horizonFilter === filter))
        )
        results.textContent = `${count} ${count === 1 ? 'policy' : 'policies'} shown`
        empty.hidden = count !== 0
        const url = new URL(location.href)
        if (filter === 'all') url.searchParams.delete('horizon')
        else url.searchParams.set('horizon', filter)
        history.replaceState({}, '', url)
      }
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          filter = button.dataset.horizonFilter
          update()
        })
      )
      search.addEventListener('input', update)
      update()
    })()
  </script>
</BaseLayout>
