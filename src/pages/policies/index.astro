---
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import type { Policy } from '../../types/sanity'
import { getPolicies, getPoliciesPage } from '../../lib/sanity'
import '../../styles/global.css'
import '../../styles/platform-pages.css'

const policies = await getPolicies()
const pageData = await getPoliciesPage()
const groups = new Map<string, Map<string, Policy[]>>()
for (const policy of policies) {
  const pillar = policy.pillar || 'Other policies'
  const category = policy.category || 'General'
  if (!groups.has(pillar)) groups.set(pillar, new Map())
  const categories = groups.get(pillar)!
  if (!categories.has(category)) categories.set(category, [])
  categories.get(category)!.push(policy)
}
const idFor = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
const pillarDescriptions: Record<string, string> = {
  'RECLAIM OUR INFRASTRUCTURE':
    'Build useful networks and neighbourhoods. Keep the public value they create.',
  'RECLAIM OUR DEMOCRACY': 'Put decisions, influence and public contracts in plain sight.',
  'RECLAIM OUR ECONOMY': 'Make public investment pay a public return.',
}
---

<BaseLayout
  title={`${pageData?.title || 'Our Policies'} | Fusion Party Victoria`}
  description={pageData?.seoDescription || 'Explore Fusion Victoria’s full policy platform.'}
  image="/og/policies.png"
>
  <Header />
  <main id="main-content" class="reclaim-platform">
    <div class="platform-spectrum" aria-hidden="true"></div>
    <header class="platform-header platform-container">
      <p class="platform-eyebrow">Fusion Party Victoria</p>
      <h1>Our policies</h1>
      <p class="platform-intro">
        Make power visible. Build homes and transport that work. Keep the value Victoria creates in
        public hands.
      </p>
      <div class="platform-header__links">
        <a class="platform-primary-link" href="#browse"
          >Explore the platform <span aria-hidden="true">↓</span></a
        ><a href="/vision" class="platform-secondary-link"
          >Our vision <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="platform-frame" aria-labelledby="policy-frame-title">
      <div class="platform-container platform-frame__grid">
        <div>
          <p class="platform-eyebrow">The idea</p><h2 id="policy-frame-title">
            Public investment.<br /><span>Public return.</span>
          </h2>
        </div><div>
          <p>
            Victoria needs more than another list of promises. These proposals start with the
            systems that shape everyday life: where homes can be built, how people move, who holds
            power and who benefits when the public pays.
          </p><p>
            Each policy sets out the change, its expected effect and the case behind it. Costs and
            evidence belong with the individual proposal, where they can be checked.
          </p>
        </div>
      </div>
    </section>

    <section id="browse" class="platform-browse platform-container" aria-labelledby="browse-title">
      <div class="platform-browse__heading">
        <div>
          <p class="platform-eyebrow">Explore the platform</p><h2 id="browse-title">
            Find a policy
          </h2>
        </div><p>
          Browse the full platform by pillar and category. The time filter shows delivery horizon;
          longer-term proposals are still part of the platform.
        </p>
      </div>
      <div class="platform-tools">
        <div class="platform-filters" role="group" aria-label="Filter by delivery horizon">
          <button type="button" data-horizon-filter="all" aria-pressed="true"
            >All policies <span>{policies.length}</span></button
          ><button type="button" data-horizon-filter="current" aria-pressed="false"
            >This term <span>{policies.filter((p) => p.thisTerm === true).length}</span></button
          ><button type="button" data-horizon-filter="long" aria-pressed="false"
            >Long-term <span>{policies.filter((p) => p.thisTerm !== true).length}</span></button>
        </div><label class="platform-search"
          ><span class="sr-only">Search policies</span><input
            type="search"
            id="policy-search"
            placeholder="Search policies"
            autocomplete="off"
          /><span aria-hidden="true">⌕</span></label>
      </div>
      <nav class="platform-pillar-nav" aria-label="Policy pillars">
        {[...groups.keys()].map((pillar) => <a href={`#${idFor(pillar)}`}>{pillar}</a>)}
      </nav>
      <p class="platform-result-count" id="policy-results" role="status" aria-live="polite"></p>
      {
        [...groups].map(([pillar, categories]) => (
          <section
            class="platform-pillar"
            id={idFor(pillar)}
            data-policy-pillar
            aria-labelledby={`${idFor(pillar)}-title`}
          >
            <div class="platform-pillar__heading">
              <p>
                {pillarDescriptions[pillar] ||
                  'Explore the proposals in this part of the platform.'}
              </p>
              {pillar === 'RECLAIM OUR INFRASTRUCTURE' && (
                <a href="https://transportscore.fusionparty.org.au" class="platform-inline-link">
                  Check your local transport score ↗
                </a>
              )}
            </div>
            {[...categories].map(([category, items]) => (
              <section
                class="platform-category"
                data-policy-category
                aria-labelledby={`${idFor(pillar)}-${idFor(category)}`}
              >
                <h4 id={`${idFor(pillar)}-${idFor(category)}`}>{category}</h4>
                <div class="platform-policy-grid">
                  {items.map((policy) => (
                    <article
                      class="platform-policy"
                      data-policy-card
                      data-horizon={policy.thisTerm === true ? 'current' : 'long'}
                      data-search={`${pillar} ${category} ${policy.title} ${policy.hook || ''} ${policy.summary || ''}`.toLocaleLowerCase()}
                    >
                      <a
                        href={`/policies/${policy.slug.current}`}
                        aria-label={`Read ${policy.title}`}
                      >
                        <span class="platform-policy__horizon">
                          {policy.thisTerm === true ? 'This term' : 'Long-term direction'}
                        </span>
                        <h5>{policy.title}</h5>
                        {policy.hook && <p class="platform-policy__hook">{policy.hook}</p>}
                        <p class="platform-policy__summary">{policy.summary}</p>
                        <span class="platform-policy__more">
                          Read the policy <span aria-hidden="true">↗</span>
                        </span>
                      </a>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </section>
        ))
      }
      <p id="policy-empty" class="platform-empty" hidden>
        No policies match. Try another search or delivery horizon.
      </p>
    </section>
    <section class="platform-next">
      <div class="platform-container">
        <p class="platform-eyebrow">Keep going</p><h2>Read the detail.<br />Make the case.</h2><p>
          Scrutinise the proposals, explore the long view, or help make this platform stronger.
        </p><div>
          <a class="platform-primary-link" href="/vision">See the vision ↗</a><a
            class="platform-secondary-link"
            href="/get-involved">Get involved ↗</a
          ><a class="platform-secondary-link" href="/costings">Examine the costings ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline>
    ;(() => {
      const buttons = [...document.querySelectorAll('[data-horizon-filter]')]
      const cards = [...document.querySelectorAll('[data-policy-card]')]
      const categories = [...document.querySelectorAll('[data-policy-category]')]
      const pillars = [...document.querySelectorAll('[data-policy-pillar]')]
      const search = document.querySelector('#policy-search')
      const result = document.querySelector('#policy-results')
      const empty = document.querySelector('#policy-empty')
      let horizon = new URL(location.href).searchParams.get('horizon')
      if (horizon !== 'current' && horizon !== 'long') horizon = 'all'
      const update = () => {
        const query = search.value.trim().toLocaleLowerCase()
        let count = 0
        cards.forEach((card) => {
          const visible =
            (horizon === 'all' || card.dataset.horizon === horizon) &&
            (!query || card.dataset.search.includes(query))
          card.hidden = !visible
          if (visible) count++
        })
        categories.forEach((category) => {
          category.hidden = !category.querySelector('[data-policy-card]:not([hidden])')
        })
        pillars.forEach((pillar) => {
          pillar.hidden = !pillar.querySelector('[data-policy-card]:not([hidden])')
        })
        buttons.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.horizonFilter === horizon))
        )
        result.textContent = `${count} ${count === 1 ? 'policy' : 'policies'} shown`
        empty.hidden = count !== 0
        const url = new URL(location.href)
        if (horizon === 'all') url.searchParams.delete('horizon')
        else url.searchParams.set('horizon', horizon)
        history.replaceState({}, '', url)
      }
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          horizon = button.dataset.horizonFilter
          update()
        })
      )
      search.addEventListener('input', update)
      update()
    })()
  </script>
</BaseLayout>
