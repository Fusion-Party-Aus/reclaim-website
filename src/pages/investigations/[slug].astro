---
export const prerender = false
import {DEPLOYMENT} from '@/lib/deployment'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {Header} from '@/components/layout/Header'
import {Footer} from '@/components/layout/Footer'
import {getInvestigation} from '@/lib/investigations'
import '@/styles/global.css'
import '@/styles/editorial.css'
const {slug} = Astro.params
const item = DEPLOYMENT.features.investigations && slug ? await getInvestigation(slug) : null
if(!item) Astro.response.status = 404
const counts = {answered:item?.questions?.filter(q=>q.status==='answered').length||0,partial:item?.questions?.filter(q=>q.status==='partial').length||0,outstanding:item?.questions?.filter(q=>q.status==='outstanding').length||0}
---
<BaseLayout title={`${item?.title || 'Investigation not found'} | ${DEPLOYMENT.label}`} description={item?.summary || 'Investigation not found'} noindex={!item}>
 <Header/><main id="main-content" class="site-editorial bg-surface-base min-h-screen">
 {item ? <>
  <header class="editorial-masthead"><div class="editorial-shell">
   <a href="/investigations" class="text-mint font-black">← All investigations</a>
   <p class="editorial-kicker mt-8">{item.location || DEPLOYMENT.state} · {item.projectStage || 'Investigation'}</p>
   <h1 class="editorial-title">{item.title}</h1><p class="editorial-deck">{item.summary}</p>
   <p class="mt-6 text-sm text-white/60">Last reviewed: {item.lastReviewed || 'Not recorded'} · Published: {item.publishedAt?.slice(0,10) || 'Not recorded'}</p>
  </div></header>
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-14 space-y-16">
   <section aria-labelledby="question-summary"><h2 id="question-summary" class="text-3xl font-display font-black mb-5">Questions tracker</h2><div class="flex flex-wrap gap-3 text-sm font-black">
    <span class="border border-mint/50 px-4 py-2 text-mint">{counts.answered} answered</span><span class="border border-yellow/50 px-4 py-2 text-yellow">{counts.partial} partial</span><span class="border border-red-400/50 px-4 py-2 text-red-300">{counts.outstanding} outstanding</span>
   </div><p class="mt-4 text-white/55 text-sm">Counts describe the questions tracked here, not an independent assessment of project approval or safety.</p></section>
   {Boolean(item.questions?.length) && <section aria-labelledby="questions"><h2 id="questions" class="text-3xl font-display font-black mb-6">Public questions</h2><div class="space-y-4">{item.questions!.map(q=><article class="bg-surface-raised border border-white/15 p-6">
    <span class="uppercase text-xs font-black tracking-wider text-mint">{q.status}</span><h3 class="text-xl font-bold mt-2">{q.question}</h3>{q.answer && <p class="text-white/70 mt-3 whitespace-pre-line">{q.answer}</p>}
    {Boolean(q.evidenceUrls?.length) && <ul class="mt-4 space-y-1">{q.evidenceUrls!.map(url=><li><a href={url} rel="noopener noreferrer" target="_blank" class="text-mint underline break-all">{url}</a></li>)}</ul>}
    {q.lastChecked && <p class="mt-3 text-xs text-white/50">Checked {q.lastChecked}</p>}
   </article>)}</div></section>}
   {Boolean(item.evidence?.length) && <section aria-labelledby="sources"><h2 id="sources" class="text-3xl font-display font-black mb-6">Evidence register</h2><div class="space-y-4">{item.evidence!.map(e=><article class="border-l-2 border-mint bg-surface-raised p-6">
    <h3 class="font-bold text-xl"><a class="text-mint underline" href={e.url} target="_blank" rel="noopener noreferrer">{e.title} ↗</a></h3>
    <p class="text-white/50 text-sm mt-2">{e.publisher} {e.date && '· '+e.date}</p>{e.finding && <p class="mt-3 text-white/75 whitespace-pre-line">{e.finding}</p>}{e.limitations && <p class="mt-3 text-yellow text-sm">Limitations: {e.limitations}</p>}
   </article>)}</div></section>}
   {Boolean(item.updates?.length) && <section aria-labelledby="updates"><h2 id="updates" class="text-3xl font-display font-black mb-6">Updates</h2><ol class="space-y-5">{[...item.updates!].sort((a,b)=>b.date.localeCompare(a.date)).map(u=><li class="border-l-2 border-white/25 pl-6"><time class="text-mint font-mono">{u.date}</time><h3 class="font-black text-xl mt-2">{u.headline}</h3><p class="mt-2 text-white/70 whitespace-pre-line">{u.detail}</p>{u.sourceUrl && <a href={u.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-mint underline">Source ↗</a>}</li>)}</ol></section>}
   {Boolean(item.relatedInvestigations?.length) && <section aria-labelledby="related"><h2 id="related" class="text-3xl font-display font-black mb-5">Related investigations</h2><ul class="space-y-3">{item.relatedInvestigations!.filter(x=>x?.slug?.current).map(x=><li><a class="text-mint underline" href={`/investigations/${x.slug.current}`}>{x.title} →</a></li>)}</ul></section>}
   <p class="border-t border-white/15 pt-6 text-white/55 text-sm">Investigation findings are provisional where identified and are not formal Fusion Party policy positions. Corrections and new source material should be sent through the contact page.</p>
  </div>
 </> : <section class="max-w-5xl mx-auto p-10"><h1 class="text-4xl font-black">Investigation not found</h1><a href="/investigations" class="text-mint underline">Browse investigations</a></section>}
 </main><Footer/>
</BaseLayout>
