---
export const prerender = false
import { DEPLOYMENT } from '@/lib/deployment'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { getInvestigations } from '@/lib/investigations'
import '@/styles/global.css'
import '@/styles/editorial.css'

if (!DEPLOYMENT.features.investigations) Astro.response.status = 404
const investigations = DEPLOYMENT.features.investigations ? await getInvestigations() : []
const locations = [...new Set(investigations.map((item) => item.location).filter(Boolean))]
---

<BaseLayout
  title={`Public investigations | ${DEPLOYMENT.label}`}
  description="Follow sourced public-interest investigations, evidence, unanswered questions and documented updates."
  noindex={!DEPLOYMENT.features.investigations}
>
  <Header />
  <main id="main-content" class="site-editorial bg-surface-base min-h-screen">
    <header class="editorial-masthead">
      <div class="editorial-shell">
        <p class="editorial-kicker">{DEPLOYMENT.label} · Evidence tracker</p>
        <h1 class="editorial-title">Public investigations</h1>
        <p class="editorial-deck">
          Follow what is known, what has changed and what still needs a public answer.
        </p>
      </div>
    </header>
    <section class="max-w-7xl mx-auto px-4 md:px-8 py-12">
      <p class="text-fg/70 max-w-3xl mb-8">
        These are public-interest investigations, not adopted party policy. Claims and findings
        should be read alongside their cited sources, limitations and review dates.
      </p>
      {
        investigations.length ? (
          <>
            <form
              class="grid gap-4 md:grid-cols-[1fr_15rem_13rem] mb-8"
              role="search"
              aria-label="Filter investigations"
            >
              <label class="sr-only" for="investigation-search">
                Search investigations
              </label>
              <input
                id="investigation-search"
                type="search"
                placeholder="Search investigations"
                class="min-h-12 border border-white/25 bg-surface-raised px-4 text-fg"
              />
              <label class="sr-only" for="investigation-location">
                Filter by area
              </label>
              <select
                id="investigation-location"
                class="min-h-12 border border-white/25 bg-surface-raised px-4 text-fg"
              >
                <option value="">All areas</option>
                {locations.map((location) => (
                  <option value={location}>{location}</option>
                ))}
              </select>
              <label class="sr-only" for="investigation-status">
                Filter by status
              </label>
              <select
                id="investigation-status"
                class="min-h-12 border border-white/25 bg-surface-raised px-4 text-fg"
              >
                <option value="">All statuses</option>
                <option value="investigating">Investigating</option>
                <option value="awaiting-response">Awaiting response</option>
                <option value="updated">Updated</option>
                <option value="closed">Closed</option>
              </select>
            </form>
            <p id="investigation-results" class="text-sm text-fg/60 mb-5" aria-live="polite">
              {investigations.length} investigations
            </p>
            <div id="investigation-list" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {investigations.map((item) => (
                <article
                  class="investigation-card bg-surface-raised border border-white/15 border-t-4 border-t-mint p-7"
                  data-title={item.title.toLowerCase()}
                  data-summary={item.summary.toLowerCase()}
                  data-location={item.location || ''}
                  data-status={item.status || 'investigating'}
                >
                  <p class="text-xs uppercase font-black tracking-widest text-mint">
                    {item.location || DEPLOYMENT.state} · {item.projectStage || 'Investigation'}
                  </p>
                  <h2 class="font-display text-3xl font-black mt-5">
                    <a href={`/investigations/${item.slug.current}`} class="hover:text-mint">
                      {item.title}
                    </a>
                  </h2>
                  <p class="text-fg/70 mt-4">{item.summary}</p>
                  <p class="text-sm text-fg/60 mt-5">
                    {item.questions?.filter((question) => question.status === 'outstanding')
                      .length || 0}{' '}
                    outstanding questions · {item.evidence?.length || 0} sources
                  </p>
                  <a
                    class="inline-block mt-6 font-black text-mint"
                    href={`/investigations/${item.slug.current}`}
                  >
                    View investigation →
                  </a>
                </article>
              ))}
            </div>
            <p id="investigation-empty" class="hidden border border-mint/40 bg-surface-raised p-8">
              No investigations match these filters.
            </p>
          </>
        ) : (
          <div class="border border-mint/40 bg-surface-raised p-8 max-w-3xl">
            <>
              <h2 class="text-2xl font-display font-black">Investigations are being prepared</h2>
              <p class="mt-3 text-fg/65">
                Reviewed investigations will appear here once approved for publication.
              </p>
            </>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#investigation-search')
  const location = document.querySelector<HTMLSelectElement>('#investigation-location')
  const status = document.querySelector<HTMLSelectElement>('#investigation-status')
  const cards = [...document.querySelectorAll<HTMLElement>('.investigation-card')]
  const results = document.querySelector<HTMLElement>('#investigation-results')
  const empty = document.querySelector<HTMLElement>('#investigation-empty')
  const filter = () => {
    const query = search?.value.trim().toLowerCase() || ''
    let visible = 0
    for (const card of cards) {
      const matches =
        `${card.dataset.title} ${card.dataset.summary}`.includes(query) &&
        (!location?.value || card.dataset.location === location.value) &&
        (!status?.value || card.dataset.status === status.value)
      card.hidden = !matches
      if (matches) visible++
    }
    if (results)
      results.textContent = `${visible} ${visible === 1 ? 'investigation' : 'investigations'}`
    empty?.classList.toggle('hidden', visible !== 0)
  }
  search?.addEventListener('input', filter)
  location?.addEventListener('change', filter)
  status?.addEventListener('change', filter)
</script>
