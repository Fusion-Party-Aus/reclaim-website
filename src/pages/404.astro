---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { BrutalCard, BrutalBadge } from '@/components/ui'
import '../styles/global.css'

const funnyMessages = [
  'This page went to Canberra and never came back',
  "Error 404: Democracy not found (but we're working on it)",
  'This page is as missing as integrity in major parties',
  'Lost in the political wilderness',
  'This page got stuck in committee',
  '404: Still more functional than the two-party system',
  'Page.exe has stopped responding',
  'This URL is on strike for better working conditions',
  'Content not found. Try turning it off and on again?',
  'This page eloped with a routing error',
]

const randomMessage = funnyMessages[Math.floor(Math.random() * funnyMessages.length)]

const chaosMessages = ['OOPS!', 'YOO-HOO!', 'UH OH!', 'WHOOPS!', 'YIKES!', 'BONK!', 'DANG!']
---

<BaseLayout
  title="404 - Page Not Found | Fusion Party Victoria"
  description="Oops! This page doesn't exist. Let's get you back on track."
  noindex={true}
>
  <Header />

  <main id="main-content" class="min-h-screen bg-black relative overflow-hidden pt-28 pb-20">
    <!-- ABSOLUTE CHAOS Background Elements -->
    <div class="absolute inset-0 opacity-20">
      <div
        class="absolute top-10 left-10 w-32 h-32 border border-magenta rounded-sm rotate-12"
        style="animation: float 6s ease-in-out infinite, spin 15s linear infinite;"
      >
      </div>
      <div
        class="absolute top-40 right-20 w-24 h-24 bg-yellow rounded-sm rotate-45"
        style="animation: float 8s ease-in-out infinite reverse, wiggle 2s ease-in-out infinite;"
      >
      </div>
      <div
        class="absolute bottom-32 left-1/4 w-40 h-40 border border-mint rounded-full"
        style="animation: float 7s ease-in-out infinite, pulse 3s ease-in-out infinite;"
      >
      </div>
      <div
        class="absolute top-1/3 right-1/3 w-28 h-28 bg-magenta rounded-sm -rotate-12"
        style="animation: spin 20s linear infinite, bounce 4s ease-in-out infinite;"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-36 h-36 border border-yellow rounded-sm rotate-90"
        style="animation: float 5s ease-in-out infinite, shake 3s ease-in-out infinite;"
      >
      </div>
      <div
        class="absolute top-1/2 left-10 w-20 h-20 bg-mint rounded-sm rotate-45"
        style="animation: spin 10s linear infinite reverse, float 4s ease-in-out infinite;"
      >
      </div>
      <div
        class="absolute top-20 right-1/3 w-16 h-16 border border-magenta rounded-sm"
        style="animation: shake 2s ease-in-out infinite, spin 25s linear infinite;"
      >
      </div>
    </div>

    <!-- Floating Chaos Words -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-10">
      {
        chaosMessages.map((msg, i) => (
          <div
            class="absolute text-6xl font-black text-yellow font-display"
            style={`
            top: ${Math.random() * 80 + 10}%;
            left: ${Math.random() * 80 + 10}%;
            animation: float ${4 + i}s ease-in-out infinite, spin ${20 + i * 5}s linear infinite;
            transform: rotate(${Math.random() * 360}deg);
          `}
          >
            {msg}
          </div>
        ))
      }
    </div>

    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <!-- Giant 404 -->
      <div class="text-center mb-12">
        <h1
          class="text-[12rem] md:text-[20rem] font-black uppercase leading-none mb-0 select-none font-display"
          style="
            background: linear-gradient(45deg, #D428D4, #00DDB8, #4A7AEB, #D428D4);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 3s ease infinite;
            transform: rotate(-2deg);
          "
        >
          404
        </h1>

        <!-- Glitchy subtitle -->
        <div class="relative inline-block mb-8">
          <h2
            class="text-4xl md:text-6xl font-black uppercase text-white relative z-10 font-display"
            style="animation: glitch 2s infinite;"
          >
            PAGE NOT FOUND
          </h2>
          <div
            class="absolute top-0 left-0 text-4xl md:text-6xl font-black uppercase text-magenta opacity-70 font-display"
            style="animation: glitch-layer-1 2s infinite; clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);"
          >
            PAGE NOT FOUND
          </div>
          <div
            class="absolute top-0 left-0 text-4xl md:text-6xl font-black uppercase text-mint opacity-70 font-display"
            style="animation: glitch-layer-2 2s infinite; clip-path: polygon(0 55%, 100% 55%, 100% 100%, 0 100%);"
          >
            PAGE NOT FOUND
          </div>
        </div>
      </div>

      <!-- Funny Message Card with MAXIMUM CHAOS -->
      <div class="max-w-3xl mx-auto mb-12 relative">
        <!-- Extra chaos badges -->
        <div
          class="absolute -top-8 left-10 rotate-12 z-20"
          style="animation: wiggle 2s ease-in-out infinite;"
        >
          <BrutalBadge variant="magenta" size="lg">ERROR!</BrutalBadge>
        </div>
        <div
          class="absolute -top-6 right-16 -rotate-6 z-20"
          style="animation: shake 3s ease-in-out infinite;"
        >
          <BrutalBadge variant="mint" size="lg">OH NO!</BrutalBadge>
        </div>

        <BrutalCard
          variant="yellow"
          shadow="magenta"
          padding="lg"
          class="relative transform -rotate-1 hover:rotate-1 transition-transform"
          style="animation: pulse 4s ease-in-out infinite;"
        >
          <div
            class="absolute -top-6 -right-6 w-20 h-20 bg-mint border border-white/20 rounded-sm rotate-12 flex items-center justify-center z-10"
            style="animation: spin 4s linear infinite;"
          >
            <Icon name="mdi:alert-circle" class="w-12 h-12 text-black" />
          </div>
          <div
            class="absolute -bottom-4 -left-4 w-16 h-16 bg-magenta border border-white/20 rounded-sm -rotate-12 flex items-center justify-center"
            style="animation: bounce 2s ease-in-out infinite;"
          >
            <Icon name="mdi:help" class="w-10 h-10 text-white" />
          </div>
          <p
            class="text-2xl md:text-4xl font-black uppercase text-center leading-tight relative z-10 font-display"
          >
            {randomMessage}
          </p>
        </BrutalCard>
      </div>

      <!-- Action Cards Grid - MAXIMUM CHAOS -->
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
        <!-- Go Home -->
        <a
          href="/"
          class="block bg-magenta rounded-sm border border-white/10 p-8 group transition-all hover:-translate-y-2 hover:rotate-2 relative overflow-hidden"
          style="box-shadow: 0 0 40px rgba(212, 40, 212, 0.4);"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-yellow opacity-30 rounded-sm rotate-45 -translate-y-8 translate-x-8 group-hover:scale-150 transition-transform"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-white/10 border border-white/20 rounded-full group-hover:rotate-180 transition-transform duration-500"
            >
              <Icon name="mdi:home" class="w-12 h-12 text-white" />
            </div>
            <h3 class="text-3xl font-black uppercase mb-2 text-white text-center font-display">
              Go Home
            </h3>
            <p class="text-sm font-bold text-white text-center">Escape this madness!</p>
          </div>
        </a>

        <!-- Explore Policies -->
        <a
          href="/policies"
          class="block bg-mint rounded-sm border border-white/10 p-8 group transition-all hover:-translate-y-2 hover:-rotate-2 relative overflow-hidden"
          style="box-shadow: 0 0 40px rgba(0, 221, 184, 0.4);"
        >
          <div
            class="absolute bottom-0 left-0 w-24 h-24 bg-magenta opacity-30 rounded-sm -rotate-45 translate-y-8 -translate-x-8 group-hover:scale-150 transition-transform"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-black/20 border border-black/20 rounded-full group-hover:rotate-180 transition-transform duration-500"
            >
              <Icon name="mdi:file-document-multiple" class="w-12 h-12 text-black" />
            </div>
            <h3 class="text-3xl font-black uppercase mb-2 text-black text-center font-display">
              Policies
            </h3>
            <p class="text-sm font-bold text-black text-center">Real solutions exist!</p>
          </div>
        </a>

        <!-- Blog -->
        <a
          href="/blog"
          class="block bg-yellow rounded-sm border border-white/10 p-8 group transition-all hover:-translate-y-2 hover:rotate-1 relative overflow-hidden"
          style="box-shadow: 0 0 40px rgba(74, 122, 235, 0.4);"
        >
          <div
            class="absolute top-0 left-0 w-32 h-32 bg-mint opacity-30 rounded-sm rotate-12 -translate-y-12 -translate-x-12 group-hover:scale-150 transition-transform"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-magenta/20 border border-white/20 rounded-full group-hover:rotate-180 transition-transform duration-500"
            >
              <Icon name="mdi:newspaper-variant" class="w-12 h-12 text-white" />
            </div>
            <h3 class="text-3xl font-black uppercase mb-2 text-white text-center font-display">
              The Blog
            </h3>
            <p class="text-sm font-bold text-white text-center">News that matters!</p>
          </div>
        </a>
      </div>

      <!-- WILD Search Box -->
      <div class="max-w-2xl mx-auto relative">
        <!-- Decorative chaos -->
        <div
          class="absolute -top-6 -left-6 w-12 h-12 bg-yellow rounded-sm rotate-45"
          style="animation: spin 3s linear infinite;"
        >
        </div>
        <div
          class="absolute -bottom-6 -right-6 w-16 h-16 bg-magenta rounded-sm -rotate-12"
          style="animation: bounce 2s ease-in-out infinite;"
        >
        </div>

        <BrutalCard
          variant="surface"
          shadow="mint"
          padding="lg"
          class="transform rotate-1 hover:-rotate-1 transition-transform relative"
        >
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-10 h-10 bg-mint/10 border border-mint rounded-sm flex items-center justify-center rotate-12"
              style="animation: wiggle 2s ease-in-out infinite;"
            >
              <Icon name="mdi:magnify" class="w-6 h-6 text-mint" />
            </div>
            <p class="block text-mint font-black uppercase text-lg font-display">
              Find Your Way Back!
            </p>
          </div>
          <form action="/search" method="get" class="flex flex-col sm:flex-row gap-3">
            <input
              type="text"
              name="q"
              placeholder="Type anything..."
              aria-label="Search"
              class="flex-1 px-4 py-4 border border-white/15 rounded-sm bg-black/30 text-white font-bold text-lg focus:outline-none focus:border-mint transition-all"
            />
            <button
              type="submit"
              class="px-8 py-4 bg-magenta border border-white/10 rounded-sm text-white font-black uppercase hover:bg-magenta-bright transition-all relative group overflow-hidden font-display"
            >
              <span class="relative z-10 flex items-center gap-2">
                <Icon name="mdi:rocket-launch" class="w-5 h-5" />
                GO!
              </span>
            </button>
          </form>
          <div class="flex items-center justify-between mt-4">
            <p class="text-mint text-xs font-bold opacity-75">Or just click around ↑</p>
            <div class="flex gap-2">
              <div
                class="w-3 h-3 bg-magenta rounded-full"
                style="animation: pulse 1s ease-in-out infinite;"
              >
              </div>
              <div
                class="w-3 h-3 bg-yellow rounded-full"
                style="animation: pulse 1s ease-in-out infinite 0.2s;"
              >
              </div>
              <div
                class="w-3 h-3 bg-mint rounded-full"
                style="animation: pulse 1s ease-in-out infinite 0.4s;"
              >
              </div>
            </div>
          </div>
        </BrutalCard>
      </div>

      <!-- Random Quote with STYLE -->
      <div class="max-w-2xl mx-auto mt-20 relative">
        <BrutalCard variant="surface" shadow="mint" padding="lg" class="transform -rotate-1">
          <div class="absolute -top-4 left-8 rotate-3">
            <BrutalBadge variant="magenta">Fun Fact</BrutalBadge>
          </div>
          <Icon name="mdi:format-quote-open" class="w-12 h-12 text-magenta mb-4" />
          <blockquote class="text-white text-xl font-black mb-4 leading-tight">
            "Not all who wander are lost... but this page definitely is. Unlike our policies, which
            are crystal clear!"
          </blockquote>
          <div class="flex items-center gap-3">
            <div class="w-8 h-1 bg-magenta"></div>
            <p class="text-sm font-bold text-white/50 uppercase">Ancient Internet Proverb</p>
          </div>
        </BrutalCard>
      </div>

      <!-- Bonus Chaos Section -->
      <div class="max-w-5xl mx-auto mt-16 grid md:grid-cols-4 gap-4">
        <a
          href="/faq"
          class="bg-mint/10 border border-mint rounded-sm p-4 text-center font-black uppercase hover:bg-mint/20 transition-colors transform hover:scale-105 font-display text-mint"
        >
          <Icon name="mdi:frequently-asked-questions" class="w-8 h-8 mx-auto mb-2" />
          FAQ
        </a>
        <a
          href="/about"
          class="bg-magenta/10 border border-magenta rounded-sm p-4 text-center font-black uppercase text-magenta hover:bg-magenta/20 transition-colors transform hover:scale-105 font-display"
        >
          <Icon name="mdi:information" class="w-8 h-8 mx-auto mb-2" />
          About
        </a>
        <a
          href="/electorates"
          class="bg-yellow/10 border border-yellow rounded-sm p-4 text-center font-black uppercase text-yellow hover:bg-yellow/20 transition-colors transform hover:scale-105 font-display"
        >
          <Icon name="mdi:map-marker-multiple" class="w-8 h-8 mx-auto mb-2" />
          Electorates
        </a>
        <button
          onclick="window.history.back()"
          class="bg-white/5 border border-white/20 rounded-sm p-4 text-center font-black uppercase text-white hover:bg-white/10 transition-colors transform hover:scale-105 font-display"
        >
          <Icon name="mdi:arrow-left-bold" class="w-8 h-8 mx-auto mb-2" />
          Go Back
        </button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-30px) rotate(10deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes glitch {
    0%,
    90%,
    100% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(-2px, 2px);
    }
    40% {
      transform: translate(2px, -2px);
    }
    60% {
      transform: translate(-2px, -2px);
    }
    80% {
      transform: translate(2px, 2px);
    }
  }

  @keyframes glitch-layer-1 {
    0%,
    90%,
    100% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(-4px, -4px);
    }
    40% {
      transform: translate(-2px, 2px);
    }
    60% {
      transform: translate(4px, -2px);
    }
    80% {
      transform: translate(-2px, 4px);
    }
  }

  @keyframes glitch-layer-2 {
    0%,
    90%,
    100% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(4px, 4px);
    }
    40% {
      transform: translate(2px, -2px);
    }
    60% {
      transform: translate(-4px, 2px);
    }
    80% {
      transform: translate(2px, -4px);
    }
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }

  @keyframes shake {
    0%,
    100% {
      transform: translateX(0);
    }
    10%,
    30%,
    50%,
    70%,
    90% {
      transform: translateX(-5px);
    }
    20%,
    40%,
    60%,
    80% {
      transform: translateX(5px);
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  /* Prevent glitch text from being selectable */
  h2[style*='animation: glitch'] + div {
    pointer-events: none;
    user-select: none;
  }

  /* Extra chaos for hover states */
  a:active {
    transform: scale(0.95) !important;
  }

  button:active {
    transform: scale(0.95) !important;
  }
</style>
