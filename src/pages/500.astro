---
import { DEPLOYMENT } from '@/lib/deployment'
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { BrutalCard } from '@/components/ui'
import '../styles/global.css'

const errorMessages = [
  'The server had an existential crisis',
  "Something broke (and it's definitely NOT your fault)",
  'Error 500: Our code went on strike',
  'The hamsters powering our server took a break',
  "We broke the internet. Sorr... wait, it's just our server",
  'This is embarrassing. Like, really embarrassing.',
  "The server encountered feelings. It didn't go well.",
]

const techErrors = [
  'NullPointerException: democracy.quality is null',
  'TypeError: majorParties.integrity is undefined',
  'ReferenceError: honesty is not defined',
  'Error: Stack overflow in corruption.js',
  'Warning: Deprecated function useTwoPartySystem()',
  'Fatal: Out of memory (from storing all the broken promises)',
]

const randomMessage = errorMessages[Math.floor(Math.random() * errorMessages.length)]
---

<BaseLayout
  title={`500 - Server Error | ${DEPLOYMENT.label}`}
  description="Oops! Something went wrong on our end."
  noindex={true}
>
  <Header />

  <main
    id="main-content"
    class="min-h-screen bg-black relative overflow-hidden pt-28 pb-20 surface-dark"
  >
    <!-- Fire and chaos background -->
    <div class="absolute inset-0 opacity-20">
      {
        [...Array(8)].map((_, i) => (
          <div
            class={`absolute text-8xl ${i % 2 === 0 ? 'text-link' : 'text-link'}`}
            style={`
            top: ${Math.random() * 80 + 10}%;
            left: ${Math.random() * 90}%;
            animation: float ${3 + i}s ease-in-out infinite, flicker ${1 + i * 0.3}s ease-in-out infinite;
          `}
          >
            🔥
          </div>
        ))
      }
    </div>

    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <!-- Giant 500 -->
      <div class="text-center mb-12">
        <div class="relative inline-block mb-8">
          <div class="absolute inset-0 bg-yellow blur-3xl opacity-30 animate-pulse surface-accent">
          </div>
          <h1
            class="relative text-[12rem] md:text-[20rem] font-black uppercase leading-none text-fg font-display"
            style="animation: shake 0.5s ease-in-out infinite;"
          >
            500
          </h1>
        </div>

        <h2 class="text-4xl md:text-6xl font-black uppercase text-fg mb-6 font-display">
          INTERNAL SERVER ERROR
        </h2>

        <p class="text-2xl font-bold text-link">(We're the ones who messed up this time)</p>
      </div>

      <!-- Error Message Card -->
      <div class="max-w-3xl mx-auto mb-12 relative">
        <div
          class="absolute -top-8 -right-8 w-24 h-24 bg-yellow/20 border border-yellow rounded-sm rotate-45 flex items-center justify-center"
          style="animation: spin 4s linear infinite;"
        >
          <Icon name="mdi:fire" class="w-16 h-16 text-link -rotate-45" />
        </div>

        <BrutalCard variant="surface" shadow="yellow" padding="lg">
          <div class="flex items-start gap-4 mb-6">
            <div
              class="w-16 h-16 bg-magenta/10 border border-magenta rounded-sm flex items-center justify-center flex-shrink-0"
              style="animation: wiggle 2s ease-in-out infinite;"
            >
              <Icon name="mdi:alert-octagon" class="w-10 h-10 text-link" />
            </div>
            <div>
              <h3 class="text-3xl font-black uppercase text-link mb-2 font-display">OH NO!</h3>
              <p class="text-xl md:text-2xl font-bold text-fg">
                {randomMessage}
              </p>
            </div>
          </div>

          <!-- Fake Console Output -->
          <div
            class="bg-surface-raised border border-line rounded-sm p-6 font-mono text-sm overflow-x-auto surface-paper"
          >
            <div class="flex items-center gap-2 mb-4 pb-2 border-b border-line">
              <div class="flex gap-2">
                <div class="w-3 h-3 bg-magenta rounded-full surface-primary"></div>
                <div class="w-3 h-3 bg-yellow rounded-full surface-accent"></div>
                <div class="w-3 h-3 bg-mint rounded-full surface-secondary"></div>
              </div>
              <span class="text-muted text-xs">console.error()</span>
            </div>
            {
              techErrors.map((error, i) => (
                <div
                  class="mb-2 text-link"
                  style={`animation: fadeIn 0.5s ease-in ${i * 0.2}s backwards;`}
                >
                  <span class="text-muted">[{new Date().toLocaleTimeString()}]</span> {error}
                </div>
              ))
            }
            <div class="mt-4 text-link animate-pulse">&gt; Attempting to recover...</div>
          </div>
        </BrutalCard>
      </div>

      <!-- Action Cards -->
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
        <button
          onclick="window.location.reload()"
          class="block bg-yellow rounded-sm border border-line p-8 text-center group transition-all hover:-translate-y-2 hover:rotate-1 relative overflow-hidden surface-accent"
        >
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-magenta opacity-20 rounded-sm rotate-45 -translate-y-12 translate-x-12 group-hover:scale-150 transition-transform surface-primary"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-surface-raised border border-black/20 rounded-full group-hover:rotate-180 transition-transform duration-500 surface-paper"
            >
              <Icon name="mdi:refresh" class="w-12 h-12 text-fg" />
            </div>
            <h3 class="text-3xl font-black uppercase mb-2 text-black font-display">Try Again</h3>
            <p class="text-sm font-bold text-black">Maybe it'll work now?</p>
          </div>
        </button>

        <a
          href="/"
          class="block bg-grey-dark border border-line rounded-sm p-8 text-center group transition-all hover:-translate-y-2 hover:-rotate-1 relative overflow-hidden surface-paper"
        >
          <div
            class="absolute bottom-0 left-0 w-32 h-32 bg-yellow opacity-10 rounded-sm -rotate-45 translate-y-12 -translate-x-12 group-hover:scale-150 transition-transform surface-accent"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-magenta/10 border border-magenta rounded-full group-hover:rotate-180 transition-transform duration-500"
            >
              <Icon name="mdi:home" class="w-12 h-12 text-link" />
            </div>
            <h3 class="text-3xl font-black uppercase mb-2 text-fg font-display">Go Home</h3>
            <p class="text-sm font-bold text-muted">Safe haven awaits</p>
          </div>
        </a>

        <a
          href={DEPLOYMENT.cta.contact}
          class="block bg-magenta rounded-sm border border-line p-8 text-center group transition-all hover:-translate-y-2 hover:rotate-1 relative overflow-hidden surface-primary"
        >
          <div
            class="absolute top-0 left-0 w-32 h-32 bg-yellow opacity-20 rounded-sm rotate-12 -translate-y-12 -translate-x-12 group-hover:scale-150 transition-transform surface-accent"
          >
          </div>
          <div class="relative z-10">
            <div
              class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-white/10 border border-line-mid rounded-full group-hover:rotate-180 transition-transform duration-500"
            >
              <Icon name="mdi:email-alert" class="w-12 h-12 text-fg" />
            </div>
            <h3 class="text-3xl font-black uppercase mb-2 text-fg font-display">Report Bug</h3>
            <p class="text-sm font-bold text-fg">Help us fix this!</p>
          </div>
        </a>
      </div>

      <!-- Apology Box -->
      <div class="max-w-2xl mx-auto">
        <BrutalCard variant="surface" shadow="yellow" padding="lg" class="transform -rotate-1">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-16 h-16 bg-yellow/10 border border-yellow rounded-sm flex items-center justify-center"
            >
              <Icon name="mdi:emoticon-sad" class="w-10 h-10 text-link" />
            </div>
            <h3 class="text-2xl font-black uppercase font-display">Our Sincere Apologies</h3>
          </div>
          <p class="text-lg font-bold text-muted leading-relaxed mb-4">
            We're experiencing technical difficulties. Our team has been notified and we're working
            on it!
          </p>
          <p class="text-sm font-bold text-muted">
            Unlike the major parties, we actually admit when we make mistakes and work to fix them.
            💪
          </p>
        </BrutalCard>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes shake {
    0%,
    100% {
      transform: translate(0, 0);
    }
    10%,
    30%,
    50%,
    70%,
    90% {
      transform: translate(-5px, 2px);
    }
    20%,
    40%,
    60%,
    80% {
      transform: translate(5px, -2px);
    }
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
