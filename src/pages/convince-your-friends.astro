---
import BranchLanding from '@/components/layout/BranchLanding.astro'
import { DEPLOYMENT } from '@/lib/deployment'
export const prerender = false
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { BrutalCard, BrutalButton, BrutalBadge, FloatingIcon, Section } from '../components/ui'
import { Icon } from 'astro-icon/components'
import '../styles/global.css'
import '../styles/editorial.css'
import { getConvinceYourFriendsPage } from '../lib/sanity'

// Fetch content from Sanity
const pageData = await getConvinceYourFriendsPage()

interface MessageTemplate {
  id: string
  title: string
  audience: string
  channel: 'email' | 'text' | 'social' | 'linkedin'
  icon: string
  color: 'magenta' | 'mint' | 'yellow'
  subject?: string
  body: string
  tags: string[]
}

const defaultTemplates: MessageTemplate[] = [
  {
    id: 'boomer-housing',
    title: 'Email about housing',
    audience: 'Family',
    channel: 'email',
    icon: 'mdi:home-heart',
    color: 'magenta',
    subject: 'A housing policy worth reading',
    body: `Hi Mum/Dad,

I've been reading Fusion Victoria's housing policies. They want to allow more homes in established suburbs and near stations, with public housing and infrastructure planned alongside growth.

The details matter: affordable housing rules, costs and delivery still need testing. I like that they say so.

Here's the housing policy: https://fusionparty.org.au/policies/build-housing-at-stations

What do you think?

[Your name]`,
    tags: ['housing', 'family', 'intergenerational'],
  },
  {
    id: 'work-chat-transport',
    title: 'Message to Work Chat About Transport',
    audience: 'Work Colleagues',
    channel: 'text',
    icon: 'mdi:train-car',
    color: 'mint',
    body: `I've been reading Fusion Victoria's transport policy. They want one connected passenger network, with clear service standards and a proper comparison of public operation and regulated contracts.

They aren't banking a saving before an audit. Worth a look: https://fusionparty.org.au/policies/claw-back-franchise-profits`,
    tags: ['transport', 'workplace', 'time-poverty'],
  },
  {
    id: 'climate-anxious-friend',
    title: 'Text to Your Climate-Anxious Friend',
    audience: 'Climate-Concerned Friends',
    channel: 'text',
    icon: 'mdi:earth',
    color: 'yellow',
    body: `I've been looking at Fusion Victoria's policies on climate, homes and transport. They put the proposals and costs where we can question them.

If you have five minutes, take a look and tell me what you think: https://fusionparty.org.au/policies`,
    tags: ['climate', 'mental-health', 'hope'],
  },
  {
    id: 'linkedin-corporate',
    title: 'Professional network post',
    audience: 'Professional Network',
    channel: 'linkedin',
    icon: 'mdi:briefcase-account',
    color: 'magenta',
    body: `I've been reading Fusion Victoria's platform. Its housing proposals would allow more homes near existing services, while its transport policy calls for a connected network and an audit before claiming franchise savings.

The party draws on ideas from across the political spectrum and tests them for Victoria. I don't agree with every detail, but the approach deserves scrutiny.

Policies: https://fusionparty.org.au/policies

What would you change?`,
    tags: ['professional', 'policy', 'evidence-based'],
  },
  {
    id: 'instagram-story',
    title: 'Instagram Story Script',
    audience: 'Social Media Friends',
    channel: 'social',
    icon: 'mdi:instagram',
    color: 'mint',
    body: `I've been reading Fusion Victoria's policies. More homes near trains, a connected transport network, and published costs before claimed savings.

Read them and decide for yourself: fusionparty.org.au/policies`,
    tags: ['social-media', 'youth', 'viral'],
  },
  {
    id: 'facebook-parents-group',
    title: 'Parents group post',
    audience: 'Parent Communities',
    channel: 'social',
    icon: 'mdi:facebook',
    color: 'yellow',
    body: `I've been reading Fusion Victoria's housing and transport plans. More homes near stations could give our kids more choices, but infrastructure and affordable housing rules need careful design.

The policies are public: fusionparty.org.au/policies

What would help families in our area?`,
    tags: ['parenting', 'future', 'family-values'],
  },
]

const templates: MessageTemplate[] = pageData?.templates || defaultTemplates

const channelInfo = {
  email: {
    icon: 'mdi:email',
    name: 'Email',
    tip: 'Best for: Detailed conversations with family/older friends',
  },
  text: {
    icon: 'mdi:message-text',
    name: 'Text/WhatsApp',
    tip: 'Best for: Quick shares with close friends',
  },
  social: {
    icon: 'mdi:share-variant',
    name: 'Social Media',
    tip: 'Best for: Reaching your wider network',
  },
}

const defaultTips = [
  {
    title: 'Personalize It',
    description:
      'Add your own experiences. "I\'ve been paying $650/week for a shoebox apartment" hits harder than generic statements.',
    icon: 'mdi:pencil',
    color: 'magenta',
  },
  {
    title: 'Know Your Audience',
    description:
      'Climate messaging for young friends, economic messaging for business contacts. Match the template to your audience.',
    icon: 'mdi:account-group',
    color: 'mint',
  },
  {
    title: 'Timing Matters',
    description:
      'Share when people are paying attention: during election campaigns, after major news events, or when issues directly affect them.',
    icon: 'mdi:clock-fast',
    color: 'yellow',
  },
  {
    title: 'Be Genuine',
    description:
      "Don't spam. Share because you genuinely believe in the cause. Authenticity is contagious.",
    icon: 'mdi:heart',
    color: 'magenta',
  },
]

const tips = pageData?.tips || defaultTips

const defaultContrastSection = {
  title: "This Isn't Normal Marketing",
  subtitle:
    'Major parties say "Share our posts!" - We say "Here\'s how to have real conversations."',
  oldWay: {
    title: '"Share Our Posts!"',
    points: [
      'Canned corporate messages',
      'One-size-fits-all copy',
      'Obvious marketing',
      "You're just a megaphone",
    ],
    feeling: 'Being used as free advertising',
  },
  fusionWay: {
    title: '"Talk About What Matters"',
    points: [
      '6 templates for different audiences',
      'Fully customizable - make it yours',
      'Real conversations, not propaganda',
      "You're building something real",
    ],
    feeling: 'Being empowered to make change',
  },
}

const contrastSection = pageData?.contrastSection || defaultContrastSection
---

{
  DEPLOYMENT.slug !== 'vic' && !pageData ? (
    <BranchLanding
      title="Share our work"
      description="Read our published policies and share the proposals that matter to you."
    />
  ) : (
    <BaseLayout
      title={`${pageData?.title || 'Convince Your Friends'} | ${DEPLOYMENT.label}`}
      description={
        pageData?.subtitle ||
        'Ready-to-send templates to share Fusion policies with your network. Make it easy to spread the word.'
      }
    >
      <Header />

      {/* Floating Background Icons */}
      <div class="fixed inset-0 pointer-events-none overflow-hidden opacity-5 z-0">
        <FloatingIcon
          name="mdi:email-fast"
          position={{ left: '5%', top: '10%' }}
          delay="0s"
          size={80}
        />
        <FloatingIcon
          name="mdi:share-variant"
          position={{ left: '85%', top: '15%' }}
          delay="2s"
          size={60}
        />
        <FloatingIcon
          name="mdi:account-group"
          position={{ left: '10%', top: '60%' }}
          delay="4s"
          size={70}
        />
        <FloatingIcon
          name="mdi:bullhorn"
          position={{ left: '80%', top: '65%' }}
          delay="3s"
          size={90}
        />
        <FloatingIcon
          name="mdi:heart-multiple"
          position={{ left: '50%', top: '80%' }}
          delay="1s"
          size={50}
        />
      </div>

      <main id="main-content" class="site-editorial relative z-10">
        {/* Hero Section */}
        <Section padding="xl" bg="dark" class="pt-32 pb-20">
          <div class="max-w-4xl mx-auto text-center">
            <div class="inline-block mb-6">
              <BrutalBadge variant="magenta" size="lg">
                Grassroots Organizing
              </BrutalBadge>
            </div>

            <h1 class="text-5xl md:text-7xl font-display font-black uppercase mb-6 leading-[1]">
              {pageData?.title || 'Convince Your'}
              {!pageData?.title && <span class="text-magenta">Friends</span>}
            </h1>

            <p class="text-xl md:text-2xl font-bold mb-8 max-w-2xl mx-auto leading-tight text-fg/80">
              {pageData?.subtitle ||
                "Don't know what to say? Use these pre-written templates to share Fusion policies with your network. One click to copy, customized for different audiences."}
            </p>

            <div class="flex flex-wrap gap-4 justify-center items-center mb-8">
              <div class="flex items-center gap-2 bg-grey-dark border border-white/10 rounded-sm px-4 py-2">
                <Icon name="mdi:rocket-launch" class="w-5 h-5 text-magenta" />
                <span class="font-black text-sm">READY TO SEND</span>
              </div>
              <div class="flex items-center gap-2 bg-grey-dark border border-white/10 rounded-sm px-4 py-2">
                <Icon name="mdi:account-multiple" class="w-5 h-5 text-magenta" />
                <span class="font-black text-sm">{templates.length} AUDIENCES</span>
              </div>
              <div class="flex items-center gap-2 bg-grey-dark border border-white/10 rounded-sm px-4 py-2">
                <Icon name="mdi:content-copy" class="w-5 h-5 text-magenta" />
                <span class="font-black text-sm">ONE CLICK COPY</span>
              </div>
            </div>

            {/* Why It Works */}
            <BrutalCard variant="surface" shadow="magenta" padding="lg" class="text-left">
              <h3 class="text-2xl font-display font-black text-magenta mb-4 uppercase flex items-center gap-3">
                <Icon name="mdi:lightbulb-on" class="w-8 h-8" />
                Why This Works
              </h3>
              <ul class="space-y-3 text-lg">
                {pageData?.whyItWorks?.map((item: any) => (
                  <li class="flex items-start gap-3">
                    <Icon
                      name={item.icon || 'mdi:check-bold'}
                      class="w-6 h-6 text-mint flex-shrink-0 mt-1"
                    />
                    <span>
                      <strong>{item.title}:</strong> {item.description}
                    </span>
                  </li>
                )) || (
                  <>
                    <li class="flex items-start gap-3">
                      <Icon name="mdi:check-bold" class="w-6 h-6 text-mint flex-shrink-0 mt-1" />
                      <span>
                        <strong>Lower Friction:</strong> Don't know what to say? We've written it
                        for you.
                      </span>
                    </li>
                    <li class="flex items-start gap-3">
                      <Icon name="mdi:check-bold" class="w-6 h-6 text-mint flex-shrink-0 mt-1" />
                      <span>
                        <strong>Targeted Messaging:</strong> Different approaches for different
                        audiences.
                      </span>
                    </li>
                    <li class="flex items-start gap-3">
                      <Icon name="mdi:check-bold" class="w-6 h-6 text-mint flex-shrink-0 mt-1" />
                      <span>
                        <strong>Exponential Growth:</strong> Every person you reach can reach their
                        network.
                      </span>
                    </li>
                    <li class="flex items-start gap-3">
                      <Icon name="mdi:check-bold" class="w-6 h-6 text-mint flex-shrink-0 mt-1" />
                      <span>
                        <strong>Authentic:</strong> Fully customizable - make it your own voice.
                      </span>
                    </li>
                  </>
                )}
              </ul>
            </BrutalCard>
          </div>
        </Section>

        {/* Channel Filter Section */}
        <Section padding="lg" bg="dark">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-display font-black text-center mb-8 uppercase">
              Choose Your Channel
            </h2>
            <div class="grid md:grid-cols-4 gap-4 mb-12">
              {Object.entries(channelInfo).map(([key, info]) => (
                <button
                  data-channel={key}
                  class="channel-filter bg-grey-dark border border-white/10 rounded-sm p-4 hover:border-yellow/50 transition-all transform hover:scale-105 active:scale-95"
                >
                  <Icon name={info.icon} class="w-10 h-10 mx-auto mb-2 text-magenta" />
                  <p class="font-black uppercase text-sm mb-1">{info.name}</p>
                  <p class="text-xs text-fg/60">{info.tip}</p>
                </button>
              ))}
            </div>
          </div>
        </Section>

        {/* Templates Grid */}
        <Section padding="xl" bg="dark">
          <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-4xl font-display font-black uppercase mb-4">Pick Your Template</h2>
              <p class="text-lg font-bold max-w-2xl mx-auto text-fg/70">
                Click to expand, customize if needed, then copy and send!
              </p>
            </div>

            <div class="space-y-6" id="templates-container">
              {templates.map((template) => (
                <BrutalCard
                  variant="surface"
                  shadow={template.color}
                  padding="lg"
                  hover={false}
                  class="template-card cursor-pointer"
                  data-channel={template.channel}
                >
                  {/* Collapsed View */}
                  <div class="template-header flex items-center justify-between">
                    <div class="flex items-center gap-4 flex-1">
                      <div
                        class={`w-16 h-16 bg-${template.color} rounded-sm flex items-center justify-center flex-shrink-0`}
                      >
                        <Icon name={template.icon} class="w-8 h-8 text-fg" />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-xl font-display font-black uppercase mb-1">
                          {template.title}
                        </h3>
                        <p class="text-sm font-bold text-fg/60 mb-2">{template.audience}</p>
                        <div class="flex flex-wrap gap-2">
                          {template.tags.map((tag) => (
                            <span class="text-xs bg-white/10 rounded-sm px-2 py-1 font-bold">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                    <BrutalButton variant="magenta" class="expand-btn" icon="mdi:chevron-down">
                      OPEN
                    </BrutalButton>
                  </div>

                  {/* Expanded View */}
                  <div class="template-body hidden mt-6 pt-6 border-t border-white/10">
                    {template.subject && (
                      <div class="mb-4">
                        <label class="block text-sm font-black uppercase mb-2 text-magenta">
                          Subject Line:
                        </label>
                        <div class="bg-black/30 border border-white/10 rounded-sm p-3 font-bold">
                          {template.subject}
                        </div>
                      </div>
                    )}

                    <div class="mb-4">
                      <label class="block text-sm font-black uppercase mb-2 text-magenta flex items-center justify-between">
                        <span>Message:</span>
                        <span class="text-xs text-fg/60 normal-case font-bold">
                          (Click to edit if you want to personalize)
                        </span>
                      </label>
                      <textarea class="w-full h-64 bg-black/30 border border-white/10 rounded-sm p-4 font-mono text-sm text-fg resize-none focus:outline-none focus:border-magenta">
                        {template.body}
                      </textarea>
                    </div>

                    <div class="flex flex-wrap gap-3">
                      <BrutalButton
                        variant="magenta"
                        size="lg"
                        class="copy-btn"
                        icon="mdi:content-copy"
                      >
                        COPY TO CLIPBOARD
                      </BrutalButton>
                      <BrutalButton variant="black" size="lg" class="collapse-btn">
                        CLOSE
                      </BrutalButton>
                    </div>

                    <div class="mt-4 p-4 bg-yellow/10 border border-yellow/30 rounded-sm">
                      <p class="text-sm font-bold flex items-start gap-2">
                        <Icon
                          name="mdi:lightbulb"
                          class="w-5 h-5 text-yellow flex-shrink-0 mt-0.5"
                        />
                        <span>
                          <strong>Pro tip:</strong> Personalize the template with your own words and
                          experiences. Authentic messages are more convincing!
                        </span>
                      </p>
                    </div>
                  </div>
                </BrutalCard>
              ))}
            </div>
          </div>
        </Section>

        {/* Tips Section */}
        <Section padding="xl" bg="dark">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-display font-black text-center mb-8 uppercase">
              Tips for Maximum Impact
            </h2>

            <div class="grid md:grid-cols-2 gap-6">
              {tips.map((tip: any) => (
                <BrutalCard variant="surface" shadow={tip.color} padding="lg">
                  <h3
                    class={`text-xl font-display font-black text-${tip.color} mb-3 uppercase flex items-center gap-2`}
                  >
                    <Icon name={tip.icon} class="w-6 h-6" />
                    {tip.title}
                  </h3>
                  <p class="font-bold text-fg/70">{tip.description}</p>
                </BrutalCard>
              ))}
            </div>
          </div>
        </Section>

        {/* Share Your Success Section */}
        <Section padding="xl" bg="dark">
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-8">
              <div class="inline-block mb-6">
                <BrutalBadge variant="magenta" size="lg" icon="mdi:message-star">
                  Used a Template?
                </BrutalBadge>
              </div>
              <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-6 leading-tight">
                Tell Us How It Went!
              </h2>
              <p class="text-xl font-bold mb-8 max-w-2xl mx-auto text-fg/70">
                Did it work? Did you customize it? Did your boomer dad actually read it? Your
                feedback helps us improve these for everyone.
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-8">
              <BrutalCard variant="surface" shadow="magenta" padding="lg">
                <Icon name="mdi:thumb-up" class="w-12 h-12 text-magenta mb-3" />
                <h3 class="text-xl font-display font-black uppercase mb-2">Success Stories</h3>
                <p class="font-bold text-fg/70 text-sm">
                  "Used the parent template and my mum actually joined!" - These are gold. Help
                  others see what works.
                </p>
              </BrutalCard>

              <BrutalCard variant="surface" shadow="mint" padding="lg">
                <Icon name="mdi:pencil-box" class="w-12 h-12 text-mint mb-3" />
                <h3 class="text-xl font-display font-black uppercase mb-2">Your Tweaks</h3>
                <p class="font-bold text-fg/70 text-sm">
                  Changed something that landed better? Share it! Community-sourced improvements
                  make these templates stronger.
                </p>
              </BrutalCard>
            </div>

            <BrutalCard variant="magenta" shadow="black" padding="xl" class="text-center">
              {/* Form content (same as before) */}
              <h3 class="text-2xl font-display font-black uppercase mb-4 text-fg">
                Quick Feedback Form
              </h3>
              <form
                action="https://formspree.io/f/YOUR_FORM_ID"
                method="POST"
                class="max-w-xl mx-auto space-y-4"
              >
                {/* TODO: Replace YOUR_FORM_ID with actual Formspree ID or use your own form endpoint */}
                <input type="hidden" name="_subject" value="Convince Your Friends - Feedback" />
                <div class="text-left">
                  <label class="block text-fg font-black uppercase text-sm mb-2">
                    Which template did you use?
                  </label>
                  <select
                    name="template"
                    required
                    class="w-full px-4 py-3 bg-neutral-panel border border-white/20 rounded-sm text-fg font-bold focus:outline-none focus:border-yellow"
                  >
                    <option value="">Select a template...</option>
                    {templates.map((t) => (
                      <option value={t.id}>{t.title}</option>
                    ))}
                  </select>
                </div>

                <div class="text-left">
                  <label class="block text-fg font-black uppercase text-sm mb-2">
                    How did it go?
                  </label>
                  <div class="flex gap-3">
                    <label class="flex-1">
                      <input
                        type="radio"
                        name="result"
                        value="great"
                        class="sr-only peer"
                        required
                      />
                      <div class="bg-neutral-panel border border-white/20 rounded-sm p-3 text-center font-black cursor-pointer hover:border-mint/50 transition-all peer-checked:bg-mint peer-checked:text-black peer-checked:border-mint">
                        Great!
                      </div>
                    </label>
                    <label class="flex-1">
                      <input type="radio" name="result" value="ok" class="sr-only peer" />
                      <div class="bg-neutral-panel border border-white/20 rounded-sm p-3 text-center font-black cursor-pointer hover:border-yellow/50 transition-all peer-checked:bg-yellow peer-checked:text-fg peer-checked:border-yellow">
                        OK
                      </div>
                    </label>
                    <label class="flex-1">
                      <input type="radio" name="result" value="meh" class="sr-only peer" />
                      <div class="bg-neutral-panel border border-white/20 rounded-sm p-3 text-center font-black cursor-pointer hover:border-white/40 transition-all peer-checked:bg-white/20 peer-checked:border-white/40">
                        Meh
                      </div>
                    </label>
                  </div>
                </div>

                <div class="text-left">
                  <label class="block text-fg font-black uppercase text-sm mb-2">
                    What happened? (Optional but helpful!)
                  </label>
                  <textarea
                    name="feedback"
                    rows="4"
                    placeholder="e.g., 'My dad actually read the whole thing and said he'd look into it!' or 'The work chat ignored it but my colleague DM'd me asking for more info'"
                    class="w-full px-4 py-3 bg-neutral-panel border border-white/20 rounded-sm text-fg font-bold resize-none focus:outline-none focus:border-yellow"
                  />
                </div>

                <div class="text-left">
                  <label class="flex items-start gap-3 cursor-pointer">
                    <input
                      type="checkbox"
                      name="can_share"
                      value="yes"
                      class="mt-1 w-5 h-5 border border-white/30 rounded-sm bg-neutral-panel"
                    />
                    <span class="text-fg font-bold text-sm">
                      You can share this as a testimonial (we'll keep you anonymous unless you tell
                      us otherwise)
                    </span>
                  </label>
                </div>

                <BrutalButton type="submit" variant="yellow" fullWidth icon="mdi:send">
                  Send Feedback
                </BrutalButton>
              </form>

              <p class="text-fg text-sm font-bold mt-6 opacity-90">
                Your feedback literally makes these templates better. Thank you! 💛
              </p>
            </BrutalCard>
          </div>
        </Section>

        {/* The Contrast Section */}
        <Section padding="xl" bg="dark">
          <div class="max-w-5xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-4xl font-display font-black uppercase mb-4">
                {contrastSection.title}
              </h2>
              <p class="text-xl font-bold max-w-3xl mx-auto text-fg/70">
                {contrastSection.subtitle}
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {/* Major Parties Way */}
              <div>
                <div class="bg-grey-dark border border-white/10 rounded-sm p-6 mb-4 relative">
                  <div class="absolute -top-3 -right-3 bg-white/20 text-fg px-3 py-1 text-xs font-black rounded-sm">
                    OLD POLITICS
                  </div>
                  <Icon name="mdi:alert-circle" class="w-10 h-10 text-fg/50 mb-3" />
                  <h3 class="text-xl font-display font-black uppercase mb-3 text-fg/70">
                    {contrastSection.oldWay.title}
                  </h3>
                  <ul class="space-y-2 text-sm font-bold text-fg/50">
                    {contrastSection.oldWay.points.map((point: any) => (
                      <li class="flex items-start gap-2">
                        <span class="text-red">✗</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-4 text-xs font-black text-fg/40 italic">
                    Feels like: {contrastSection.oldWay.feeling}
                  </p>
                </div>
              </div>

              {/* Fusion Way */}
              <div>
                <BrutalCard variant="surface" shadow="magenta" padding="lg" class="h-full relative">
                  <div class="absolute -top-3 -right-3 bg-magenta text-fg px-3 py-1 text-xs font-black rounded-sm">
                    FUSION WAY
                  </div>
                  <Icon name="mdi:heart-multiple" class="w-10 h-10 text-magenta mb-3" />
                  <h3 class="text-xl font-display font-black uppercase mb-3 text-magenta">
                    {contrastSection.fusionWay.title}
                  </h3>
                  <ul class="space-y-2 text-sm font-bold">
