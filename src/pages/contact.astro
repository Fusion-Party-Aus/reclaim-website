---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { Hero } from '@/components/layout/Hero'
import { getDocuments } from '../lib/sanity'
import '../styles/global.css'
import '../styles/editorial.css'

interface SocialLink {
  platform: string
  icon: string
  url: string
}

interface ContactPage {
  title?: string
  subtitle?: string
  intro?: string
  generalContact?: {
    heading?: string
    description?: string
    email?: string
    phone?: string
    discordUrl?: string
    mailingListUrl?: string
  }
  mediaContact?: {
    heading?: string
    description?: string
    email?: string
    phone?: string
  }
  mailingAddress?: {
    heading?: string
    description?: string
    address?: string
  }
  socialLinks?: SocialLink[]
}

const results = await getDocuments<ContactPage>('contactPage')
const data: ContactPage = results?.[0] ?? {}

const title = data.title ?? 'Contact Us'
const subtitle = data.subtitle ?? "We'd love to hear from you."
const intro =
  data.intro ??
  "Whether you're a voter, journalist, or potential member — we actually pick up the phone."

const general = data.generalContact ?? {
  heading: 'General Enquiries',
  description: 'For feedback or questions about the party or this website:',
  email: 'contact@fusionparty.org.au',
  phone: '0410 249 574',
  discordUrl: 'https://www.fusionparty.org.au/discord',
}

const media = data.mediaContact ?? {
  heading: 'Media Inquiries',
  description: 'For members of the press only:',
  email: 'press@fusionparty.org.au',
}

const address = data.mailingAddress ?? {
  heading: 'Mailing Address',
  description: 'Legal correspondence only:',
  address: '254 McLeod Lane\nMansfield VIC 3722\nAustralia',
}

const socialLinks: SocialLink[] = data.socialLinks ?? [
  { platform: 'Facebook', icon: 'mdi:facebook', url: 'https://www.facebook.com/FusionPartyAus/' },
  { platform: 'Twitter / X', icon: 'mdi:twitter', url: 'https://twitter.com/FusionPartyAus' },
  {
    platform: 'Instagram',
    icon: 'mdi:instagram',
    url: 'https://www.instagram.com/fusionpartyaus/',
  },
  { platform: 'YouTube', icon: 'mdi:youtube', url: 'https://www.youtube.com/c/fusionpartyaus' },
  { platform: 'TikTok', icon: 'mdi:music-note', url: 'https://www.tiktok.com/@fusionpartyaus' },
  { platform: 'Discord', icon: 'mdi:discord', url: 'https://www.fusionparty.org.au/discord' },
  { platform: 'Mastodon', icon: 'mdi:mastodon', url: 'https://mastodon.au/@FusionPartyAus' },
  {
    platform: 'LinkedIn',
    icon: 'mdi:linkedin',
    url: 'https://www.linkedin.com/company/fusionpartyaus/',
  },
]
---

<BaseLayout title={`${title} | Fusion Party Victoria`} description={intro}>
  <Header />
  <main id="main-content" class="site-editorial">
    <Hero title={title} subtitle={intro} eyebrow="Get in touch" compact />
    <div class="editorial-shell contact-directory">
      <section class="contact-row">
        <div>
          <p class="editorial-kicker">01 · Start a conversation</p><h2>{general.heading}</h2><p>
            {general.description}
          </p>
        </div>
        <div class="contact-links">
          {
            general.email && (
              <a href={`mailto:${general.email}`}>
                <>
                  <Icon name="mdi:email-outline" class="w-5 h-5" />
                  <span>{general.email}</span>
                  <span aria-hidden="true">→</span>
                </>
              </a>
            )
          }
          {
            general.phone && (
              <a href={`tel:${general.phone.replace(/\s/g, '')}`}>
                <>
                  <Icon name="mdi:phone" class="w-5 h-5" />
                  <span>{general.phone}</span>
                  <span aria-hidden="true">→</span>
                </>
              </a>
            )
          }
          {
            general.discordUrl && (
              <a href={general.discordUrl} target="_blank" rel="noopener noreferrer">
                <>
                  <Icon name="mdi:discord" class="w-5 h-5" />
                  <span>Join our Discord</span>
                  <span aria-hidden="true">↗</span>
                </>
              </a>
            )
          }
          {
            general.mailingListUrl && (
              <a href={general.mailingListUrl} target="_blank" rel="noopener noreferrer">
                <>
                  <Icon name="mdi:email-newsletter" class="w-5 h-5" />
                  <span>Join the mailing list</span>
                  <span aria-hidden="true">↗</span>
                </>
              </a>
            )
          }
        </div>
      </section>
      <section class="contact-row">
        <div>
          <p class="editorial-kicker">02 · Press desk</p><h2>{media.heading}</h2><p>
            {media.description}
          </p>
        </div>
        <div class="contact-links">
          {
            media.email && (
              <a href={`mailto:${media.email}`}>
                <>
                  <Icon name="mdi:newspaper" class="w-5 h-5" />
                  <span>{media.email}</span>
                  <span aria-hidden="true">→</span>
                </>
              </a>
            )
          }
          {
            media.phone && (
              <a href={`tel:${media.phone.replace(/\s/g, '')}`}>
                <>
                  <Icon name="mdi:phone" class="w-5 h-5" />
                  <span>{media.phone}</span>
                  <span aria-hidden="true">→</span>
                </>
              </a>
            )
          }
          <p class="contact-note">
            Press line only. Please send general enquiries to the contacts above.
          </p>
        </div>
      </section>
      <section class="contact-row">
        <div>
          <p class="editorial-kicker">03 · Correspondence</p><h2>{address.heading}</h2><p>
            {address.description}
          </p>
        </div>
        {address.address && <address class="contact-address">{address.address}</address>}
      </section>
      <section class="contact-row">
        <div>
          <p class="editorial-kicker">04 · Stay connected</p><h2>Follow the conversation</h2><p>
            News, analysis and updates from the movement.
          </p>
        </div>
        <div class="contact-socials">
          {
            socialLinks.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                <Icon name={link.icon} class="w-5 h-5" />
                {link.platform}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
