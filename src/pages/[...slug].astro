---
import { DEPLOYMENT } from '@/lib/deployment'
export const prerender = false

import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { StandardPage } from '@/features/page-rendering'
import { BioPage } from '@/features/page-rendering'
import { getPages, urlFor } from '../lib/sanity'
import type { Page } from '../types/sanity'
import '../styles/global.css'
import '../styles/editorial.css'

const pages = await getPages()

const slug = Astro.params.slug || ''
// Retire the obsolete 2026 candidate recruitment entry point without deleting its CMS record.
if (DEPLOYMENT.slug === 'vic' && slug === 'stand') return Astro.redirect('/get-involved', 302)

const allPages = (pages as Page[])
  .filter((p) => p.slug?.current)
  .map((p) => {
    // Construct full path
    const segments = [p.slug.current]
    let currentParent = (p as any).parent
    while (currentParent) {
      segments.unshift(currentParent.slug.current)
      currentParent = currentParent.parent
    }
    const fullPath = segments.join('/')

    return {
      fullPath,
      page: p,
      segments,
    }
  })

const pageMatch = allPages.find((m) => m.fullPath === slug)

if (!pageMatch) {
  return Astro.redirect('/404')
}

const { segments: originalSegments } = pageMatch
let { page } = pageMatch
// Retire current campaign prompts without mutating the CMS or archived records.
if (DEPLOYMENT.slug === 'vic' && slug === 'get-involved' && page.body) {
  let obsoleteSection = false
  page = {
    ...page,
    body: page.body.filter((block) => {
      if (block._type === 'block' && block.style === 'h2') {
        const heading =
          block.children?.map((span: { text?: string }) => span.text || '').join('') || ''
        obsoleteSection = /vote fusion|run for office/i.test(heading)
      }
      return !obsoleteSection
    }),
  }
}
if (DEPLOYMENT.slug === 'vic' && slug === 'about' && page.body) {
  page = {
    ...page,
    body: page.body.map((block) => {
      if (block._type !== 'block' || block.style !== 'h2') return block
      const heading =
        block.children?.map((span: { text?: string }) => span.text || '').join('') || ''
      if (heading.trim().toLowerCase() !== 'reignite democracy') return block
      return {
        ...block,
        children: [{ _type: 'span', _key: 'current-title', marks: [], text: 'Democratic reform' }],
      }
    }),
  }
}
const currentSubtitle =
  DEPLOYMENT.slug === 'vic' &&
  ['about', 'get-involved'].includes(slug) &&
  /reignite|reclaim/i.test(page.subtitle || '')
    ? DEPLOYMENT.tagline
    : page.subtitle

// Intercept breadcrumbs if this page is an 'Archived' bio profile
const isArchivedBio = page.pageType === 'bio' && (page as any).isArchived === true
let segments = [...originalSegments]

if (isArchivedBio) {
  // Replace the structural hierarchy with the Archive pathway
  segments = ['past-candidates', page.slug.current]
}

// Find all descendant bio pages to build the automatic Team Grid
const childPages = allPages.filter(
  (p) =>
    p.fullPath.startsWith(slug + '/') && p.page.pageType === 'bio' && p.page.isArchived !== true
)

// Group them by their immediate parent
const groupedBios: Record<string, { title: string; pages: typeof childPages }> = {}
childPages.forEach((bio) => {
  const parentPath = bio.segments.slice(0, -1).join('/')
  const parentPageMatch = allPages.find((p) => p.fullPath === parentPath)
  const groupTitle = parentPageMatch ? parentPageMatch.page.title : 'Team Members'

  if (!groupedBios[groupTitle]) {
    groupedBios[groupTitle] = {
      title: groupTitle,
      pages: [],
    }
  }
  groupedBios[groupTitle].pages.push(bio)
})

const childGroups = Object.values(groupedBios)

const heroBgMap: Record<string, string> = {
  about: '/collage_crowd.jpg',
  'get-involved': '/color_panel_rally.jpg',
  policies: '/color_panel_rally.jpg',
  contact: '/color_panel_rally.jpg',
}

const bgImage =
  (DEPLOYMENT.contentProfile === 'victoria-campaign' && heroBgMap[slug]) ||
  DEPLOYMENT.assets.hero.replace(DEPLOYMENT.siteUrl, '')

const ogImageUrl =
  page.pageType === 'bio' && page.profileImage
    ? urlFor(page.profileImage).width(1200).height(630).fit('crop').url()
    : DEPLOYMENT.seo.defaultOgImage
---

<BaseLayout
  title={`${page.title} | ${DEPLOYMENT.label}`}
  description={page.metaDescription || page.subtitle}
  image={ogImageUrl}
  imageAlt={page.title}
>
  <Header />

  {
    page.pageType !== 'bio' && (
      <header class="editorial-masthead">
        <div class="editorial-shell">
          <div class="editorial-kicker">{DEPLOYMENT.label}</div>
          <h1 class="editorial-title">{page.title}</h1>
          {currentSubtitle && <p class="editorial-deck">{currentSubtitle}</p>}
        </div>
      </header>
    )
  }

  <main id="main-content" class="site-editorial bg-surface-base py-8 pb-16 surface-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {
        page.pageType === 'bio' ? (
          <BioPage page={page} segments={segments} childGroups={childGroups} />
        ) : (
          <StandardPage page={page} segments={segments} childGroups={childGroups} />
        )
      }
    </div>
  </main>

  <Footer />
</BaseLayout>
