---
import { DEPLOYMENT } from '@/lib/deployment'
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { getDocuments, getBlogPage, urlFor } from '../../lib/sanity'
import '../../styles/global.css'

interface BlogPost {
  _id:string; title:string; slug:{current:string}; excerpt:string; publishedAt:string;
  category:string; featured?:boolean; featuredImage?:any; author?:{name:string;role?:string}; tags?:string[];
}
const allPosts=(await getDocuments<BlogPost>('blogPost'))
  .filter(p=>p.slug?.current)
  .sort((a,b)=>new Date(b.publishedAt).getTime()-new Date(a.publishedAt).getTime())
const selectedCategory = Astro.url.searchParams.get('category')
const posts = selectedCategory ? allPosts.filter(post => post.category === selectedCategory) : allPosts
const pageData=await getBlogPage()
const title=pageData?.title || 'News & Analysis'
const subtitle=pageData?.subtitle || `${DEPLOYMENT.adjective} news, policy explainers and analysis from ${DEPLOYMENT.label}.`
const lead=posts.find(p=>p.featured) || posts[0]
const rest=posts.filter(p=>p._id!==lead?._id)
const secondary=rest.slice(0,3)
const feed=rest.slice(3)
const categories=[...new Set(allPosts.map(p=>p.category).filter(Boolean))]
const labels:Record<string,string>={campaign:'Campaign',policy:'Policy',community:'Community',media:'Media',opinion:'Opinion',event:'Events',news:'News',analysis:'Analysis',explainer:'Explainers'}
const label=(c:string)=>labels[c]||c
const date=(d:string)=>new Date(d).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'})
const image=(p:BlogPost,w=900,h=560)=>p.featuredImage?urlFor(p.featuredImage).width(w).height(h).fit('crop').url():null
---

<BaseLayout title={`${title} | ${DEPLOYMENT.label}`} description={subtitle} image={DEPLOYMENT.contentProfile === 'victoria-campaign' ? '/og/blog.png' : DEPLOYMENT.seo.defaultOgImage} noindex={Boolean(selectedCategory)}>
  <Header />
  <main id="main-content" class="news-page">
    <header class="masthead">
      <div class="shell">
        <div class="masthead-kicker">{DEPLOYMENT.label}</div>
        <div class="masthead-row">
          <div>
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>
          <a class="rss" href="/rss.xml" target="_blank" rel="noopener">RSS ↗</a>
        </div>
        <nav class="topics" aria-label="Article categories">
          <a href="/blog" aria-current={!selectedCategory ? 'page' : undefined}>Latest</a>
          {categories.map(c=><a href={`/blog?category=${encodeURIComponent(c)}`} aria-current={selectedCategory === c ? 'page' : undefined}>{label(c)}</a>)}
        </nav>
      </div>
    </header>

    {lead && <section class="shell lead-grid" id="latest">
      <article class="lead">
        {image(lead) && <a href={`/blog/${lead.slug.current}`} class="lead-image"><img src={image(lead)} alt={lead.featuredImage?.alt||lead.title} width="900" height="560" fetchpriority="high"/></a>}
        <div class="story-meta"><span>{label(lead.category)}</span><time datetime={lead.publishedAt}>{date(lead.publishedAt)}</time></div>
        <h2><a href={`/blog/${lead.slug.current}`}>{lead.title}</a></h2>
        <p>{lead.excerpt}</p>
        <a class="read" href={`/blog/${lead.slug.current}`}>Read the story →</a>
      </article>

      <aside class="secondary" aria-label="More recent stories">
        <div class="section-label">Also new</div>
        {secondary.map(post=><article>
          <div class="story-meta"><span>{label(post.category)}</span><time datetime={post.publishedAt}>{date(post.publishedAt)}</time></div>
          <h3><a href={`/blog/${post.slug.current}`}>{post.title}</a></h3>
          <p>{post.excerpt}</p>
        </article>)}
      </aside>
    </section>}

    <section class="shell archive">
      <div class="archive-head">
        <h2>Latest</h2>
        <span>{posts.length} {posts.length===1?'story':'stories'}</span>
      </div>
      <div class="feed">
        {feed.map(post=><article>
          <div class="feed-copy">
            <div class="story-meta"><span>{label(post.category)}</span><time datetime={post.publishedAt}>{date(post.publishedAt)}</time></div>
            <h3><a href={`/blog/${post.slug.current}`}>{post.title}</a></h3>
            <p>{post.excerpt}</p>
            {post.tags?.length && <div class="tags">{post.tags.slice(0,3).map(t=><span>{t}</span>)}</div>}
          </div>
          {image(post,420,260) && <a href={`/blog/${post.slug.current}`} class="thumb"><img src={image(post,420,260)} alt={post.featuredImage?.alt||post.title} loading="lazy" width="420" height="260"/></a>}
        </article>)}
      </div>
      {posts.length===0 && <div class="empty">No stories published yet.</div>}
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.news-page{background:var(--branch-surface, #100d13);color:var(--branch-ink, #f7f3f8);min-height:100vh}
.shell{max-width:1180px;margin:0 auto;padding-left:1.25rem;padding-right:1.25rem}
.masthead{padding-top:4rem;border-bottom:1px solid var(--branch-line, rgba(255,255,255,.14));background:linear-gradient(180deg,var(--branch-surface-gradient, #160d19) 0%,var(--branch-surface, #100d13) 100%)}
.masthead-kicker{font:800 .75rem/1 'Space Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--branch-secondary, #00ddb8);margin-bottom:1rem}
.masthead-row{display:flex;align-items:end;justify-content:space-between;gap:2rem}
.masthead h1{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(3.6rem,8vw,7rem);line-height:.82;letter-spacing:-.035em;margin:0;color:var(--branch-ink, #fff)}
.masthead p{font-size:1.15rem;color:var(--branch-muted, rgba(255,255,255,.66));max-width:44rem;margin:1.4rem 0 2rem}
.rss{font-weight:800;color:var(--branch-secondary, #00ddb8);text-decoration:none;margin-bottom:2rem;white-space:nowrap}
.topics{display:flex;gap:1.6rem;overflow-x:auto;padding:.95rem 0;border-top:1px solid var(--branch-line, rgba(255,255,255,.08));scrollbar-width:none}
.topics a{color:var(--branch-muted, rgba(255,255,255,.7));font-weight:700;text-decoration:none;white-space:nowrap;font-size:.9rem}.topics a:hover{color:var(--branch-ink, #fff)}.topics a[aria-current="page"]{color:var(--branch-secondary, #00ddb8)}
.lead-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,.85fr);gap:3.5rem;padding-top:3rem;padding-bottom:4rem;border-bottom:1px solid var(--branch-line, rgba(255,255,255,.14))}
.lead-image{display:block;aspect-ratio:16/9;overflow:hidden;margin-bottom:1.4rem;background:var(--branch-panel, #211b24)}.lead-image img,.thumb img{width:100%;height:100%;object-fit:cover;transition:transform .25s}.lead-image:hover img,.thumb:hover img{transform:scale(1.015)}
.story-meta{display:flex;align-items:center;gap:.8rem;font:700 .72rem/1.2 'Space Mono',monospace;text-transform:uppercase;letter-spacing:.06em;color:var(--branch-muted, rgba(255,255,255,.45))}
.story-meta span{color:var(--branch-primary, #d428d4)}.lead h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,5vw,4.5rem);line-height:.94;letter-spacing:-.02em;margin:.8rem 0 1rem}.lead h2 a,.secondary h3 a,.feed h3 a{color:var(--branch-ink, #fff);text-decoration:none}.lead h2 a:hover,.secondary h3 a:hover,.feed h3 a:hover{color:var(--branch-secondary, #00ddb8)}
.lead>p{font-size:1.16rem;line-height:1.55;color:var(--branch-muted, rgba(255,255,255,.7));max-width:48rem}.read{display:inline-block;margin-top:1rem;color:var(--branch-secondary, #00ddb8);font-weight:800;text-decoration:none}
.section-label{font:800 .75rem/1 'Space Mono',monospace;text-transform:uppercase;letter-spacing:.12em;color:var(--branch-secondary, #00ddb8);padding-bottom:1rem;border-bottom:3px solid var(--branch-secondary, #00ddb8)}
.secondary article{padding:1.4rem 0;border-bottom:1px solid var(--branch-line, rgba(255,255,255,.13))}.secondary h3{font-family:'Barlow Condensed',sans-serif;font-size:1.7rem;line-height:1.05;margin:.65rem 0}.secondary p{font-size:.92rem;line-height:1.45;color:var(--branch-muted, rgba(255,255,255,.55));margin:0}
.archive{padding-top:3.5rem;padding-bottom:6rem}.archive-head{display:flex;align-items:end;justify-content:space-between;padding-bottom:1rem;border-bottom:3px solid var(--branch-primary, #d428d4)}.archive-head h2{font-family:'Barlow Condensed',sans-serif;font-size:2.6rem;line-height:1;margin:0}.archive-head span{font:700 .72rem 'Space Mono',monospace;color:var(--branch-muted, rgba(255,255,255,.45));text-transform:uppercase}
.feed article{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:2.5rem;padding:2rem 0;border-bottom:1px solid var(--branch-line, rgba(255,255,255,.12))}.feed h3{font-family:'Barlow Condensed',sans-serif;font-size:2rem;line-height:1.03;margin:.65rem 0}.feed p{color:var(--branch-muted, rgba(255,255,255,.6));line-height:1.5;max-width:44rem;margin:.5rem 0}.thumb{display:block;aspect-ratio:1.62;overflow:hidden;background:var(--branch-panel, #211b24)}.tags{display:flex;gap:.5rem;margin-top:1rem}.tags span{font-size:.7rem;font-weight:700;color:var(--branch-muted, rgba(255,255,255,.45));border:1px solid var(--branch-line, rgba(255,255,255,.14));padding:.25rem .45rem}
.empty{padding:5rem 0;text-align:center;color:var(--branch-muted, rgba(255,255,255,.55))}
@media(max-width:760px){.masthead{padding-top:2.5rem}.masthead-row{align-items:start}.rss{margin-top:.5rem}.lead-grid{grid-template-columns:1fr;gap:2rem;padding-top:1.5rem}.lead h2{font-size:2.8rem}.feed article{grid-template-columns:1fr;gap:1rem}.thumb{grid-row:1}.secondary p{display:none}.archive{padding-top:2.5rem}.topics{gap:1.2rem}}
</style>
