---
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Header } from '@/components/layout/Header';
import { Footer } from '@/components/layout/Footer';
import { BrutalCard, BrutalBadge } from '@/components/ui';
import { getDocuments, getBlogPage } from '../../lib/sanity';
import { urlFor } from '../../lib/sanity';
import '../../styles/global.css';

interface BlogPost {
  _id: string;
  title: string;
  slug: { current: string };
  excerpt: string;
  publishedAt: string;
  category: string;
  featured?: boolean;
  featuredImage?: any;
  author?: {
    name: string;
    role?: string;
  };
  tags?: string[];
}

// Fetch all blog posts, sorted by date
const allPosts = await getDocuments<BlogPost>('blogPost');
const pageData = await getBlogPage();

const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const title = pageData?.title || 'THE FUSION BLOG';
const subtitle = pageData?.subtitle || 'Campaign updates, policy announcements, and stories from the movement to reclaim our democracy.';
const alertBar = pageData?.alertBar || '📰 Stay Updated with Fusion';
const emptyStateText = pageData?.emptyStateText || 'No posts yet! Check back soon for updates from the campaign.';

// Separate featured and regular posts
const featuredPost = sortedPosts.find(post => post.featured);
const regularPosts = sortedPosts.filter(post => post._id !== featuredPost?._id);

// Category color mapping — Reclaim spectrum accents, one per category
const categoryColors: Record<
  string,
  { variant: 'magenta' | 'mint' | 'yellow' | 'lavender'; bg: string; text: string }
> = {
  campaign: { variant: 'magenta', bg: 'bg-magenta', text: 'text-white' },
  policy: { variant: 'mint', bg: 'bg-mint', text: 'text-black' },
  community: { variant: 'yellow', bg: 'bg-yellow', text: 'text-white' },
  media: { variant: 'lavender', bg: 'bg-lavender', text: 'text-white' },
  opinion: { variant: 'yellow', bg: 'bg-yellow', text: 'text-white' },
  event: { variant: 'magenta', bg: 'bg-magenta', text: 'text-white' },
};

function getCategoryColor(category: string) {
  return categoryColors[category] || categoryColors.community;
}

function formatDate(date: string) {
  return new Date(date).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout
  title={`${title} | Reignite Democracy`}
  description={subtitle}
  image="/og/blog.png"
>
  <Header />
  <main id="main-content">

  <div class="alert-bar">
    {alertBar} | <a href="#latest">Read the latest</a>
  </div>

  <!-- Hero Section -->
  <section class="bg-surface-base text-white py-16 md:py-20 px-4 md:px-8 border-b border-magenta/30">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-5xl md:text-7xl font-display font-black mb-6 uppercase text-magenta">
        {title}
      </h1>
      <p class="text-xl md:text-2xl font-bold max-w-3xl mx-auto text-mint">
        {subtitle}
      </p>
    </div>
  </section>

  <!-- Featured Post (if exists) -->
  {featuredPost && (
    <section class="bg-surface-raised py-16 px-4 md:px-8 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <div class="mb-6">
          <BrutalBadge variant="magenta" size="lg">Featured Post</BrutalBadge>
        </div>

        <div class="grid md:grid-cols-12 gap-8">
          <!-- Image column - asymmetric 7 cols -->
          <div class="md:col-span-7">
            {featuredPost.featuredImage && (
              <a href={`/blog/${featuredPost.slug.current}`}>
                <img
                  src={urlFor(featuredPost.featuredImage).width(800).height(500).url()}
                  alt={featuredPost.featuredImage.alt || featuredPost.title}
                  class="w-full h-full object-cover rounded-sm transition-all hover:brightness-90"
                />
              </a>
            )}
          </div>

          <!-- Content column - asymmetric 5 cols -->
          <div class="md:col-span-5 flex flex-col justify-center">
            <div class="mb-4">
              {featuredPost.category && (
                <BrutalBadge variant={getCategoryColor(featuredPost.category).variant}>
                  {featuredPost.category}
                </BrutalBadge>
              )}
            </div>

            <h2 class="text-3xl md:text-4xl font-display font-black mb-4 uppercase leading-tight text-magenta">
              <a href={`/blog/${featuredPost.slug.current}`} class="hover:text-white transition-colors">
                {featuredPost.title}
              </a>
            </h2>

            <p class="text-lg font-semibold mb-6 leading-relaxed text-white/70">
              {featuredPost.excerpt}
            </p>

            <div class="flex items-center gap-4 mb-6 text-sm font-bold text-white/50">
              {featuredPost.author?.name && (
                <span>By {featuredPost.author.name}</span>
              )}
              <span>•</span>
              <time>{formatDate(featuredPost.publishedAt)}</time>
            </div>

            <a
              href={`/blog/${featuredPost.slug.current}`}
              class="btn btn-primary w-fit"
            >
              Read Full Story →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Latest Posts Grid -->
  <section id="latest" class="bg-surface-base py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-display font-black mb-12 uppercase text-white">
        Latest Posts
      </h2>

      <!-- Asymmetric Blog Grid -->
      <div class="grid grid-cols-12 gap-6">
        {regularPosts.map((post, index) => {
          const colors = getCategoryColor(post.category);
          const imageUrl = post.featuredImage ? urlFor(post.featuredImage).width(600).height(400).url() : null;

          // Asymmetric column spanning
          const colSpan = index % 3 === 0 ? 'col-span-12 md:col-span-7' :
                         index % 3 === 1 ? 'col-span-12 md:col-span-5' :
                         'col-span-12 md:col-span-12';

          return (
            <article class={`${colSpan}`}>
              <BrutalCard variant="surface" shadow={colors.variant} padding="sm" class="h-full !p-0 overflow-hidden flex flex-col">
                {imageUrl && (
                  <a href={`/blog/${post.slug.current}`}>
                    <img
                      src={imageUrl}
                      alt={post.featuredImage?.alt || post.title}
                      class="w-full h-48 object-cover"
                    />
                  </a>
                )}

                <div class="p-6 flex flex-col flex-1">
                  <div class="mb-3">
                    {post.category && <BrutalBadge variant={colors.variant}>{post.category}</BrutalBadge>}
                  </div>

                  <h3 class="text-2xl font-display font-black mb-3 uppercase leading-tight text-white">
                    <a href={`/blog/${post.slug.current}`} class="hover:text-magenta transition-colors">
                      {post.title}
                    </a>
                  </h3>

                  <p class="font-semibold mb-4 leading-relaxed text-white/60 flex-1">
                    {post.excerpt}
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-white/10 text-sm font-bold text-white/50">
                    <div class="flex items-center gap-2">
                      {post.author?.name && (
                        <span>{post.author.name}</span>
                      )}
                    </div>
                    <time>{formatDate(post.publishedAt)}</time>
                  </div>
                </div>
              </BrutalCard>
            </article>
          );
        })}
      </div>

      {regularPosts.length === 0 && !featuredPost && (
        <div class="text-center py-20">
          <div class="brutal-card brutal-card-yellow inline-block px-12 py-8">
            <p class="text-2xl font-display font-black uppercase mb-4">No posts yet!</p>
            <p class="font-bold">{emptyStateText}</p>
          </div>
        </div>
      )}
    </div>
  </section>

  </main>
  <Footer />
</BaseLayout>
