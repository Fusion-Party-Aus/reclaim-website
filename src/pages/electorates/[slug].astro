---
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Hero } from '@/components/layout/Hero'
import { BrutalCard, BrutalButton, BrutalBadge } from '@/components/ui'
import { getDocumentBySlug, urlFor } from '../../lib/sanity'
import { renderPortableText } from '../../lib/portableText'
import type { PortableTextBlock } from '../../lib/portableText'
import '../../styles/global.css'

interface CommitmentDetail {
  detail: string
}

interface Commitment {
  icon: string
  title: string
  highlight: string
  details?: CommitmentDetail[]
}

interface HTVCandidate {
  candidateName: string
  candidateParty: string
  candidateTier: 'green' | 'orange' | 'red' | 'magenta'
  ballotOrder?: number
  suggestedVote?: number
}

interface Electorate {
  _id: string
  name: string
  slug: { current: string }
  subtitle?: string
  isArchived?: boolean
  electionGrouping?: string
  house?: 'lower' | 'upper'
  candidateName?: string
  candidateImage?: unknown
  candidateBio?: string
  commitments?: Commitment[]
  htv?: HTVCandidate[]
  body?: PortableTextBlock[]
}

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const electorate = await getDocumentBySlug<Electorate>('electorate', slug)

if (!electorate) {
  return Astro.redirect('/404')
}

// HTV Sorting
const hasHTV = Array.isArray(electorate.htv) && electorate.htv.length > 0
const htvArray = electorate.htv || []
const sortedHTV = hasHTV
  ? [...htvArray].sort((a, b) => {
      if (a.ballotOrder && b.ballotOrder) return a.ballotOrder - b.ballotOrder
      if (a.ballotOrder) return -1
      if (b.ballotOrder) return 1
      return a.candidateName.localeCompare(b.candidateName)
    })
  : []

// Design-system-aligned tier colours — dark surface tints, no light backgrounds
const tierConfig: Record<
  'magenta' | 'green' | 'orange' | 'red',
  {
    borderTop: string
    borderLeft: string
    bg: string
    badgeBg: string
    badgeText: string
    label: string
  }
> = {
  magenta: {
    borderTop: 'border-t-magenta',
    borderLeft: 'border-l-magenta',
    bg: 'bg-magenta/10',
    badgeBg: 'bg-magenta',
    badgeText: 'text-white',
    label: 'Vote 1',
  },
  green: {
    borderTop: 'border-t-mint',
    borderLeft: 'border-l-mint',
    bg: 'bg-mint/10',
    badgeBg: 'bg-mint',
    badgeText: 'text-black',
    label: 'Vote High',
  },
  orange: {
    borderTop: 'border-t-yellow',
    borderLeft: 'border-l-yellow',
    bg: 'bg-yellow/10',
    badgeBg: 'bg-yellow',
    badgeText: 'text-white',
    label: 'Middle',
  },
  red: {
    borderTop: 'border-t-red',
    borderLeft: 'border-l-red',
    bg: 'bg-red/10',
    badgeBg: 'bg-red',
    badgeText: 'text-white',
    label: 'Vote Last',
  },
}
---

<BaseLayout title={`${electorate.name} | Reignite Democracy`}>
  <Header />

  <Hero
    title={electorate.name}
    subtitle={electorate.subtitle || 'Decades of neglect. A concrete plan to fix it.'}
  />

  <main class="bg-surface-base pb-24">
    <div class="max-w-6xl mx-auto px-4 md:px-8 pt-10">
      {/* ── Breadcrumbs ── */}
      <nav
        class="flex items-center flex-wrap gap-1 mb-10 text-xs font-black uppercase tracking-widest"
      >
        <a
          href="/"
          class="px-3 py-1.5 rounded-sm bg-yellow text-white hover:bg-mint hover:text-black transition-colors"
          >Home</a
        >
        <span class="text-white/30">›</span>
        <a
          href="/electorates"
          class="px-3 py-1.5 rounded-sm bg-white/10 text-white hover:bg-mint hover:text-black transition-colors"
          >Electorates</a
        >
        {
          electorate.isArchived && (
            <>
              <span class="text-white/30">›</span>
              <a
                href="/past-candidates"
                class="px-3 py-1.5 rounded-sm bg-white/10 text-magenta hover:bg-magenta hover:text-white transition-all"
              >
                Past Candidates
              </a>
            </>
          )
        }
        <span class="text-white/30">›</span>
        <span class="px-3 py-1.5 rounded-sm bg-black/30 text-white max-w-xs truncate"
          >{electorate.name}</span
        >
      </nav>

      {/* ── Candidate + body ── */}
      <section class="mb-16 grid grid-cols-1 md:grid-cols-[2fr_1.2fr] gap-8 items-start">
        {/* Body / what we're fighting for */}
        <BrutalCard variant="surface" shadow="mint" padding="lg">
          <BrutalBadge variant="mint" class="mb-4">What We're Fighting For</BrutalBadge>
          <h2 class="text-2xl md:text-3xl font-display font-black uppercase mb-4 leading-tight">
            Our Plan for {electorate.name}
          </h2>
          {
            electorate.body ? (
              <div
                class="prose prose-lg max-w-none
                prose-headings:font-black prose-headings:uppercase
                prose-h2:border-l-4 prose-h2:border-magenta prose-h2:pl-4
                prose-a:text-magenta prose-a:font-black
                prose-strong:font-black"
                set:html={renderPortableText(electorate.body)}
              />
            ) : (
              <p class="text-base font-bold text-white/60">
                This electorate has a candidate and commitments — full detail coming soon.
              </p>
            )
          }
        </BrutalCard>

        {/* Candidate sidebar */}
        <BrutalCard variant="black" shadow="magenta" padding="md" class="!p-0 overflow-hidden">
          {
            electorate.candidateImage && (
              <div class="overflow-hidden">
                <img
                  src={urlFor(electorate.candidateImage as Parameters<typeof urlFor>[0])
                    .width(600)
                    .height(600)
                    .fit('crop')
                    .url()}
                  alt={electorate.candidateName || 'Candidate'}
                  class="w-full h-auto grayscale hover:grayscale-0 transition-all duration-500"
                />
              </div>
            )
          }

          <div class="p-6">
            <BrutalBadge variant="magenta" class="mb-4">Candidate</BrutalBadge>

            {
              electorate.candidateName ? (
                <>
                  <h2 class="text-xl font-display font-black uppercase leading-tight mb-2">
                    {electorate.candidateName}
                  </h2>
                  {electorate.candidateBio && (
                    <p class="text-sm leading-relaxed text-white/75 border-l-4 border-mint pl-3">
                      {electorate.candidateBio}
                    </p>
                  )}
                </>
              ) : (
                <div>
                  <p class="text-base font-black uppercase text-white/60 mb-3">Candidate TBA</p>
                  <p class="text-sm text-white/50 leading-relaxed">
                    From {electorate.name}? Interested in running?{' '}
                    <a
                      href="mailto:preselection@fusionparty.org.au"
                      class="text-mint font-black underline hover:no-underline"
                    >
                      preselection@fusionparty.org.au
                    </a>
                  </p>
                </div>
              )
            }
          </div>
        </BrutalCard>
      </section>

      {/* ── How To Vote ── */}
      {
        hasHTV && (
          <section class="mb-16">
            {/* Section header */}
            <div class="mb-8">
              <BrutalBadge variant="black" class="mb-3">
                How to Vote
              </BrutalBadge>
              <h2 class="text-3xl md:text-4xl font-display font-black uppercase leading-tight">
                <span class="text-magenta">Ballot</span> Guide
              </h2>
            </div>

            {/* Legend */}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
              {(
                Object.entries(tierConfig) as [
                  keyof typeof tierConfig,
                  (typeof tierConfig)[keyof typeof tierConfig],
                ][]
              ).map(([tier, cfg]) => (
                <div
                  class={`rounded-sm border border-white/10 border-t-2 p-4 ${cfg.bg} ${cfg.borderTop}`}
                >
                  <div
                    class={`inline-block px-2 py-0.5 text-xs font-black uppercase mb-2 rounded-sm ${cfg.badgeBg} ${cfg.badgeText}`}
                  >
                    {cfg.label}
                  </div>
                  <p class="text-xs font-bold text-white/70 leading-snug">
                    {tier === 'magenta' && 'Your Reignite Democracy candidate. Number them 1.'}
                    {tier === 'green' && 'Close allies sharing core values.'}
                    {tier === 'orange' && 'Some overlap, but meaningful differences.'}
                    {tier === 'red' && 'Major clashes with our principles. Vote last.'}
                  </p>
                </div>
              ))}
            </div>

            {/* Ticket */}
            <BrutalCard variant="surface" shadow="black" padding="lg">
              <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                <div>
                  <span class="inline-block bg-black/30 text-white px-4 py-2 font-display font-black uppercase tracking-wider text-sm rounded-sm">
                    Ballot Paper — {electorate.name}
                  </span>
                  <p class="mt-2 font-black uppercase text-xs text-magenta">
                    Number every box on your ballot paper.
                  </p>
                </div>

                {sortedHTV.some((c) => c.suggestedVote) && (
                  <label class="flex items-center gap-3 cursor-pointer bg-white/10 rounded-sm px-4 py-2 hover:bg-white/20 transition-colors">
                    <span class="font-black uppercase text-xs">Show Preferences</span>
                    <div class="relative">
                      <input type="checkbox" id="toggle-preferences" class="sr-only" />
                      <div class="block bg-white/20 w-10 h-5 rounded-full htv-toggle-bg transition-colors" />
                      <div class="dot absolute left-0.5 top-0.5 bg-magenta w-4 h-4 rounded-full transition-transform htv-toggle-dot" />
                    </div>
                  </label>
                )}
              </div>

              {electorate.house === 'upper' ? (
                <div class="flex flex-wrap gap-4 justify-center">
                  {sortedHTV.map((candidate) => {
                    const cfg = tierConfig[candidate.candidateTier]
                    return (
                      <div
                        class={`flex-none w-36 md:w-44 flex flex-col items-center gap-3 p-4 rounded-sm border border-white/10 border-t-2 text-center hover:-translate-y-0.5 transition-transform ${cfg.bg} ${cfg.borderTop}`}
                      >
                        <div class="w-14 h-14 rounded-sm bg-black/20 flex items-center justify-center font-black text-2xl">
                          {candidate.candidateTier === 'magenta' ? (
                            '1'
                          ) : (
                            <span class="suggested-vote hidden text-lg">
                              {candidate.suggestedVote || ''}
                            </span>
                          )}
                        </div>
                        <div class="h-1 w-full bg-white/10" />
                        <p
                          class={`font-black text-sm uppercase leading-tight ${candidate.candidateTier === 'red' ? 'line-through opacity-50' : ''}`}
                        >
                          {candidate.candidateParty}
                        </p>
                        <span
                          class={`px-2 py-0.5 text-xs font-black uppercase rounded-sm ${cfg.badgeBg} ${cfg.badgeText}`}
                        >
                          {cfg.label}
                        </span>
                      </div>
                    )
                  })}
                </div>
              ) : (
                <div class="space-y-3 max-w-2xl mx-auto">
                  {sortedHTV.map((candidate) => {
                    const cfg = tierConfig[candidate.candidateTier]
                    return (
                      <div
                        class={`flex items-center gap-4 p-4 rounded-sm border border-white/10 border-l-2 hover:-translate-x-0.5 transition-transform ${cfg.bg} ${cfg.borderLeft}`}
                      >
                        <div class="w-12 h-12 rounded-sm bg-black/20 flex items-center justify-center shrink-0 font-black text-xl">
                          {candidate.candidateTier === 'magenta' ? (
                            '1'
                          ) : (
                            <span class="suggested-vote hidden">
                              {candidate.suggestedVote || ''}
                            </span>
                          )}
                        </div>
                        <div class="flex-1 min-w-0">
                          <p
                            class={`font-black text-base md:text-lg uppercase leading-tight ${candidate.candidateTier === 'red' ? 'line-through opacity-50' : ''}`}
                          >
                            {candidate.candidateName}
                          </p>
                          <p
                            class={`font-bold text-xs uppercase mt-0.5 ${candidate.candidateTier === 'red' ? 'line-through opacity-40' : 'opacity-70'}`}
                          >
                            {candidate.candidateParty}
                          </p>
                        </div>
                        <span
                          class={`px-3 py-1 text-xs font-black uppercase shrink-0 rounded-sm ${cfg.badgeBg} ${cfg.badgeText}`}
                        >
                          {cfg.label}
                        </span>
                      </div>
                    )
                  })}
                </div>
              )}
            </BrutalCard>
          </section>
        )
      }

      {/* ── Commitments ── */}
      {
        Array.isArray(electorate.commitments) && electorate.commitments.length > 0 && (
          <section class="mb-16">
            <div class="mb-8">
              <BrutalBadge variant="magenta" class="mb-3">
                Our Commitments
              </BrutalBadge>
              <h2 class="text-3xl md:text-4xl font-display font-black uppercase leading-tight">
                What We'll Do for
                <>
                  <br />
                  <span class="text-magenta">{electorate.name}</span>
                </>
              </h2>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              {electorate.commitments.map((commitment, index) => {
                const accents = ['mint', 'yellow', 'magenta'] as const
                const accent = accents[index % accents.length]
                return (
                  <BrutalCard variant="surface" shadow={accent} padding="md">
                    <div class="flex items-start gap-4 mb-3">
                      <span
                        class="text-3xl shrink-0 rounded-sm p-2 bg-white/10"
                        role="img"
                        aria-label="commitment icon"
                      >
                        {commitment.icon}
                      </span>
                      <div>
                        <h3 class="text-lg font-display font-black uppercase mb-1">
                          {commitment.title}
                        </h3>
                        <p class="font-bold text-sm text-white/70">{commitment.highlight}</p>
                      </div>
                    </div>
                    {commitment.details && commitment.details.length > 0 && (
                      <ul class="mt-3 space-y-1 border-t border-white/10 pt-3">
                        {commitment.details.map((item) => (
                          <li class="flex items-start gap-2 text-sm text-white/60 font-semibold">
                            <span class="font-black text-white shrink-0">→</span>
                            {item.detail}
                          </li>
                        ))}
                      </ul>
                    )}
                  </BrutalCard>
                )
              })}
            </div>
          </section>
        )
      }

      {/* ── CTA ── */}
      <BrutalCard variant="black" shadow="mint" padding="lg" class="mt-4">
        <BrutalBadge variant="magenta" class="mb-4">Help Us Win</BrutalBadge>
        <h2 class="text-3xl md:text-4xl font-display font-black uppercase mb-3 leading-tight">
          Help Us Win<br /><span class="text-mint">{electorate.name}</span>
        </h2>
        <p class="text-base font-black text-white/65 mb-8 border-l-4 border-yellow pl-4 max-w-lg">
          We don't take developer or corporate money. We win by people power — volunteers,
          conversations, and small donations.
        </p>
        <div class="flex flex-wrap gap-3">
          <BrutalButton variant="magenta" href="/get-involved" icon="mdi:hand-wave">
            Volunteer
          </BrutalButton>
          <BrutalButton variant="black" href="/policies"> See the Policies </BrutalButton>
        </div>
      </BrutalCard>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const toggle = document.getElementById('toggle-preferences') as HTMLInputElement | null
  const votes = document.querySelectorAll('.suggested-vote')
  const bg = document.querySelector('.htv-toggle-bg')
  const dot = document.querySelector('.htv-toggle-dot')

  if (toggle) {
    toggle.addEventListener('change', (e) => {
      const isChecked = (e.target as HTMLInputElement).checked

      votes.forEach((v) => {
        if (isChecked) {
          v.classList.remove('hidden')
        } else {
          v.classList.add('hidden')
        }
      })

      if (bg && dot) {
        if (isChecked) {
          bg.classList.replace('bg-white/20', 'bg-magenta')
          dot.classList.replace('bg-magenta', 'bg-white')
          dot.classList.add('translate-x-5')
        } else {
          bg.classList.replace('bg-magenta', 'bg-white/20')
          dot.classList.replace('bg-white', 'bg-magenta')
          dot.classList.remove('translate-x-5')
        }
      }
    })
  }
</script>
