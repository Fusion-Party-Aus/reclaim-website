---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { BrutalCard, BrutalButton } from '@/components/ui'
import '../styles/global.css'

const forbiddenMessages = [
  "Access Denied (but democracy shouldn't be)",
  'This area is exclusive... unlike our party!',
  'Members only zone (consider joining?)',
  'You shall not pass! ...without proper authorization',
  'Forbidden. Like corruption should be.',
  'Sorry, this page is VIP only (Very Important Politics)',
]

const randomMessage = forbiddenMessages[Math.floor(Math.random() * forbiddenMessages.length)]
---

<BaseLayout
  title="403 - Access Denied | Fusion Party Victoria"
  description="You don't have permission to access this page."
  noindex={true}
>
  <Header />

  <main id="main-content" class="min-h-screen bg-black relative overflow-hidden pt-28 pb-20">
    <!-- Warning signs floating -->
    <div class="absolute inset-0 opacity-15">
      {
        [...Array(6)].map((_, i) => (
          <div
            class="absolute text-8xl"
            style={`
            top: ${Math.random() * 80 + 10}%;
            left: ${Math.random() * 90}%;
            animation: float ${5 + i}s ease-in-out infinite ${i * 0.5}s, spin ${20 + i * 4}s linear infinite;
          `}
          >
            {['🚫', '⛔', '🔒', '⚠️', '🛡️', '🔐'][i]}
          </div>
        ))
      }
    </div>

    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <!-- Giant 403 with Lock -->
      <div class="text-center mb-12">
        <div class="relative inline-block mb-8">
          <div class="absolute inset-0 bg-magenta blur-3xl opacity-40 animate-pulse"></div>
          <div
            class="relative w-48 h-48 mx-auto bg-grey-dark border border-magenta rounded-full flex items-center justify-center"
            style="box-shadow: 0 0 60px #D428D4; animation: pulse 2s ease-in-out infinite;"
          >
            <Icon
              name="mdi:lock"
              class="w-32 h-32 text-magenta"
              style="animation: wiggle 3s ease-in-out infinite;"
            />
          </div>
        </div>

        <h1
          class="text-[10rem] md:text-[16rem] font-black uppercase leading-none mb-0 text-white font-display"
        >
          403
        </h1>

        <h2 class="text-4xl md:text-6xl font-black uppercase text-yellow mb-6 font-display">
          ACCESS DENIED
        </h2>

        <p class="text-2xl font-bold text-white">
          {randomMessage}
        </p>
      </div>

      <!-- Warning Card -->
      <div class="max-w-3xl mx-auto mb-12">
        <BrutalCard variant="surface" shadow="yellow" padding="lg" class="relative">
          <div class="flex items-start gap-6">
            <div
              class="w-24 h-24 bg-magenta/10 border border-magenta rounded-sm flex items-center justify-center flex-shrink-0"
              style="animation: bounce 2s ease-in-out infinite;"
            >
              <Icon name="mdi:shield-lock" class="w-16 h-16 text-magenta" />
            </div>
            <div>
              <h3 class="text-3xl font-black uppercase mb-4 font-display">Restricted Area</h3>
              <p class="text-lg font-bold text-white/80 leading-relaxed mb-4">
                This page is protected and requires special permissions to access.
              </p>
              <div class="bg-black/40 border border-white/10 rounded-sm p-4">
                <p class="text-white font-bold text-sm">
                  <Icon name="mdi:information" class="w-5 h-5 inline mr-2 text-yellow" />
                  If you believe you should have access, please contact us or sign in.
                </p>
              </div>
            </div>
          </div>
        </BrutalCard>
      </div>

      <!-- Why Join / Action Cards -->
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-12">
        <BrutalCard variant="surface" shadow="magenta" padding="lg">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-16 h-16 bg-magenta/10 border border-magenta rounded-sm flex items-center justify-center"
            >
              <Icon name="mdi:account-key" class="w-10 h-10 text-magenta" />
            </div>
            <h3 class="text-2xl font-black uppercase text-magenta font-display">Need Access?</h3>
          </div>
          <p class="text-white/80 font-bold mb-6">
            Some content is reserved for Reignite Democracy members. Join us to unlock exclusive
            resources!
          </p>
          <BrutalButton href="/get-involved" variant="primary" fullWidth icon="mdi:account-plus">
            Join Fusion
          </BrutalButton>
        </BrutalCard>

        <BrutalCard variant="surface" shadow="mint" padding="lg">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-16 h-16 bg-mint/10 border border-mint rounded-sm flex items-center justify-center"
            >
              <Icon name="mdi:login" class="w-10 h-10 text-mint" />
            </div>
            <h3 class="text-2xl font-black uppercase font-display">Already a Member?</h3>
          </div>
          <p class="text-white/80 font-bold mb-6">
            Sign in to access member-exclusive content and resources.
          </p>
          <BrutalButton href="/login" variant="secondary" fullWidth icon="mdi:lock-open">
            Sign In
          </BrutalButton>
        </BrutalCard>
      </div>

      <!-- What You're Missing -->
      <div class="max-w-4xl mx-auto mb-12">
        <h3 class="text-3xl font-black uppercase text-center text-white mb-8 font-display">
          Member Benefits:
        </h3>
        <div class="grid md:grid-cols-3 gap-4">
          <BrutalCard variant="surface" shadow="magenta" padding="md" class="text-center">
            <Icon name="mdi:file-document-multiple" class="w-12 h-12 mx-auto mb-3 text-magenta" />
            <h4 class="font-black uppercase text-sm mb-2 font-display">Exclusive Content</h4>
            <p class="text-xs font-bold text-white/50">Policy drafts & research</p>
          </BrutalCard>
          <BrutalCard variant="surface" shadow="yellow" padding="md" class="text-center">
            <Icon name="mdi:calendar-star" class="w-12 h-12 mx-auto mb-3 text-yellow" />
            <h4 class="font-black uppercase text-sm mb-2 font-display">Events</h4>
            <p class="text-xs font-bold text-white/50">Early access to events</p>
          </BrutalCard>
          <BrutalCard variant="surface" shadow="white" padding="md" class="text-center">
            <Icon name="mdi:vote" class="w-12 h-12 mx-auto mb-3 text-white" />
            <h4 class="font-black uppercase text-sm mb-2 font-display">Voting Rights</h4>
            <p class="text-xs font-bold text-white/50">Shape party policy</p>
          </BrutalCard>
        </div>
      </div>

      <!-- Go Back -->
      <div class="text-center">
        <BrutalCard variant="surface" shadow="magenta" padding="md" class="inline-block">
          <p class="text-white font-bold mb-4">Or just head back to public content:</p>
          <div class="flex flex-wrap gap-3 justify-center">
            <BrutalButton href="/" variant="primary" icon="mdi:home">Home</BrutalButton>
            <BrutalButton href="/policies" variant="secondary" icon="mdi:file-document">
              Policies
            </BrutalButton>
            <button
              onclick="window.history.back()"
              class="inline-flex items-center justify-center gap-2 font-black uppercase tracking-wide rounded-sm transition-all duration-200 hover:scale-[1.02] px-6 py-3 text-base bg-black text-white border border-white/20 hover:bg-white/10 font-display"
            >
              <Icon name="mdi:arrow-left" class="w-5 h-5" />
              Go Back
            </button>
          </div>
        </BrutalCard>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }
</style>
