---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { BrutalCard, BrutalButton, BrutalBadge } from '@/components/ui'
import '../styles/global.css'

// Get search query from URL
const url = new URL(Astro.request.url)
const searchQuery = url.searchParams.get('q') || ''

const noResultsMessages = [
  "We couldn't find that, but we found our sense of humor!",
  'Zero results. Unlike our commitment to democracy.',
  'Nothing here... yet. Try something else!',
  "Search came up empty, but our policy platform sure doesn't!",
  "404 results found. Wait, that's not how this works.",
]

const randomMessage = noResultsMessages[Math.floor(Math.random() * noResultsMessages.length)]

// Suggested searches
const suggestions = [
  { text: 'Climate Policy', href: '/policies/climate' },
  { text: 'Housing Crisis', href: '/policies/housing' },
  { text: 'Healthcare', href: '/policies/healthcare' },
  { text: 'Education', href: '/policies/education' },
]
---

<BaseLayout
  title={`No Results for "${searchQuery}" | Reignite Democracy`}
  description="We couldn't find what you're looking for, but here are some suggestions."
>
  <Header />

  <main class="min-h-screen bg-black pt-28 pb-20">
    <div class="max-w-6xl mx-auto px-4">
      <!-- Search Icon -->
      <div class="text-center mb-12">
        <div class="inline-block relative mb-8">
          <div
            class="w-48 h-48 mx-auto bg-grey-dark border border-magenta rounded-full flex items-center justify-center transform -rotate-6"
            style="box-shadow: 0 0 50px rgba(212, 40, 212, 0.3);"
          >
            <Icon name="mdi:magnify" class="w-32 h-32 text-magenta" />
            <div
              class="absolute top-12 right-12 text-6xl"
              style="animation: wiggle 2s ease-in-out infinite;"
            >
              ❌
            </div>
          </div>
        </div>

        <h1 class="text-5xl md:text-7xl font-black uppercase mb-6 text-magenta font-display">
          NO RESULTS FOUND
        </h1>

        {
          searchQuery && (
            <div class="mb-6">
              <p class="text-xl font-bold text-white/60 mb-3">You searched for:</p>
              <div class="inline-block transform rotate-2">
                <BrutalBadge variant="yellow" size="lg">
                  "{searchQuery}"
                </BrutalBadge>
              </div>
            </div>
          )
        }

        <p class="text-2xl font-bold text-white/70 max-w-2xl mx-auto">
          {randomMessage}
        </p>
      </div>

      <!-- Try Another Search -->
      <div class="max-w-2xl mx-auto mb-16">
        <BrutalCard variant="surface" shadow="magenta" padding="lg" class="transform -rotate-1">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-12 h-12 bg-mint/10 border border-mint rounded-sm flex items-center justify-center"
            >
              <Icon name="mdi:magnify-plus-outline" class="w-8 h-8 text-mint" />
            </div>
            <h2 class="text-2xl font-black uppercase font-display">Try Another Search</h2>
          </div>

          <form action="/search" method="get" class="flex gap-3">
            <input
              type="text"
              name="q"
              value={searchQuery}
              placeholder="What are you looking for?"
              class="flex-1 px-4 py-4 border border-white/15 rounded-sm bg-black/30 text-white font-bold text-lg focus:outline-none focus:border-magenta transition-all"
            />
            <button
              type="submit"
              class="px-8 py-4 bg-magenta border border-white/10 rounded-sm text-white font-black uppercase hover:bg-magenta-bright transition-all"
            >
              <Icon name="mdi:magnify" class="w-6 h-6" />
            </button>
          </form>

          <div class="mt-6 pt-6 border-t border-white/10">
            <p class="text-sm font-bold text-white/50 mb-3 uppercase">Search Tips:</p>
            <ul class="space-y-2 text-sm font-bold text-white/60">
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-circle" class="w-5 h-5 text-mint flex-shrink-0 mt-0.5" />
                <span>Try different keywords or phrases</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-circle" class="w-5 h-5 text-mint flex-shrink-0 mt-0.5" />
                <span>Check your spelling</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-circle" class="w-5 h-5 text-mint flex-shrink-0 mt-0.5" />
                <span>Use more general terms</span>
              </li>
            </ul>
          </div>
        </BrutalCard>
      </div>

      <!-- Popular Searches / Suggestions -->
      <div class="mb-16">
        <h3 class="text-3xl font-black uppercase text-center mb-8 font-display">
          Popular Searches:
        </h3>

        <div class="flex flex-wrap justify-center gap-4 mb-8">
          {
            suggestions.map((item, i) => (
              <a
                href={item.href}
                class="px-6 py-3 border border-white/15 rounded-sm font-black uppercase hover:translate-x-1 hover:translate-y-1 transition-all"
                style={`
                background: ${['#D428D4', '#00DDB8', '#4A7AEB', '#7B3FE4'][i % 4]};
                color: #fff;
                ${i % 2 === 0 ? 'transform: rotate(2deg);' : 'transform: rotate(-2deg);'}
              `}
              >
                {item.text}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Browse by Category -->
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-16">
        <a
          href="/policies"
          class="block bg-magenta rounded-sm border border-white/10 p-8 text-center group transition-all hover:-translate-y-2"
        >
          <div
            class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-white/10 border border-white/20 rounded-full group-hover:rotate-180 transition-transform duration-500"
          >
            <Icon name="mdi:file-document-multiple" class="w-12 h-12 text-white" />
          </div>
          <h3 class="text-2xl font-black uppercase mb-2 text-white font-display">All Policies</h3>
          <p class="text-sm font-bold text-white opacity-90">Browse our full policy platform</p>
        </a>

        <a
          href="/blog"
          class="block bg-mint rounded-sm border border-white/10 p-8 text-center group transition-all hover:-translate-y-2"
        >
          <div
            class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-black/10 border border-black/20 rounded-full group-hover:rotate-180 transition-transform duration-500"
          >
            <Icon name="mdi:newspaper-variant" class="w-12 h-12 text-black" />
          </div>
          <h3 class="text-2xl font-black uppercase mb-2 text-black font-display">Latest News</h3>
          <p class="text-sm font-bold text-black opacity-90">Check out recent updates</p>
        </a>

        <a
          href="/faq"
          class="block bg-yellow rounded-sm border border-white/10 p-8 text-center group transition-all hover:-translate-y-2"
        >
          <div
            class="w-20 h-20 mb-4 mx-auto flex items-center justify-center bg-white/10 border border-white/20 rounded-full group-hover:rotate-180 transition-transform duration-500"
          >
            <Icon name="mdi:frequently-asked-questions" class="w-12 h-12 text-white" />
          </div>
          <h3 class="text-2xl font-black uppercase mb-2 text-white font-display">FAQ</h3>
          <p class="text-sm font-bold text-white opacity-90">Get your questions answered</p>
        </a>
      </div>

      <!-- Still Can't Find It -->
      <div class="max-w-2xl mx-auto text-center">
        <BrutalCard variant="surface" shadow="yellow" padding="lg" class="transform rotate-1">
          <div
            class="w-16 h-16 bg-magenta/10 border border-magenta rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <Icon name="mdi:help-circle" class="w-10 h-10 text-magenta" />
          </div>
          <h3 class="text-2xl font-black uppercase mb-4 font-display">Still Can't Find It?</h3>
          <p class="text-lg font-bold text-white/70 mb-6">
            Reach out to us! We're here to help and would love to hear from you.
          </p>
          <BrutalButton href="/contact" variant="primary" icon="mdi:email">
            Contact Us
          </BrutalButton>
        </BrutalCard>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-10deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }
</style>
