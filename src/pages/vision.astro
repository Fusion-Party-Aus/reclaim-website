---
export const prerender = false
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import type { Policy } from '../types/sanity'
import { getPolicies, getVisionPage } from '../lib/sanity'
import '../styles/global.css'
import '../styles/platform-pages.css'

const policies = await getPolicies({ thisTerm: false })
const visionPage = await getVisionPage()
const groups = new Map<string, Map<string, Policy[]>>()
for (const policy of policies) {
  const pillar = policy.pillar || 'Other policies'
  const category = policy.category || 'General'
  if (!groups.has(pillar)) groups.set(pillar, new Map())
  const categories = groups.get(pillar)!
  if (!categories.has(category)) categories.set(category, [])
  categories.get(category)!.push(policy)
}
const narratives: Record<string, { heading: string; body: string }> = {
  'RECLAIM OUR INFRASTRUCTURE': {
    heading: 'Room to live. Ways to move.',
    body: 'More homes near the places people need to reach. A transport network that works across operators and suburbs. Public land and investment used for lasting public benefit.',
  },
  'RECLAIM OUR DEMOCRACY': {
    heading: 'Power within reach.',
    body: 'A government people can see into, question and help shape. Public decisions should be open to scrutiny between elections, not just at the ballot box.',
  },
  'RECLAIM OUR ECONOMY': {
    heading: 'Value that stays here.',
    body: 'When public decisions create wealth, the public should share in it. That means testing the deals, keeping useful assets and reinvesting the returns.',
  },
}
---

<BaseLayout
  title={visionPage?.seo?.metaTitle || 'Our Vision | Fusion Party Victoria'}
  description={visionPage?.seo?.metaDescription ||
    'Explore Fusion Victoria’s longer-term direction and the policies behind it.'}
>
  <Header />
  <main id="main-content" class="reclaim-platform reclaim-vision">
    <div class="platform-spectrum" aria-hidden="true"></div>
    <header class="platform-header platform-container">
      <p class="platform-eyebrow">Fusion Party Victoria</p><h1>Our vision</h1><p
        class="platform-intro"
      >
        A Victoria with more room to live, a real say in decisions and a public return on what we
        build together.
      </p><div class="platform-header__links">
        <a class="platform-primary-link" href="#direction">Explore the direction ↓</a><a
          class="platform-secondary-link"
          href="/policies">See all policies ↗</a>
      </div>
    </header>
    <section class="platform-frame" aria-labelledby="vision-frame-title">
      <div class="platform-container platform-frame__grid">
        <div>
          <p class="platform-eyebrow">The principle</p><h2 id="vision-frame-title">
            Set the floor.<br /><span>Open the future.</span>
          </h2>
        </div><div>
          <p>
            Protect the commons. Regulate harm. Give people the foundation to choose their own
            lives, then get out of their way.
          </p><p>
            This page draws out the longer-term direction behind the platform. Each linked proposal
            has its own case, evidence and qualifications.
          </p>
        </div>
      </div>
    </section>
    <section
      id="direction"
      class="vision-direction platform-container"
      aria-labelledby="direction-title"
    >
      <p class="platform-eyebrow">The direction</p><h2 id="direction-title">
        What changes in practice
      </h2><div class="vision-direction__nav">
        {
          [...groups.keys()].map((pillar) => (
            <a href={`#vision-${pillar.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{pillar}</a>
          ))
        }
      </div>
    </section>
    {
      [...groups].map(([pillar, categories]) => {
        const narrative = narratives[pillar] || {
          heading: pillar,
          body: 'Explore this part of the longer-term platform.',
        }
        const anchor = `vision-${pillar.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
        return (
          <section class="vision-theme" id={anchor} aria-labelledby={`${anchor}-title`}>
            <div class="platform-container vision-theme__layout">
              <>
                <div class="vision-theme__story">
                  <>
                    <p class="platform-eyebrow">{pillar}</p>
                    <h2 id={`${anchor}-title`}>{narrative.heading}</h2>
                    <p>{narrative.body}</p>
                  </>
                </div>
                <div class="vision-theme__details">
                  <p class="vision-theme__label">The policies behind this direction</p>
                  {[...categories].map(([category, items]) => (
                    <div class="vision-theme__category">
                      <h3>{category}</h3>
                      <ul>
                        {items.map((policy) => (
                          <li>
                            <a href={`/policies/${policy.slug.current}`}>
                              <span>
                                <strong>{policy.title}</strong>
                                <small>{policy.summary}</small>
                              </span>
                              <span aria-hidden="true">↗</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </>
            </div>
          </section>
        )
      })
    }
    <section class="platform-next">
      <div class="platform-container">
        <p class="platform-eyebrow">From direction to detail</p><h2>
          One platform.<br />Many steps.
        </h2><p>
          Long-term direction and this-term priorities belong together. Explore the whole platform,
          then read the evidence for the proposals that matter to you.
        </p><div>
          <a class="platform-primary-link" href="/policies">Browse every policy ↗</a><a
            class="platform-secondary-link"
            href="/policies?horizon=current">See this-term priorities ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
