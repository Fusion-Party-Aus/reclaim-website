---
export const prerender = false
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { getPolicies, getVisionPage } from '../lib/sanity'
import '../styles/global.css'
import '../styles/platform-pages.css'

const policies = await getPolicies({ thisTerm: false })
const visionPage = await getVisionPage()
const pillars = [...new Set(policies.map((policy) => policy.pillar || 'Other'))]
const chapters: Record<string, { title: string; promise: string; text: string; number: string }> = {
  'RECLAIM OUR INFRASTRUCTURE': {
    number: '01',
    title: 'A city that makes room.',
    promise: 'More homes. More ways to move. More life between them.',
    text: 'Let people live near jobs, services and stations. Make the network useful before arguing over fares. Build public assets so their value stays with the public.',
  },
  'RECLAIM OUR DEMOCRACY': {
    number: '02',
    title: 'A government you can reach.',
    promise: 'Decisions in daylight, with people in the room.',
    text: 'Make contracts and influence visible. Give residents meaningful ways to shape major decisions between elections, and make it easier to hold power to account.',
  },
  'RECLAIM OUR ECONOMY': {
    number: '03',
    title: 'A return we all share.',
    promise: 'When Victoria creates value, Victoria should benefit.',
    text: 'Capture more of the gains from public investment and put them to work on services, homes and transport. Test the numbers in public before promising a dividend.',
  },
}
---

<BaseLayout
  title={visionPage?.seo?.metaTitle || 'Our Vision | Fusion Party Victoria'}
  description={visionPage?.seo?.metaDescription ||
    'A long-term direction for Victoria: homes, transport, public value and democratic power.'}
>
  <Header />
  <main id="main-content" class="platform-page vision-page">
    <section class="platform-hero platform-hero--vision" aria-labelledby="vision-heading">
      <div class="platform-wrap platform-hero__inner">
        <div class="platform-hero__copy">
          <p class="platform-kicker">Fusion Victoria / The long view</p><h1 id="vision-heading">
            A state<br />worth <em>sharing.</em>
          </h1><p class="platform-lede">
            Set the floor. Protect the commons. Regulate harm. Otherwise, get out of the way.
          </p><div class="platform-hero__actions">
            <a href="#future" class="platform-button"
              >Picture the future <span aria-hidden="true">↘</span></a
            ><a href="/policies" class="platform-text-link"
              >Browse every policy <span aria-hidden="true">↗</span></a>
          </div>
        </div><div class="vision-graphic" aria-hidden="true">
          <div class="vision-graphic__rail"></div><div class="vision-graphic__home"></div><div
            class="vision-graphic__sun"
          >
          </div><span>ROOM TO<br />GROW</span>
        </div>
      </div><div class="platform-hero__footer platform-wrap">
        <span>Homes within reach</span><span>Power within reach</span><span>Value kept here</span>
      </div>
    </section>

    <section class="vision-intro platform-wrap">
      <p class="platform-section-label">The principle</p><div>
        <h2>Freedom needs<br /><em>foundations.</em></h2><p>
          A secure home, a useful way to get around and a government that listens give people real
          choices. Our long-term direction starts there. The policies below turn that direction into
          proposals you can inspect and debate.
        </p>
      </div>
    </section>

    <div id="future" class="vision-chapters">
      {
        pillars.map((pillar, index) => {
          const chapter = chapters[pillar] || {
            number: String(index + 1).padStart(2, '0'),
            title: pillar.toLowerCase(),
            promise: 'A better future is built in public.',
            text: 'Explore the longer-term proposals in this part of the platform.',
          }
          const items = policies.filter((policy) => (policy.pillar || 'Other') === pillar)
          return (
            <section class="vision-chapter" aria-labelledby={`vision-chapter-${index}`}>
              <div class="platform-wrap vision-chapter__layout">
                <>
                  <div class="vision-chapter__statement">
                    <>
                      <p class="platform-section-label">
                        {chapter.number} / {pillar.replace('RECLAIM OUR ', '')}
                      </p>
                      <h2 id={`vision-chapter-${index}`}>{chapter.title}</h2>
                      <p class="vision-chapter__promise">{chapter.promise}</p>
                      <p>{chapter.text}</p>
                    </>
                  </div>
                  <div class="vision-chapter__policies">
                    <p class="vision-chapter__label">
                      The proposals <span>{String(items.length).padStart(2, '0')}</span>
                    </p>
                    {items.map((policy) => (
                      <a href={`/policies/${policy.slug.current}`} class="vision-policy">
                        <span>
                          <small>{policy.category || 'Policy'}</small>
                          <strong>{policy.title}</strong>
                        </span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                </>
              </div>
            </section>
          )
        })
      }
    </div>

    <section class="vision-bridge">
      <div class="platform-wrap vision-bridge__inner">
        <p class="platform-section-label">Direction into action</p><h2>
          The long view<br />starts <em>now.</em>
        </h2><p>
          Some reforms take a term. Others take a generation. They belong to the same platform, and
          each proposal should stand up to scrutiny on its own merits.
        </p><div>
          <a href="/policies?horizon=current" class="platform-button"
            >See this-term policies <span aria-hidden="true">↗</span></a
          ><a href="/policies?horizon=long" class="platform-text-link"
            >Explore the long-term platform ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
