---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { BrutalCard, BrutalButton } from '@/components/ui'
import '../styles/global.css'
---

<BaseLayout
  title="Coming Soon | Reignite Democracy"
  description="Exciting new features are on the way! Stay tuned."
>
  <Header />

  <main id="main-content" class="min-h-screen relative overflow-hidden pt-28 pb-20 bg-black">
    <!-- Sparkles and stars -->
    <div class="absolute inset-0 opacity-20">
      {
        [...Array(15)].map((_, i) => (
          <div
            class="absolute text-5xl"
            style={`
            top: ${Math.random() * 100}%;
            left: ${Math.random() * 100}%;
            animation: twinkle ${2 + Math.random() * 3}s ease-in-out infinite ${Math.random() * 2}s;
          `}
          >
            {['✨', '⭐', '🌟', '💫', '⚡'][i % 5]}
          </div>
        ))
      }
    </div>

    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <!-- Main Content -->
      <div class="text-center mb-16">
        <!-- Animated rocket -->
        <div class="relative inline-block mb-8">
          <div class="absolute inset-0 bg-yellow blur-3xl opacity-30"></div>
          <div class="relative text-9xl" style="animation: float 3s ease-in-out infinite;">🚀</div>
          <!-- Smoke trail -->
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-full">
            <div class="text-6xl opacity-60" style="animation: fadeOut 2s ease-in-out infinite;">
              ☁️
            </div>
          </div>
        </div>

        <h1
          class="text-6xl md:text-8xl font-black uppercase mb-6 text-white leading-tight font-display"
          style="animation: pulse 3s ease-in-out infinite;"
        >
          COMING SOON
        </h1>

        <p class="text-3xl font-bold text-yellow mb-4">Something Amazing is Launching!</p>

        <p class="text-xl font-bold text-mint max-w-2xl mx-auto">
          We're cooking up something special. Big things are coming to Reignite Democracy!
        </p>
      </div>

      <!-- Countdown / Hype Section -->
      <div class="max-w-4xl mx-auto mb-16">
        <BrutalCard variant="surface" shadow="yellow" padding="lg" class="transform -rotate-1">
          <div class="text-center mb-8">
            <h2 class="text-3xl font-black uppercase text-yellow mb-4 font-display">
              What's Coming?
            </h2>
            <div class="flex items-center justify-center gap-2 mb-6">
              <div
                class="w-3 h-3 bg-yellow rounded-full"
                style="animation: pulse 1s ease-in-out infinite;"
              >
              </div>
              <div
                class="w-3 h-3 bg-mint rounded-full"
                style="animation: pulse 1s ease-in-out infinite 0.2s;"
              >
              </div>
              <div
                class="w-3 h-3 bg-magenta rounded-full"
                style="animation: pulse 1s ease-in-out infinite 0.4s;"
              >
              </div>
            </div>
          </div>

          <!-- Teaser Grid -->
          <div class="grid md:grid-cols-3 gap-6 mb-8">
            <div
              class="bg-yellow/10 border border-yellow rounded-sm p-6 text-center transform hover:scale-105 transition-all"
            >
              <Icon
                name="mdi:rocket-launch"
                class="w-16 h-16 mx-auto mb-3 text-yellow"
                style="animation: wiggle 2s ease-in-out infinite;"
              />
              <h3 class="font-black uppercase text-lg mb-2 text-white font-display">
                New Features
              </h3>
              <p class="text-sm font-bold text-white/70">Game-changing functionality</p>
            </div>

            <div
              class="bg-mint/10 border border-mint rounded-sm p-6 text-center transform hover:scale-105 transition-all"
            >
              <Icon
                name="mdi:star-four-points"
                class="w-16 h-16 mx-auto mb-3 text-mint"
                style="animation: spin 4s linear infinite;"
              />
              <h3 class="font-black uppercase text-lg mb-2 text-white font-display">Better UX</h3>
              <p class="text-sm font-bold text-white/70">Sleeker, faster, smoother</p>
            </div>

            <div
              class="bg-magenta/10 border border-magenta rounded-sm p-6 text-center transform hover:scale-105 transition-all"
            >
              <Icon
                name="mdi:lightbulb-on"
                class="w-16 h-16 mx-auto mb-3 text-magenta"
                style="animation: pulse 2s ease-in-out infinite;"
              />
              <h3 class="font-black uppercase text-lg mb-2 text-white font-display">
                More Content
              </h3>
              <p class="text-sm font-bold text-white/70">Expanded resources</p>
            </div>
          </div>

          <!-- Call to action -->
          <div class="text-center pt-6 border-t border-white/10">
            <p class="text-white font-bold mb-4">Want to be the first to know when we launch?</p>
            <form id="coming-soon-newsletter-form" class="max-w-md mx-auto flex gap-3">
              <input
                type="email"
                required
                placeholder="your@email.com"
                aria-label="Email address"
                class="flex-1 px-4 py-3 border border-white/15 rounded-sm bg-black/30 text-white font-bold focus:outline-none focus:border-yellow"
              />
              <button
                type="submit"
                class="px-6 py-3 bg-yellow text-black border border-white/10 rounded-sm font-black uppercase hover:bg-yellow-bright transition-all whitespace-nowrap font-display cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Notify Me!
              </button>
            </form>
            <div
              id="coming-soon-newsletter-message"
              class="hidden text-sm font-bold mt-4 text-center"
            >
            </div>
          </div>
        </BrutalCard>
      </div>

      <!-- Sneak Peek Features -->
      <div class="mb-16">
        <h3 class="text-4xl font-black uppercase text-center text-white mb-10 font-display">
          Sneak Peek
        </h3>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <BrutalCard
            variant="surface"
            shadow="yellow"
            padding="lg"
            class="transform hover:rotate-1 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-magenta/10 border border-magenta rounded-sm flex items-center justify-center"
              >
                <Icon name="mdi:bell-ring" class="w-8 h-8 text-magenta" />
              </div>
              <h4 class="text-2xl font-black uppercase font-display">Stay Updated</h4>
            </div>
            <p class="text-lg font-bold text-white/70 mb-4">
              Follow us on social media for behind-the-scenes updates and launch announcements!
            </p>
            <div class="flex gap-3">
              <a
                href="https://twitter.com/fusionparty"
                target="_blank"
                class="w-12 h-12 bg-white/5 border border-white/15 rounded-sm flex items-center justify-center hover:bg-yellow hover:text-black transition-all"
              >
                <Icon name="mdi:twitter" class="w-7 h-7 text-white" />
              </a>
              <a
                href="https://facebook.com/fusionparty"
                target="_blank"
                class="w-12 h-12 bg-white/5 border border-white/15 rounded-sm flex items-center justify-center hover:bg-yellow hover:text-black transition-all"
              >
                <Icon name="mdi:facebook" class="w-7 h-7 text-white" />
              </a>
              <a
                href="https://instagram.com/fusionparty"
                target="_blank"
                class="w-12 h-12 bg-white/5 border border-white/15 rounded-sm flex items-center justify-center hover:bg-yellow hover:text-black transition-all"
              >
                <Icon name="mdi:instagram" class="w-7 h-7 text-white" />
              </a>
            </div>
          </BrutalCard>

          <BrutalCard
            variant="surface"
            shadow="mint"
            padding="lg"
            class="transform hover:-rotate-1 transition-all"
          >
            <div class="flex items-center gap-4 mb-4">
              <div
                class="w-12 h-12 bg-mint/10 border border-mint rounded-sm flex items-center justify-center"
              >
                <Icon name="mdi:progress-clock" class="w-8 h-8 text-mint" />
              </div>
              <h4 class="text-2xl font-black uppercase font-display">In The Works</h4>
            </div>
            <p class="text-lg font-bold text-white/70 mb-4">
              Our team is working around the clock to bring you something truly special. Worth the
              wait!
            </p>
            <div class="flex items-center gap-2">
              <div
                class="flex-1 h-4 bg-white/5 border border-white/10 rounded-full overflow-hidden"
              >
                <div
                  class="h-full bg-yellow rounded-full"
                  style="width: 73%; animation: pulse 2s ease-in-out infinite;"
                >
                </div>
              </div>
              <span class="font-black text-lg text-white">73%</span>
            </div>
          </BrutalCard>
        </div>
      </div>

      <!-- While You Wait -->
      <div class="text-center">
        <BrutalCard
          variant="surface"
          shadow="yellow"
          padding="lg"
          class="inline-block transform rotate-1"
        >
          <h3 class="text-2xl font-black uppercase mb-4 font-display">While You Wait:</h3>
          <div class="flex flex-wrap gap-3 justify-center">
            <BrutalButton href="/" variant="yellow" icon="mdi:home">Explore Home</BrutalButton>
            <BrutalButton href="/policies" variant="secondary" icon="mdi:file-document">
              Read Policies
            </BrutalButton>
            <BrutalButton href="/blog" variant="black" icon="mdi:newspaper">
              Read Blog
            </BrutalButton>
          </div>
        </BrutalCard>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-30px);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-10deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  @keyframes fadeOut {
    0% {
      opacity: 0.6;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(50px) scale(1.5);
    }
  }
</style>

<script>
  // Newsletter form — submits to NationBuilder via /api/newsletter
  const form = document.getElementById('coming-soon-newsletter-form') as HTMLFormElement | null
  const message = document.getElementById('coming-soon-newsletter-message')

  if (form && message) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const input = form.querySelector('input[type="email"]') as HTMLInputElement | null
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (!input) return

      const email = input.value
      if (button) button.disabled = true
      message.classList.add('hidden')

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        })

        if (res.ok) {
          message.textContent = `Success — ${email} added to alerts.`
          message.classList.remove('text-magenta')
          message.classList.add('text-mint')
          message.classList.remove('hidden')
          form.classList.add('hidden')
        } else {
          message.textContent = "Couldn't subscribe right now — please try again shortly."
          message.classList.remove('text-mint')
          message.classList.add('text-magenta')
          message.classList.remove('hidden')
        }
      } catch {
        message.textContent = "Couldn't subscribe right now — please try again shortly."
        message.classList.remove('text-mint')
        message.classList.add('text-magenta')
        message.classList.remove('hidden')
      } finally {
        if (button) button.disabled = false
      }
    })
  }
</script>
