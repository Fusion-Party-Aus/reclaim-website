---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { ShareIcon } from '@/features/sharing'
import { BrutalBadge, BrutalButton } from '@/components/ui'
import { getDocuments } from '../../lib/sanity'
import { PortableText } from 'astro-portabletext'
import CustomLink from '../../components/portable-text/CustomLink.astro'
import TableBlock from '../../components/portable-text/TableBlock.astro'
import type { PortableTextBlock } from '../../lib/portableText'

interface FAQ {
  _id: string
  _updatedAt?: string
  category: string
  question: string
  answer: PortableTextBlock[]
  slug: { current: string }
}

export async function getStaticPaths() {
  const faqs = await getDocuments<FAQ>('faq')
  return faqs
    .filter((faq) => faq.slug?.current)
    .map((faq) => ({
      params: { slug: faq.slug.current },
      props: { faq },
    }))
}

export interface Props {
  faq: FAQ
}
const { faq } = Astro.props

const categoryLabels: Record<string, string> = {
  debt: 'Debt & Fiscal Policy',
  'left-attacks': 'From the Left',
  'right-attacks': 'From the Right',
  general: 'About Fusion',
  electoral: 'Electoral Strategy',
  policy: 'Policy Details',
}
const categoryLabel = categoryLabels[faq.category] || faq.category
---

<BaseLayout title={`${faq.question} | Fusion Party Victoria`} image="/og/faq.png">
  <Header />

  <main id="main-content" class="bg-surface-base min-h-screen pb-24">
    {/* Hero bar */}
    <div class="bg-grey-dark border-b border-white/10 pt-6 pb-10 px-4 md:px-8">
      <div class="h-1 bg-magenta mb-0.5"></div>
      <div class="h-1 bg-mint mb-0.5"></div>
      <div class="h-1 bg-yellow mb-6"></div>
      <div class="max-w-4xl mx-auto">
        <BrutalBadge variant="mint" class="mb-4">
          {categoryLabel}
        </BrutalBadge>
        <h1 class="text-3xl md:text-5xl font-display font-black uppercase text-white leading-tight">
          {faq.question}
        </h1>
        {
          faq._updatedAt && (
            <p class="mt-3 text-xs font-black uppercase tracking-widest text-white/50">
              Updated:{' '}
              {new Date(faq._updatedAt).toLocaleDateString('en-AU', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </p>
          )
        }
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 md:px-8 pt-10">
      {/* Breadcrumbs */}
      <nav
        class="flex items-center flex-wrap gap-1 mb-10 text-xs font-black uppercase tracking-widest"
      >
        <a
          href="/"
          class="px-3 py-1.5 rounded-sm border border-white/10 bg-grey-dark text-white hover:border-mint/40 transition-colors"
          >Home</a
        >
        <span class="text-white/30">›</span>
        <a
          href="/faq"
          class="px-3 py-1.5 rounded-sm border border-white/10 bg-grey-dark text-white hover:border-mint/40 transition-colors"
          >FAQ</a
        >
        <span class="text-white/30">›</span>
        <span
          class="px-3 py-1.5 rounded-sm border border-magenta/40 bg-magenta/10 text-magenta max-w-xs truncate"
          title={faq.question}>{faq.question}</span
        >
      </nav>

      {/* Answer card */}
      <article
        class="rounded-sm border border-white/10 bg-grey-dark shadow-brutal-mint overflow-hidden"
      >
        {/* Top stripe */}
        <div class="h-1 w-full bg-magenta"></div>

        <div class="p-8 md:p-10">
          {/* Share row */}
          <div class="flex items-center justify-end gap-2 mb-8 pb-4 border-b border-white/10">
            <span class="text-xs font-black uppercase text-white/40 mr-auto">Answer</span>
            <button
              id="copy-link-button"
              type="button"
              class="inline-flex items-center gap-1 text-xs uppercase font-black rounded-sm px-3 py-1.5 bg-yellow text-white hover:bg-mint hover:text-black transition-colors"
            >
              <ShareIcon />
              Copy link
            </button>
            <button
              id="open-share-dialog"
              type="button"
              class="text-xs uppercase font-black rounded-sm border border-white/10 px-3 py-1.5 bg-grey-dark text-white hover:border-mint/40 hover:text-mint transition-colors"
            >
              Share
            </button>
          </div>

          <div class="faq-answer">
            <PortableText
              value={faq.answer}
              components={{
                mark: { link: CustomLink },
                type: { table: TableBlock },
              }}
            />
          </div>
        </div>
      </article>

      {/* Back link */}
      <div class="mt-8 flex gap-3">
        <BrutalButton href="/faq" variant="black" icon="mdi:arrow-left"> Back to FAQ </BrutalButton>
        <BrutalButton href="/get-involved" variant="magenta" icon="mdi:hand-heart">
          Get Involved
        </BrutalButton>
      </div>
    </div>
  </main>

  {/* Copy toast */}
  <div
    id="copy-toast"
    class="fixed bottom-6 right-6 z-50 px-4 py-2 bg-grey-dark text-white text-xs font-black uppercase tracking-wide border border-mint/40 rounded-sm shadow-brutal-mint hidden"
  >
    Link copied ✓
  </div>

  {/* Share dialog */}
  <div
    id="share-dialog"
    class="fixed inset-0 z-40 flex items-center justify-center bg-black/50 hidden"
  >
    <div
      class="bg-grey-dark border border-white/10 rounded-sm p-6 max-w-sm w-full mx-4 shadow-brutal-lg"
    >
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm font-black uppercase tracking-wide text-white">Share this answer</h2>
        <button
          id="close-share-dialog"
          type="button"
          class="text-xs font-black px-3 py-1.5 rounded-sm bg-yellow text-white hover:bg-mint hover:text-black transition-colors"
        >
          Close ✕
        </button>
      </div>
      <div class="flex flex-col gap-2">
        <a
          id="share-twitter"
          class="px-4 py-3 rounded-sm bg-black border border-white/20 text-white text-xs font-black uppercase tracking-wide hover:scale-[1.02] transition-all"
        >
          Share on X / Twitter
        </a>
        <a
          id="share-facebook"
          class="px-4 py-3 rounded-sm text-white text-xs font-black uppercase tracking-wide hover:scale-[1.02] transition-all"
          style="background: #1877F2;"
        >
          Share on Facebook
        </a>
        <a
          id="share-email"
          class="px-4 py-3 rounded-sm bg-yellow text-white text-xs font-black uppercase tracking-wide hover:scale-[1.02] transition-all"
        >
          Share via Email
        </a>
      </div>
    </div>
  </div>

  <script>
    const copyBtn = document.getElementById('copy-link-button')
    const toast = document.getElementById('copy-toast')
    const openDialogBtn = document.getElementById('open-share-dialog')
    const closeDialogBtn = document.getElementById('close-share-dialog')
    const dialog = document.getElementById('share-dialog')

    const url = encodeURIComponent(window.location.href)
    const text = encodeURIComponent(document.title)

    const twitter = document.getElementById('share-twitter') as HTMLAnchorElement | null
    const facebook = document.getElementById('share-facebook') as HTMLAnchorElement | null
    const email = document.getElementById('share-email') as HTMLAnchorElement | null

    if (twitter) {
      ;(twitter as HTMLAnchorElement).href =
        `https://twitter.com/intent/tweet?text=${text}&url=${url}`
      twitter.setAttribute('target', '_blank')
      twitter.setAttribute('rel', 'noopener noreferrer')
    }
    if (facebook) {
      ;(facebook as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${url}`
      facebook.setAttribute('target', '_blank')
      facebook.setAttribute('rel', 'noopener noreferrer')
    }
    if (email) {
      ;(email as HTMLAnchorElement).href = `mailto:?subject=${text}&body=${url}`
    }

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async () => {
        const urlRaw = window.location.href
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url: urlRaw })
            return
          } catch (_e) {
            // navigator.share cancelled or unsupported — fall through to clipboard
          }
        }
        if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(urlRaw)
            toast.classList.remove('hidden')
            setTimeout(() => toast.classList.add('hidden'), 2000)
          } catch (_e) {
            // clipboard write failed — silently ignore
          }
        }
      })
    }

    if (openDialogBtn && closeDialogBtn && dialog) {
      openDialogBtn.addEventListener('click', () => dialog.classList.remove('hidden'))
      closeDialogBtn.addEventListener('click', () => dialog.classList.add('hidden'))
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.classList.add('hidden')
      })
    }
  </script>

  <Footer />
</BaseLayout>
