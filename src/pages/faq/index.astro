---
import { DEPLOYMENT } from '@/lib/deployment'
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Header } from '@/components/layout/Header';
import { Hero } from '@/components/layout/Hero';
import { Footer } from '@/components/layout/Footer';
import { FaqSidebar } from '@/features/faq';
import { getDocuments } from '../../lib/sanity';
import { portableTextToPlainText } from '../../lib/portableText';
import { PortableText } from 'astro-portabletext';
import CustomLink from '../../components/portable-text/CustomLink.astro';
import TableBlock from '../../components/portable-text/TableBlock.astro';
import { Icon } from 'astro-icon/components';
import { FAQPageSchema } from '@adkinn/astro-ai-readiness/components';
import type { FAQItem } from '@adkinn/astro-ai-readiness/components';
import { BrutalBadge, CTA, BrutalButton } from '@/components/ui';
import type { PortableTextBlock } from '../../lib/portableText';
import '../../styles/global.css'
import '../../styles/editorial.css';

interface FAQ {
  _id: string;
  _updatedAt?: string;
  slug: { current: string };
  category: string;
  question: string;
  answer: PortableTextBlock[];
  order?: number;
}

const allFaqs = await getDocuments<FAQ>('faq');

const faqsByCategory = allFaqs.reduce((acc, faq) => {
  const category = faq.category || 'general';
  if (!acc[category]) acc[category] = [];
  acc[category].push(faq);
  return acc;
}, {} as Record<string, FAQ[]>);

Object.keys(faqsByCategory).forEach(category => {
  faqsByCategory[category].sort((a, b) => (a.order || 999) - (b.order || 999));
});

const categoryInfo: Record<string, { title: string; description: string; bg: string; textColor: string; icon: string }> = {
  'debt':         { title: 'Debt & Fiscal Policy',  description: `Debt, spending and fiscal choices in ${DEPLOYMENT.state}.`, bg: 'var(--branch-primary, #681268)', textColor: 'var(--color-on-primary, #fff)', icon: 'mdi:currency-usd' },
  'left-attacks': { title: 'From the Left',          description: 'Addressing progressive concerns and comparisons with the Greens.',               bg: 'var(--branch-secondary, #00DDB8)', textColor: 'var(--color-on-secondary, #0F0018)', icon: 'mdi:arrow-left-bold' },
  'right-attacks':{ title: 'From the Right',         description: 'Answers to conservative critiques.',          bg: 'var(--branch-accent-deep, #234080)', textColor: 'var(--color-on-primary, #fff)', icon: 'mdi:arrow-right-bold' },
  'general':      { title: 'About Fusion',           description: "Who we are, how we're different, and why we exist.",                              bg: 'var(--branch-secondary, #2E004D)',    textColor: 'var(--color-on-primary, #fff)', icon: 'mdi:information' },
  'electoral':    { title: 'Electoral Strategy',     description: "How we plan to win and what happens if we don't.",                                bg: 'var(--branch-secondary, #00DDB8)', textColor: 'var(--color-on-secondary, #0F0018)', icon: 'mdi:vote' },
  'policy':       { title: 'Policy Details',         description: 'How proposals work and what remains to be costed.',                           bg: 'var(--branch-accent-deep, #234080)', textColor: 'var(--color-on-primary, #fff)', icon: 'mdi:file-document' },
};

const categoryOrder = ['general', 'debt', 'policy', 'electoral', 'left-attacks', 'right-attacks'];
const sortedCategories = categoryOrder.filter(cat => faqsByCategory[cat]);

const sidebarSections = sortedCategories.map(category => {
  const info = categoryInfo[category];
  return {
    id: category,
    title: info.title,
    questions: faqsByCategory[category].map(faq => ({
      id: `faq-${faq._id}`,
      title: faq.question
    }))
  };
});

const shadowCycle = ['var(--branch-primary, #D428D4)', 'var(--branch-secondary, #00DDB8)', 'var(--branch-accent, #4A7AEB)'];
---

<BaseLayout
  title={`FAQ | ${DEPLOYMENT.label}`}
  description="Answers about Fusion's policies, funding, elections and use of AI."
  image={DEPLOYMENT.contentProfile === 'victoria-campaign' ? '/og/faq.png' : DEPLOYMENT.seo.defaultOgImage}
>
  <Header />

  <!-- FAQPage JSON-LD Structured Data -->
  <FAQPageSchema
    items={allFaqs.map((faq): FAQItem => ({
      question: faq.question,
      answer: portableTextToPlainText(faq.answer),
    }))}
  />

  <Hero
    title="Frequently Asked Questions"
    subtitle="How our policies work, what they cost and who makes the decisions."
  />

  <main id="main-content" class="site-editorial bg-surface-base py-12 pb-24">
    <div class="max-w-7xl mx-auto px-4 md:px-8">

      {/* ── Breadcrumbs ── */}
      <nav class="flex items-center flex-wrap gap-1 mb-10 text-xs font-black uppercase tracking-widest">
        <a href="/" class="px-3 py-1.5 rounded-sm border border-white/10 bg-grey-dark text-fg hover:border-mint/40 transition-colors">Home</a>
        <span class="text-fg/30">›</span>
        <span class="px-3 py-1.5 rounded-sm border border-magenta/40 bg-magenta/10 text-magenta">FAQ</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8">

        {/* Sidebar */}
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <FaqSidebar sections={sidebarSections} />
        </aside>

        <div>
          {/* ── Quick-jump nav ── */}
          <div class="rounded-sm border border-white/10 bg-grey-dark p-6 mb-10" style="border-top: 2px solid var(--branch-accent, #4A7AEB);">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="mdi:compass" class="w-6 h-6 text-fg" />
              <h2 class="text-lg font-display font-black uppercase text-fg">Jump to Category</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              {sortedCategories.map(category => {
                const info = categoryInfo[category];
                return (
                  <a
                    href={`#${category}`}
                    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-sm text-xs font-black uppercase hover:scale-[1.02] transition-all"
                    style={`background: ${info.bg}; color: ${info.textColor};`}
                  >
                    <Icon name={info.icon} class="w-3.5 h-3.5" />
                    {info.title}
                  </a>
                );
              })}
            </div>
          </div>

          {/* ── FAQ sections ── */}
          {sortedCategories.map((category, catIndex) => {
            const faqs = faqsByCategory[category];
            const info = categoryInfo[category];
            const shadow = shadowCycle[catIndex % shadowCycle.length];
            return (
              <section id={category} class="mb-12 scroll-mt-24">
                {/* Category header */}
                <div class="rounded-sm px-6 py-5 flex items-center gap-4"
                  style={`background: ${info.bg};`}>
                  <div class="p-2 rounded-sm bg-neutral-panel shrink-0">
                    <Icon name={info.icon} class="w-6 h-6" style={`color: ${info.textColor};`} />
                  </div>
                  <div>
                    <h2 class="text-2xl font-display font-black uppercase leading-tight"
                      style={`color: ${info.textColor};`}>
                      {info.title}
                    </h2>
                    <p class="text-sm font-bold mt-0.5" style={`color: ${info.textColor};`}>
                      {info.description}
                    </p>
                  </div>
                </div>

                {/* FAQ items */}
                <div class="mt-8 space-y-6">
                  {faqs.map((faq, _index) => (
                    <article
                      id={`faq-${faq._id}`}
                      class="faq-item scroll-mt-24 rounded-sm border border-white/10 bg-grey-dark transition-colors duration-150"
                      style={`border-top: 2px solid ${shadow};`}
                    >
                      <div class="border-b border-white/10 px-6 py-4 flex items-start gap-3">
                        <span class="text-magenta font-black text-lg shrink-0 mt-0.5">Q.</span>
                        <h3 class="text-lg font-display font-black uppercase text-fg leading-tight">
                          {faq.question}
                        </h3>
                        {
                          faq._updatedAt && (
                            <p class="mt-1 text-sm font-bold text-fg/85">
                              Updated: {new Date(faq._updatedAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
                            </p>
                          )
                        }
                      </div>
                      <div class="p-6 md:p-8 faq-answer">
                        <PortableText
                          value={faq.answer}
                          components={{
                            mark: { link: CustomLink },
                            type: { table: TableBlock },
                          }}
                        />
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            );
          })}

          {/* ── CTA ── */}
          <CTA variant="primary" size="lg" shadow="lg" class="mt-4">
            <BrutalBadge variant="white" class="mb-4">Still curious?</BrutalBadge>
            <h2 class="text-2xl md:text-3xl font-display font-black uppercase mb-2 leading-tight">
              Still Have Questions?
            </h2>
            <p class="text-sm font-black text-fg mb-6 border-l-4 border-yellow pl-4 max-w-lg">
              Ask us at{' '}
              <a
                href={`mailto:${DEPLOYMENT.contact.helloEmail}`}
                class="text-mint font-black hover:underline"
              >
                {DEPLOYMENT.contact.helloEmail}
              </a>
            </p>
            <div class="flex flex-wrap gap-3">
              <BrutalButton href="/get-involved" variant="white" icon="mdi:hand-heart">
                Get Involved
              </BrutalButton>
              <BrutalButton href="/policies" variant="black" icon="mdi:file-document-multiple">
                All Policies
              </BrutalButton>
            </div>
          </CTA>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
