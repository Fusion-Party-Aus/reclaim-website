---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import { Icon } from 'astro-icon/components'
import { BrutalCard } from '@/components/ui'
import '../styles/global.css'

const maintenanceMessages = [
  'BRB, fixing democracy',
  "We're making things better (unlike some governments we could mention)",
  'Upgrading our systems so we can upgrade yours',
  'Currently under construction... like our policy platform!',
  'Maintenance mode: Because we actually care about quality',
  'Taking a quick tech break to serve you better',
]

const randomMessage = maintenanceMessages[Math.floor(Math.random() * maintenanceMessages.length)]
---

<BaseLayout
  title="503 - Maintenance | Fusion Party Victoria"
  description="We're currently performing maintenance. We'll be back soon!"
  noindex={true}
>
  <Header />

  <main id="main-content" class="min-h-screen bg-black relative overflow-hidden pt-28 pb-20">
    <!-- Construction elements floating around -->
    <div class="absolute inset-0 opacity-20">
      {
        [...Array(6)].map((_, i) => (
          <div
            class="absolute text-7xl"
            style={`
            top: ${Math.random() * 80 + 10}%;
            left: ${Math.random() * 90}%;
            animation: float ${4 + i}s ease-in-out infinite ${i * 0.5}s, spin ${15 + i * 3}s linear infinite;
          `}
          >
            {['🔧', '🔨', '⚙️', '🛠️', '⚡', '🏗️'][i]}
          </div>
        ))
      }
    </div>

    <div class="max-w-6xl mx-auto px-4 relative z-10">
      <!-- Construction Icon -->
      <div class="text-center mb-12">
        <div class="inline-block relative mb-8">
          <div class="absolute inset-0 bg-yellow blur-3xl opacity-30"></div>
          <div
            class="relative w-48 h-48 mx-auto bg-grey-dark border border-yellow rounded-full flex items-center justify-center"
            style="box-shadow: 0 0 60px rgba(74, 122, 235, 0.5); animation: bounce 2s ease-in-out infinite;"
          >
            <Icon
              name="mdi:construction"
              class="w-32 h-32 text-yellow"
              style="animation: wiggle 3s ease-in-out infinite;"
            />
          </div>

          <!-- Hard hat on top -->
          <div
            class="absolute -top-12 left-1/2 -translate-x-1/2 text-8xl"
            style="animation: bounce 1.5s ease-in-out infinite;"
          >
            ⛑️
          </div>
        </div>

        <h1 class="text-5xl md:text-7xl font-black uppercase mb-6 text-white font-display">
          UNDER MAINTENANCE
        </h1>

        <p class="text-2xl md:text-3xl font-bold text-white/80">
          {randomMessage}
        </p>
      </div>

      <!-- Status Card -->
      <div class="max-w-3xl mx-auto mb-12">
        <BrutalCard variant="surface" shadow="yellow" padding="lg" class="transform rotate-1">
          <div class="flex items-center gap-4 mb-8">
            <div class="relative">
              <div
                class="w-20 h-20 bg-yellow/10 border border-yellow rounded-sm flex items-center justify-center"
                style="animation: pulse 2s ease-in-out infinite;"
              >
                <Icon name="mdi:hammer-wrench" class="w-12 h-12 text-yellow" />
              </div>
              <div
                class="absolute -bottom-2 -right-2 bg-magenta border border-white/20 rounded-sm px-2 py-1 text-xs font-black text-white uppercase"
              >
                Active
              </div>
            </div>
            <div class="flex-1">
              <h2 class="text-2xl font-black uppercase text-yellow mb-2 font-display">
                System Upgrade In Progress
              </h2>
              <p class="text-white/80 font-bold">
                We're improving our platform to serve you better
              </p>
            </div>
          </div>

          <!-- Fake Progress Bars -->
          <div class="space-y-4">
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-mint font-black text-sm uppercase">Database Optimization</span>
                <span class="text-yellow font-black text-sm">87%</span>
              </div>
              <div class="h-4 bg-white/5 border border-mint/40 rounded-sm overflow-hidden">
                <div
                  class="h-full bg-mint"
                  style="width: 87%; animation: pulse 1s ease-in-out infinite;"
                >
                </div>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-yellow font-black text-sm uppercase">Server Updates</span>
                <span class="text-yellow font-black text-sm">63%</span>
              </div>
              <div class="h-4 bg-white/5 border border-yellow/40 rounded-sm overflow-hidden">
                <div
                  class="h-full bg-yellow"
                  style="width: 63%; animation: pulse 1s ease-in-out infinite 0.2s;"
                >
                </div>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-magenta font-black text-sm uppercase">Testing Changes</span>
                <span class="text-yellow font-black text-sm">94%</span>
              </div>
              <div class="h-4 bg-white/5 border border-magenta/40 rounded-sm overflow-hidden">
                <div
                  class="h-full bg-magenta"
                  style="width: 94%; animation: pulse 1s ease-in-out infinite 0.4s;"
                >
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10">
            <div class="flex items-center justify-between">
              <p class="text-sm font-bold text-white/40 uppercase">Estimated time:</p>
              <p class="text-xl font-black text-yellow uppercase font-display">Coming Soon™</p>
            </div>
          </div>
        </BrutalCard>
      </div>

      <!-- What's Being Improved -->
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-12">
        <BrutalCard variant="surface" shadow="magenta" padding="md">
          <div
            class="w-16 h-16 bg-magenta/10 border border-magenta rounded-sm flex items-center justify-center mb-4 mx-auto"
          >
            <Icon name="mdi:speedometer" class="w-10 h-10 text-magenta" />
          </div>
          <h3 class="text-xl font-black uppercase text-center mb-3 font-display">Performance</h3>
          <p class="text-sm font-bold text-white/60 text-center">
            Making everything faster and smoother
          </p>
        </BrutalCard>

        <BrutalCard variant="surface" shadow="yellow" padding="md">
          <div
            class="w-16 h-16 bg-yellow/10 border border-yellow rounded-sm flex items-center justify-center mb-4 mx-auto"
          >
            <Icon name="mdi:shield-check" class="w-10 h-10 text-yellow" />
          </div>
          <h3 class="text-xl font-black uppercase text-center mb-3 font-display">Security</h3>
          <p class="text-sm font-bold text-white/60 text-center">
            Enhancing protection for your data
          </p>
        </BrutalCard>

        <BrutalCard variant="surface" shadow="magenta" padding="md">
          <div
            class="w-16 h-16 bg-magenta/10 border border-magenta rounded-sm flex items-center justify-center mb-4 mx-auto"
          >
            <Icon name="mdi:star-four-points" class="w-10 h-10 text-magenta" />
          </div>
          <h3 class="text-xl font-black uppercase text-center mb-3 font-display">Features</h3>
          <p class="text-sm font-bold text-white/60 text-center">Adding cool new functionality</p>
        </BrutalCard>
      </div>

      <!-- Stay Updated -->
      <div class="max-w-2xl mx-auto">
        <BrutalCard variant="surface" shadow="yellow" padding="lg" class="transform -rotate-1">
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-16 h-16 bg-yellow/10 border border-yellow rounded-sm flex items-center justify-center"
              style="animation: wiggle 2s ease-in-out infinite;"
            >
              <Icon name="mdi:bell-ring" class="w-10 h-10 text-yellow" />
            </div>
            <h3 class="text-2xl font-black uppercase text-yellow font-display">
              We'll Be Back Soon!
            </h3>
          </div>
          <p class="text-lg font-bold text-white/80 mb-6">
            Follow our social media for real-time updates on when we're back online:
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://twitter.com/fusionparty"
              target="_blank"
              class="px-6 py-3 bg-white/5 text-white border border-white/15 rounded-sm font-black uppercase hover:bg-white/10 transition-all font-display"
            >
              <Icon name="mdi:twitter" class="w-5 h-5 inline mr-2" />
              Twitter
            </a>
            <a
              href="https://facebook.com/fusionparty"
              target="_blank"
              class="px-6 py-3 bg-white/5 text-white border border-white/15 rounded-sm font-black uppercase hover:bg-white/10 transition-all font-display"
            >
              <Icon name="mdi:facebook" class="w-5 h-5 inline mr-2" />
              Facebook
            </a>
            <button
              onclick="window.location.reload()"
              class="px-6 py-3 bg-yellow text-black border border-white/10 rounded-sm font-black uppercase hover:bg-yellow-bright transition-all font-display"
            >
              <Icon name="mdi:refresh" class="w-5 h-5 inline mr-2" />
              Try Now
            </button>
          </div>
        </BrutalCard>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-10deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }
</style>
