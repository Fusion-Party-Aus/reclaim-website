---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { BrutalButton, BrutalCard, BrutalBadge, CTA, StatCard, IconBadge } from '@/components/ui'
import { Image } from 'astro:assets'
import brisbane from '@/assets/qld/brisbane-cbd.jpg'
import '../../styles/global.css'

const nav = [
  { href: '#principles', label: 'Principles' },
  { href: '#colour', label: 'Colour' },
  { href: '#rules', label: 'Colour Rules' },
  { href: '#type', label: 'Typography' },
  { href: '#surfaces', label: 'Surfaces' },
  { href: '#buttons', label: 'Buttons' },
  { href: '#components', label: 'Components' },
  { href: '#imagery', label: 'Imagery' },
  { href: '#specimen', label: 'Page Example' },
  { href: '#relationship', label: 'Fusion DNA' },
]

const principles = [
  {
    n: '01',
    title: 'Shared DNA, local expression',
    body: 'Queensland uses the same typography, components, accessibility standard and evidence-forward rules as every other branch. What changes is the palette, the surface logic and the tone. Same party, own voice.',
  },
  {
    n: '02',
    title: 'Light-first and warm',
    body: 'The canvas is ivory, not black. Maroon carries structure and action, eucalyptus carries depth, gold carries delight. Warmth is a material property here, not a copy adjustment.',
  },
  {
    n: '03',
    title: 'Evidence over adjective',
    body: 'Every colour pairing on this page ships with its measured contrast ratio. A claim without a number is a slogan, and slogans do not survive scrutiny.',
  },
  {
    n: '04',
    title: 'Warm, never soft',
    body: 'Approachable does not mean weightless. Maroon bands, sharp corners and heavy condensed headlines keep the authority. The warmth is in the light and the spacing, not in blur and rounding.',
  },
]

const foundation = [
  {
    name: 'Maroon',
    hex: '#731E32',
    role: 'Primary identity, CTAs, structural bands',
    text: 'light',
  },
  {
    name: 'Warm Gold',
    hex: '#F4C66A',
    role: 'Accent fills, rules, highlights, stats',
    text: 'dark',
  },
  { name: 'Ivory', hex: '#FFF7EC', role: 'Canvas, text on maroon and eucalyptus', text: 'dark' },
  {
    name: 'Eucalyptus Ink',
    hex: '#233D3A',
    role: 'Secondary CTA, links, body text, deep bands',
    text: 'light',
  },
]

const supporting = [
  { name: 'Paper', hex: '#FFFDF8', role: 'Raised panels' },
  { name: 'Ochre', hex: '#8F6119', role: 'Emphasis type, alerts' },
  { name: 'Bottlebrush', hex: '#A34A38', role: 'Tertiary accent' },
  { name: 'Eucalyptus Mid', hex: '#3A5B56', role: 'Deep links, hovers' },
  { name: 'Warm Line', hex: '#E5DCCB', role: 'Hairline borders' },
  { name: 'Muted Ink', hex: '#61716C', role: 'Secondary copy' },
]

const approvedPairs = [
  { pair: 'Maroon on Ivory', a: '#731E32', b: '#FFF7EC', ratio: '10.08:1', verdict: 'AAA' },
  { pair: 'Eucalyptus on Ivory', a: '#233D3A', b: '#FFF7EC', ratio: '10.98:1', verdict: 'AAA' },
  { pair: 'Ivory on Maroon', a: '#FFF7EC', b: '#731E32', ratio: '10.08:1', verdict: 'AAA' },
  { pair: 'Ivory on Eucalyptus', a: '#FFF7EC', b: '#233D3A', ratio: '10.98:1', verdict: 'AAA' },
  { pair: 'Gold on Eucalyptus', a: '#F4C66A', b: '#233D3A', ratio: '7.30:1', verdict: 'AAA' },
  { pair: 'Gold on Maroon', a: '#F4C66A', b: '#731E32', ratio: '6.70:1', verdict: 'AA' },
  { pair: 'Bottlebrush on Ivory', a: '#A34A38', b: '#FFF7EC', ratio: '5.50:1', verdict: 'AA' },
  { pair: 'Ochre on Ivory', a: '#8F6119', b: '#FFF7EC', ratio: '5.08:1', verdict: 'AA' },
  { pair: 'Muted Ink on Ivory', a: '#61716C', b: '#FFF7EC', ratio: '4.84:1', verdict: 'AA' },
]

const bannedPairs = [
  { pair: 'Gold on Ivory', a: '#F4C66A', b: '#FFF7EC', ratio: '1.51:1' },
  { pair: 'Ivory on Gold', a: '#FFF7EC', b: '#F4C66A', ratio: '1.51:1' },
  { pair: 'Eucalyptus on Maroon', a: '#233D3A', b: '#731E32', ratio: '1.09:1' },
]

const colourRules = [
  {
    situation: 'Primary CTA',
    examples: 'Join, Volunteer, Donate',
    hex: '#731E32',
    name: 'Maroon',
    why: 'The primary identity. Highest-attention action takes the structural colour.',
  },
  {
    situation: 'Secondary CTA',
    examples: 'Read the plan, Share, Learn more',
    hex: '#233D3A',
    name: 'Eucalyptus',
    why: 'Signals "proceed" without competing with maroon. Ivory text, 10.98:1.',
  },
  {
    situation: 'Emphasis + stats',
    examples: 'Key figures, pull quotes, highlights',
    hex: '#8F6119',
    name: 'Ochre',
    why: 'The dark gold. Brand gold cannot set type on ivory, so emphasis uses its text-safe member.',
  },
  {
    situation: 'Tertiary accent',
    examples: 'Third-level tags, charts, callouts',
    hex: '#A34A38',
    name: 'Bottlebrush',
    why: 'A warm third hue that reads as related to maroon without repeating it.',
  },
  {
    situation: 'Links + inline emphasis',
    examples: 'Body links, references',
    hex: '#233D3A',
    name: 'Eucalyptus',
    why: 'Functional, dark enough for AA on ivory, no separate "link blue".',
  },
]

const tokenMap = [
  { token: '--color-magenta', vic: '#D428D4 magenta', qld: '#731E32 maroon' },
  { token: '--color-mint', vic: '#00DDB8 mint', qld: '#233D3A eucalyptus' },
  { token: '--color-yellow', vic: '#4A7AEB blue', qld: '#8F6119 ochre' },
  { token: '--color-lavender', vic: '#7B3FE4 violet', qld: '#A34A38 bottlebrush' },
  { token: '--color-surface-base', vic: '#1A0029 deep purple', qld: '#FFF7EC ivory' },
  { token: '--color-grey-dark', vic: '#2E004D purple panel', qld: '#FFFDF8 paper panel' },
  { token: '--color-fg', vic: '#FFFFFF white', qld: '#233D3A eucalyptus' },
  { token: '--color-on-primary', vic: '#FFFFFF white', qld: '#FFF7EC ivory' },
  { token: '--color-on-secondary', vic: '#0F0018 near-black', qld: '#FFF7EC ivory' },
  { token: '--color-line', vic: 'white 10%', qld: '#E5DCCB warm line' },
  { token: '--color-focus', vic: '#00DDB8 mint', qld: '#233D3A eucalyptus' },
]

const casing = [
  {
    el: 'Display headlines',
    qld: 'Sentence case',
    vic: 'ALL CAPS',
    example: 'A better future for Queensland',
  },
  {
    el: 'Body copy',
    qld: 'Sentence case',
    vic: 'Sentence case',
    example: 'This plan was costed before it was announced.',
  },
  {
    el: 'Kickers / labels',
    qld: 'ALL CAPS',
    vic: 'ALL CAPS',
    example: 'POLICY · TRANSPORT · HOUSING',
  },
  { el: 'Buttons', qld: 'Sentence case', vic: 'ALL CAPS', example: 'Read the full plan' },
  {
    el: 'Data / stats',
    qld: 'Numbers + units',
    vic: 'Numbers + units',
    example: '$198B · 34% · 4×',
  },
]

const surfaces = [
  { name: 'Ivory canvas', hex: '#FFF7EC', token: '--color-surface-base', note: 'The page itself' },
  {
    name: 'Paper panel',
    hex: '#FFFDF8',
    token: '--color-grey-dark',
    note: 'Raised cards and stats',
  },
  {
    name: 'Warm mid',
    hex: '#F3E7D5',
    token: '--color-surface-overlay',
    note: 'Inset blocks, table zebra',
  },
  {
    name: 'Maroon band',
    hex: '#731E32',
    token: '--color-surface-brand',
    note: 'Hero and CTA sections',
  },
  {
    name: 'Eucalyptus band',
    hex: '#233D3A',
    token: '--color-mint',
    note: 'Deep evidence sections',
  },
]

const imageDonts = [
  'No AI-generated imagery of any kind',
  'No generic stock photography, every photo needs a Queensland purpose',
  'No brand gold applied as a photo tint, gold is a highlight, not a wash',
  'No fully desaturated people photos, keep warmth and skin tones readable',
  'No decorative photo shapes, rectangular crops and the shared diagonal only',
  'No duotone endpoints outside maroon, gold and eucalyptus',
]
---

<BaseLayout
  title="Fusion Queensland Design System | Fusion Party Queensland"
  description="The Fusion Queensland design system: maroon, gold and ivory, built on shared Fusion components, typography and accessibility standards."
  noindex
>
  <!-- ═══ MASTHEAD SPECIMEN ═══ -->
  <header
    class="sticky top-0 z-50 bg-ivory/90 backdrop-blur border-b border-warm-line"
    aria-label="Fusion Queensland"
  >
    <div class="max-w-6xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between gap-4">
      <a href="#top" class="flex items-center gap-3 no-underline group">
        <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" class="shrink-0">
          <circle cx="15" cy="15" r="13.5" fill="none" stroke="#731e32" stroke-width="2"></circle>
          <circle cx="15" cy="15" r="8.5" fill="none" stroke="#731e32" stroke-width="2"></circle>
          <circle cx="15" cy="15" r="3.6" fill="#f4c66a"></circle>
        </svg>
        <span class="flex flex-col leading-none">
          <span class="font-display font-black text-lg text-eucalyptus uppercase tracking-tight">
            Fusion <span class="text-maroon">Queensland</span>
          </span>
          <span class="text-[11px] font-medium text-eucalyptus/70 tracking-wide mt-0.5">
            A different kind of politics
          </span>
        </span>
      </a>
      <nav class="hidden lg:flex items-center gap-4" aria-label="Sections">
        {
          nav.slice(1, 6).map((item) => (
            <a
              href={item.href}
              class="font-mono text-[11px] uppercase tracking-widest text-eucalyptus/70 hover:text-maroon transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <BrutalButton href="#specimen" variant="primary" size="sm">Join the party</BrutalButton>
    </div>
  </header>

  <main id="main-content" class="bg-ivory text-eucalyptus">
    <!-- ═══ COVER ═══ -->
    <section id="top" class="border-b border-warm-line">
      <div
        class="max-w-6xl mx-auto px-4 md:px-8 pt-16 pb-14 grid lg:grid-cols-[1.15fr_0.85fr] gap-12 items-end"
      >
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-maroon mb-6">
            Fusion Queensland · Internal reference · v1.0
          </p>
          <h1
            class="font-display font-black leading-[0.92] tracking-[-0.02em] text-[clamp(3rem,9vw,6.5rem)]"
          >
            Design<br />system
          </h1>
          <p class="text-lg text-eucalyptus/75 max-w-2xl leading-relaxed mt-6">
            The binding system for everything Fusion Queensland makes. Maroon, gold and ivory on a
            light canvas, rendered through the same components, type and accessibility rules as
            every other branch.
          </p>
          <div
            class="flex flex-wrap gap-x-10 gap-y-3 mt-8 font-mono text-[10px] uppercase tracking-widest text-eucalyptus/50"
          >
            <div>Status<br /><span class="text-eucalyptus">v1.0 · Active</span></div>
            <div>Updated<br /><span class="text-eucalyptus">2026</span></div>
            <div>Foundation<br /><span class="text-eucalyptus">Shared with Victoria</span></div>
          </div>
        </div>

        <div class="bg-maroon text-ivory rounded-sm p-8 md:p-10 shadow-brutal-lg qld-on-dark">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-gold mb-4">
            Our messaging
          </p>
          <p class="font-display font-black text-3xl md:text-4xl leading-[1.02]">
            A better future for Queensland
          </p>
          <div class="h-px bg-gold/40 my-6"></div>
          <p class="text-ivory/75 text-sm leading-relaxed">
            Maroon establishes the Queensland connection without tropical cliché. Gold and ivory
            keep it friendly rather than institutional.
          </p>
        </div>
      </div>

      <!-- Foundation strip -->
      <div class="max-w-6xl mx-auto px-4 md:px-8 pb-10">
        <div
          class="grid grid-cols-2 md:grid-cols-4 rounded-sm overflow-hidden border border-warm-line"
        >
          {
            foundation.map((c) => (
              <div
                class="p-5 md:p-6"
                style={`background:${c.hex}; color:${c.text === 'light' ? '#FFF7EC' : '#233D3A'};`}
              >
                <p class="font-mono text-[10px] uppercase tracking-widest opacity-70">{c.hex}</p>
                <p class="font-display font-black text-xl mt-2">{c.name}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ QUICK NAV ═══ -->
    <nav
      class="sticky top-16 z-40 bg-ivory/95 backdrop-blur border-b border-warm-line overflow-x-auto"
      aria-label="Quick navigation"
    >
      <div class="max-w-6xl mx-auto flex items-center gap-1 px-4 md:px-8 py-2">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="px-3 py-2 font-mono text-[10px] uppercase tracking-widest text-eucalyptus/60 hover:text-maroon transition-colors whitespace-nowrap"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- ═══ 01 PRINCIPLES ═══ -->
    <section id="principles" class="px-4 md:px-8 py-16 md:py-20 border-b border-warm-line">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
          <span class="font-mono text-xs text-maroon tracking-widest">01</span>
          <span class="h-px flex-1 bg-warm-line"></span>
        </div>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-12 max-w-3xl">
          Four principles that decide everything else
        </h2>
        <div class="divide-y divide-warm-line border-t border-warm-line">
          {
            principles.map((p) => (
              <div class="grid md:grid-cols-[120px_1fr] gap-4 md:gap-10 py-8">
                <span class="font-mono text-3xl md:text-4xl text-gold-deep leading-none">
                  {p.n}
                </span>
                <div class="max-w-3xl">
                  <h3 class="font-display font-black text-2xl md:text-3xl mb-3">{p.title}</h3>
                  <p class="text-eucalyptus/70 leading-relaxed">{p.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ 02 COLOUR ═══ -->
    <section id="colour" class="px-4 md:px-8 py-16 md:py-20 border-b border-warm-line">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
          <span class="font-mono text-xs text-maroon tracking-widest">02</span>
          <span class="h-px flex-1 bg-warm-line"></span>
        </div>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-3">Colour</h2>
        <p class="text-eucalyptus/70 max-w-2xl leading-relaxed mb-12">
          Four foundation colours carry the identity. Supporting tones are functional and stay
          subordinate. Nothing here is decorative: each colour has one job.
        </p>

        <p class="font-mono text-[10px] uppercase tracking-widest text-eucalyptus/45 mb-4">
          Foundation
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
          {
            foundation.map((c) => (
              <div class="rounded-sm overflow-hidden border border-warm-line">
                <div class="h-36" style={`background:${c.hex};`} />
                <div class="bg-paper p-4">
                  <p class="font-display font-black text-xl">{c.name}</p>
                  <p class="font-mono text-[11px] text-eucalyptus/55 mt-0.5">{c.hex}</p>
                  <p class="text-xs text-eucalyptus/60 mt-2 leading-snug">{c.role}</p>
                </div>
              </div>
            ))
          }
        </div>

        <p class="font-mono text-[10px] uppercase tracking-widest text-eucalyptus/45 mb-4">
          Supporting
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-14">
          {
            supporting.map((c) => (
              <div>
                <div
                  class="h-16 rounded-sm border border-warm-line"
                  style={`background:${c.hex};`}
                />
                <p class="text-sm font-bold mt-2">{c.name}</p>
                <p class="font-mono text-[10px] text-eucalyptus/50">{c.hex}</p>
                <p class="text-[11px] text-eucalyptus/55 mt-0.5 leading-snug">{c.role}</p>
              </div>
            ))
          }
        </div>

        <div class="grid lg:grid-cols-2 gap-10">
          <!-- Approved pairs -->
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-eucalyptus/45 mb-4">
              Approved pairs · measured
            </p>
            <div class="border border-warm-line rounded-sm divide-y divide-warm-line">
              {
                approvedPairs.map((p) => (
                  <div class="flex items-center gap-4 px-4 py-3">
                    <span
                      class="w-8 h-8 rounded-sm border border-warm-line shrink-0"
                      style={`background:${p.a};`}
                      aria-hidden="true"
                    />
                    <span class="text-sm flex-1">{p.pair}</span>
                    <span class="font-mono text-xs text-eucalyptus/70">{p.ratio}</span>
                    <span class="font-mono text-[10px] uppercase tracking-widest text-gold-deep w-10 text-right">
                      {p.verdict}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Banned pairs -->
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-eucalyptus/45 mb-4">
              Never pair · measured
            </p>
            <div
              class="border border-bottlebrush/40 rounded-sm divide-y divide-bottlebrush/30 bg-bottlebrush/5"
            >
              {
                bannedPairs.map((p) => (
                  <div class="flex items-center gap-4 px-4 py-3">
                    <span class="w-8 h-8 rounded-sm border border-warm-line shrink-0 relative overflow-hidden">
                      <span class="absolute inset-0" style={`background:${p.a};`} />
                      <span
                        class="absolute inset-0"
                        style={`background:${p.b}; mix-blend-mode:multiply;`}
                      />
                    </span>
                    <span class="text-sm flex-1">{p.pair}</span>
                    <span class="font-mono text-xs text-bottlebrush">{p.ratio}</span>
                  </div>
                ))
              }
            </div>
            <p class="text-xs text-eucalyptus/60 mt-4 leading-relaxed">
              Gold is a surface, not a text colour. On ivory it measures 1.51:1. Use it for fills,
              rules and highlights; use Ochre when the gold family has to carry type.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 02b COLOUR DECISION RULES ═══ -->
    <section id="rules" class="px-4 md:px-8 py-16 md:py-20 border-b border-warm-line bg-paper">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
          <span class="font-mono text-xs text-maroon tracking-widest">02b</span>
          <span class="h-px flex-1 bg-warm-line"></span>
        </div>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-3">Colour decision rules</h2>
        <p class="text-eucalyptus/70 max-w-2xl leading-relaxed mb-12">
          One answer per situation. Ambiguity causes drift, and drift is what a design system exists
          to prevent.
        </p>

        <div class="border-t border-warm-line">
          {
            colourRules.map((row) => (
              <div class="grid md:grid-cols-[200px_1fr_160px] gap-4 md:gap-8 py-6 border-b border-warm-line items-center">
                <div>
                  <p class="font-bold">{row.situation}</p>
                  <p class="text-xs text-eucalyptus/55 mt-0.5">{row.examples}</p>
                </div>
                <p class="text-sm text-eucalyptus/70 leading-relaxed">{row.why}</p>
                <div class="flex items-center gap-3">
                  <span class="w-4 h-4 rounded-full shrink-0" style={`background:${row.hex};`} />
                  <span class="font-mono text-xs" style={`color:${row.hex};`}>
                    {row.name}
                  </span>
                  <span class="font-mono text-[10px] text-eucalyptus/40">{row.hex}</span>
                </div>
              </div>
            ))
          }
        </div>

        <div class="grid md:grid-cols-2 gap-4 mt-10">
          <BrutalCard shadow="gold" padding="lg">
            <p class="font-mono text-[10px] uppercase tracking-widest text-gold-deep mb-3">
              Hover rule
            </p>
            <p class="text-sm text-eucalyptus/75 leading-relaxed">
              Hover brightens the fill and adds a warm shadow. Never darken on hover. Press scales
              to <code class="font-mono text-maroon">0.97</code>.
            </p>
          </BrutalCard>
          <BrutalCard shadow="bottlebrush" padding="lg">
            <p class="font-mono text-[10px] uppercase tracking-widest text-bottlebrush mb-3">
              Gold is not for
            </p>
            <ul class="text-sm text-eucalyptus/75 space-y-1.5">
              <li>✕ Type on ivory or paper</li>
              <li>✕ Body copy of any size</li>
              <li>✕ Photo washes or full-page backgrounds</li>
              <li>✕ Borders that need to be seen at 1px on ivory</li>
            </ul>
          </BrutalCard>
        </div>
      </div>
    </section>

    <!-- ═══ 03 TYPOGRAPHY ═══ -->
    <section id="type" class="px-4 md:px-8 py-16 md:py-20 border-b border-warm-line">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
          <span class="font-mono text-xs text-maroon tracking-widest">03</span>
          <span class="h-px flex-1 bg-warm-line"></span>
        </div>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-3">Typography</h2>
        <p class="text-eucalyptus/70 max-w-2xl leading-relaxed mb-12">
          Three families, three jobs, shared with every branch. Queensland's divergence is casing:
          display type is sentence case, which reads warm rather than shouted. Caps are reserved for
          short labels and data.
        </p>

        <div class="space-y-4 mb-14">
          <div class="border border-warm-line rounded-sm p-6 md:p-8 bg-paper">
            <p class="font-mono text-[10px] uppercase tracking-widest text-maroon mb-1">
              Display · Barlow Condensed Black
            </p>
            <p class="text-xs text-eucalyptus/50 mb-6">
              Sentence case · tracking -0.01em · clamp fluid
            </p>
            <p class="font-display font-black leading-[0.98] text-[clamp(2.25rem,6vw,4.25rem)]">
              A better future for Queensland
            </p>
          </div>

          <div class="border border-warm-line rounded-sm p-6 md:p-8 bg-paper">
