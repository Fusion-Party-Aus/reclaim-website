---
/**
 * Developer Messages Component
 * Injects hidden messages into the DOM for curious developers
 * (Astro strips HTML comments, so we inject them client-side)
 */
---

<script>
  // Inject developer message at the top of <body>
  const topMessage = `
╔═══════════════════════════════════════════════════════════════╗
║  Hey there, code inspector! 👋                                ║
║                                                                ║
║  If you're reading this, you care about how things work.      ║
║  That's EXACTLY the kind of person we need in democracy.      ║
║                                                                ║
║  WHAT YOU'RE LOOKING AT:                                      ║
║  • Built with Astro 5.x (fast, modern SSG)                   ║
║  • Zero tracking scripts (check your network tab)            ║
║  • Open source: github.com/Fusion-Party-Aus                  ║
║  • Neo-brutalist design system (bold, honest, accessible)    ║
║                                                                ║
║  COMPARE THIS TO MAJOR PARTIES:                               ║
║  • Their sites: 15+ ad tracking networks                     ║
║  • Our site: ZERO. We mean it.                               ║
║                                                                ║
║  WANT TO HELP BUILD THIS?                                     ║
║  We're hiring developers who care about democracy.            ║
║  Email: tech@fusionparty.org.au                              ║
║                                                                ║
║  EASTER EGG:                                                  ║
║  Try the Konami Code: ↑ ↑ ↓ ↓ ← → ← → B A                   ║
║  (Yes, really. Democracy can be fun.)                        ║
║                                                                ║
║  P.S. This entire site is built by volunteers.               ║
║       No ad agencies. No consultants. Just people who care.  ║
╚═══════════════════════════════════════════════════════════════╝
`

  const bottomMessage = `
╔════════════════════════════════════════════════════════════╗
║  STILL HERE? Here are some interesting stats:              ║
║                                                             ║
║  Total Lines of Code: ~12,000                              ║
║  Components: 11 reusable building blocks                   ║
║  Test Coverage: 91% (we actually test our code)            ║
║  Build Time: < 30 seconds                                  ║
║  Load Time: ~1.2s (vs 8s+ for major party sites)          ║
║                                                             ║
║  Tech Stack:                                               ║
║  • Astro 5.x - Modern SSG framework                       ║
║  • TypeScript - Type-safe code                            ║
║  • Sanity.io - Headless CMS                               ║
║  • Tailwind CSS - Utility-first styling                   ║
║  • Vitest - Fast unit testing                             ║
║  • GitHub Actions - CI/CD pipeline                        ║
║                                                             ║
║  We believe democracy should be:                           ║
║  • Open source (like this site)                           ║
║  • Fast (like this site)                                  ║
║  • Accessible (like this site)                            ║
║  • Honest (like this site)                                ║
║                                                             ║
║  Want the full annotated manifesto with policy team        ║
║  notes and research citations? Enter the Konami Code.      ║
║                                                             ║
║  Found something cool? Share it:                           ║
║  #FusionParty #OpenSourcePolitics #VicVotes2026           ║
╚════════════════════════════════════════════════════════════╝
`

  // Also log to console with styling
  console.log('%c' + topMessage, 'color: #D428D4; font-family: monospace; font-size: 12px;')

  console.log(
    '%c🎮 EASTER EGG HINT',
    'color: #00DDB8; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
  )
  console.log(
    '%cTry the Konami Code: ↑ ↑ ↓ ↓ ← → ← → B A',
    'color: #4A7AEB; font-size: 14px; font-weight: bold;'
  )

  console.log(
    '%c📊 TRACKING CHECK',
    'color: #D428D4; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
  )
  console.log(
    '%cGo to Network tab → Filter by "track" or "analytics"\nMajor parties: 15+ scripts\nUs: ZERO',
    'color: #00DDB8; font-size: 13px;'
  )

  console.log(
    '%c💻 OPEN SOURCE',
    'color: #4A7AEB; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
  )
  console.log(
    '%cgithub.com/Fusion-Party-Aus/reclaim-website-poc',
    'color: #D428D4; font-size: 13px; text-decoration: underline;'
  )

  console.log(
    '%c🔍 INSPECT THE CODE',
    'color: #00DDB8; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
  )
  console.log(
    "%cEvery line is open for inspection. No minification tricks.\nNo obfuscation. No secrets. That's democracy.",
    'color: #4A7AEB; font-size: 13px;'
  )

  // Add ASCII art logo
  const asciiLogo = `
  ███████╗██╗   ██╗███████╗██╗ ██████╗ ███╗   ██╗
  ██╔════╝██║   ██║██╔════╝██║██╔═══██╗████╗  ██║
  █████╗  ██║   ██║███████╗██║██║   ██║██╔██╗ ██║
  ██╔══╝  ██║   ██║╚════██║██║██║   ██║██║╚██╗██║
  ██║     ╚██████╔╝███████║██║╚██████╔╝██║ ╚████║
  ╚═╝      ╚═════╝ ╚══════╝╚═╝ ╚═════╝ ╚═╝  ╚═══╝

           PARTY OF THE PEOPLE
           Victoria 2026
`

  console.log('%c' + asciiLogo, 'color: #D428D4; font-weight: bold; font-family: monospace;')

  // Add hidden properties to window for developers to discover
  ;(window as any).__FUSION__ = {
    version: '1.0.0',
    built: new Date().toISOString(),
    framework: 'Astro 5.x',
    tracking: 'NONE',
    openSource: 'github.com/Fusion-Party-Aus',
    konamiCode: '↑ ↑ ↓ ↓ ← → ← → B A',
    message: 'Democracy needs developers like you. Join us!',
    email: 'tech@fusionparty.org.au',
    stats: {
      components: 11,
      tests: 41,
      coverage: '91%',
      buildTime: '<30s',
      loadTime: '~1.2s',
    },
  }

  console.log(
    '%c📦 DEVELOPER API',
    'color: #D428D4; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
  )
  console.log('%cType `window.__FUSION__` to see site metadata', 'color: #00DDB8; font-size: 13px;')

  // Fun console methods
  ;(window as any).fusionStats = () => {
    console.table({
      'Total Components': 11,
      'Test Files': 41,
      Coverage: '91%',
      'Build Time': '<30s',
      'Page Load': '~1.2s',
      'Tracking Scripts': 0,
      'Open Source': '✓',
    })
  }
  ;(window as any).compareToPoliticians = () => {
    console.table({
      Metric: ['Tracking Scripts', 'Open Source', 'Load Time', 'Test Coverage', 'Transparency'],
      Fusion: ['0', 'Yes', '1.2s', '91%', '100%'],
      'Major Parties': ['15+', 'No', '8s+', '?', '?'],
    })
  }

  console.log(
    '%c🎯 TRY THESE COMMANDS',
    'color: #4A7AEB; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
  )
  console.log('%cwindow.fusionStats()', 'color: #00DDB8; font-size: 13px; font-family: monospace;')
  console.log(
    '%cwindow.compareToPoliticians()',
    'color: #00DDB8; font-size: 13px; font-family: monospace;'
  )
  console.log('%cwindow.__FUSION__', 'color: #00DDB8; font-size: 13px; font-family: monospace;')

  // Easter egg hint in console after 5 seconds
  setTimeout(() => {
    console.log(
      '%c🎮 Psst... try the Konami Code on this page',
      'color: #D428D4; font-size: 14px; font-style: italic;'
    )
  }, 5000)

  // Track if they check the network tab
  if (performance && performance.getEntriesByType) {
    const resources = performance.getEntriesByType('resource')
    const trackingScripts = resources.filter((r: any) =>
      /track|analytics|google-analytics|facebook|pixel|tag|gtm/i.test(r.name)
    )

    if (trackingScripts.length === 0) {
      console.log(
        '%c✅ ZERO TRACKING SCRIPTS',
        'color: #00DDB8; font-size: 16px; font-weight: bold; background: #000; padding: 8px;'
      )
      console.log(
        "%cWe told you. Major parties track you. We don't.",
        'color: #4A7AEB; font-size: 13px;'
      )
    }
  }

  // Add a fun property that developers might discover
  Object.defineProperty(window, 'democracy', {
    get() {
      console.log(
        '%c🗳️  Democracy is a verb, not a noun.',
        'color: #D428D4; font-size: 16px; font-weight: bold;'
      )
      console.log(
        '%cJoin us in building it: fusionparty.org.au',
        'color: #00DDB8; font-size: 14px;'
      )
      return {
        type: 'participatory',
        status: 'under construction',
        help: 'democracy.build()',
      }
    },
  })
  ;(window as any).democracy = {
    build() {
      console.log(
        '%c🏗️  Building democracy...',
        'color: #4A7AEB; font-size: 14px; font-weight: bold;'
      )
      console.log('%cStep 1: Get curious (✓ You did this!)', 'color: #00DDB8; font-size: 13px;')
      console.log(
        '%cStep 2: Get involved → fusionparty.org.au/get-involved',
        'color: #00DDB8; font-size: 13px;'
      )
      console.log(
        '%cStep 3: Spread the word → fusionparty.org.au/convince-your-friends',
        'color: #00DDB8; font-size: 13px;'
      )
      console.log(
        '%cStep 4: Vote Fusion in 2026! 🗳️',
        'color: #D428D4; font-size: 13px; font-weight: bold;'
      )
    },
  }
</script>

<style>
  /* This component has no visual output */
</style>
