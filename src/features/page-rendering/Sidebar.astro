---
interface SidebarChild {
  id: string
  title: string
}

interface SidebarSection {
  id: string
  title: string
  children?: SidebarChild[]
}

interface Props {
  sections: SidebarSection[]
  page: string
}

const { sections, page } = Astro.props

import { Icon } from 'astro-icon/components'
import { BrutalButton } from '@/components/ui'
---

<aside class="sidebar hidden lg:block">
  <div class="sticky-sidebar">
    <div
      class="bg-grey-dark border border-white/10 rounded-sm p-5"
      style="border-top: 2px solid var(--branch-primary, #D428D4);"
    >
      <div class="mb-5 pb-3 border-b border-white/10">
        <h3 class="text-xl font-display font-black text-magenta uppercase">Jump To</h3>
      </div>

      <nav class="space-y-3" aria-label="On this page">
        {
          sections.map((section) => (
            <div>
              <a
                href={`#${section.id}`}
                data-nav={section.id}
                class="block py-2 px-3 rounded-sm font-display font-black uppercase bg-mint text-black hover:bg-mint-dark transition-colors text-sm tracking-wide"
              >
                {section.title}
              </a>
              {section.children && section.children.length > 0 && (
                <div class="ml-3 mt-1 space-y-1 border-l-2 border-magenta pl-2">
                  {section.children.map((child) => (
                    <a
                      href={`#${child.id}`}
                      data-nav={child.id}
                      class="block py-2 px-2 font-bold text-sm uppercase tracking-wide text-fg hover:text-mint hover:bg-white/10 transition-all"
                    >
                      {child.title}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </nav>

      <div class="mt-6 pt-5 border-t border-white/10">
        <h4 class="text-sm font-display font-black text-magenta mb-3 uppercase tracking-wider">
          Quick Links
        </h4>
        <div class="space-y-2">
          <a
            href="/policies"
            class="flex items-center gap-2 py-2 px-3 rounded-sm font-bold text-xs border border-white/10 bg-grey-dark hover:border-mint/40 hover:text-mint transition-all"
          >
            <Icon name="mdi:file-document" class="w-4 h-4" />
            All Policies
          </a>
          <a
            href="/get-involved"
            class="flex items-center gap-2 py-2 px-3 rounded-sm font-bold text-xs border border-white/10 bg-grey-dark hover:border-magenta/40 hover:text-magenta transition-all"
          >
            <Icon name="mdi:hand-heart" class="w-4 h-4" />
            Get Involved
          </a>
          <a
            href="https://fusionparty.org.au/donate"
            class="flex items-center gap-2 py-2 px-3 rounded-sm font-bold text-sm bg-accent-deep text-fg hover:bg-magenta-darker transition-colors"
          >
            <Icon name="mdi:currency-usd" class="w-4 h-4" />
            Donate
          </a>
        </div>
      </div>

      <div class="mt-5 p-3 rounded-sm bg-magenta/10 border-l-2 border-magenta">
        <p class="font-black text-xs uppercase text-magenta">No Corporate Donations. Ever.</p>
      </div>
    </div>
  </div>
</aside>

<script>
  const navLinks = Array.from(document.querySelectorAll('.sidebar [data-nav]'))
  const sectionIds = navLinks
    .map((link) => link.getAttribute('data-nav'))
    .filter((id): id is string => Boolean(id))
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el))

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      const isActive = link.getAttribute('data-nav') === id
      link.classList.toggle('is-active', isActive)
    })
  }

  const getActiveSection = () => {
    const offset = 120
    let currentId = null
    sections.forEach((section) => {
      const top = section.getBoundingClientRect().top
      if (top - offset <= 0) {
        currentId = section.id
      }
    })
    if (currentId) setActive(currentId)
  }

  const onScroll = () => window.requestAnimationFrame(getActiveSection)
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('resize', onScroll)
  window.addEventListener('load', onScroll)
  getActiveSection()
</script>

<style>
  .sidebar a:hover {
    transform: translateX(3px) !important;
  }
  .sticky-sidebar {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }
  .sidebar a.is-active {
    background-color: var(--branch-accent-deep, #234080) !important;
    color: var(--branch-ink, #ffffff) !important;
  }
  .sidebar a.is-active[href^='#'] {
    transform: translateX(2px) !important;
  }
</style>
