---
import { Icon } from 'astro-icon/components'

interface Props {
  heading: string
  description: string
  buttonText: string
  footerText: string
}

const { heading, description, buttonText, footerText } = Astro.props
---

<section class="bg-surface-base border-t border-white/10 py-20 md:py-28 px-6 md:px-10 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl">
      <h2
        class="font-display font-black uppercase text-white mb-6"
        style="font-size: clamp(2.5rem, 4vw + 0.75rem, 4.5rem); line-height: 1; letter-spacing: -0.02em;"
      >
        {heading}
      </h2>

      <p
        class="font-bold text-white/70 mb-10"
        style="font-size: clamp(1.1rem, 1.5vw + 0.4rem, 1.375rem); line-height: 1.55; max-width: 55ch;"
      >
        {description}
      </p>

      <a
        href="https://www.fusionparty.org.au/join"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-magenta text-white font-black uppercase px-8 py-5 rounded-sm hover:scale-[1.02] transition-all duration-150 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-yellow"
        style="font-size: 1.125rem; letter-spacing: 0.06em;"
      >
        {buttonText}
        <Icon name="mdi:arrow-right" class="w-5 h-5 shrink-0" />
      </a>

      <p class="text-xs font-bold text-white/60 mt-5">
        {footerText}
      </p>
    </div>
  </div>
</section>
