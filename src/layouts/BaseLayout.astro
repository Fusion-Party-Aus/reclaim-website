---
import { SEO } from 'astro-seo'
import { getSiteConfig } from '../lib/sanity'
import { KonamiCode } from '@/features/engagement'
import { VisualEditing } from '@sanity/astro/visual-editing'
import { stegaClean } from '@sanity/client/stega'
import { Icon } from 'astro-icon/components'
import '../styles/editorial.css'

interface Props {
  title: string
  description?: string
  /** Path to the OG/Twitter card image, relative to the site root (e.g. '/og/policies.png'). */
  image?: string
  imageAlt?: string
  type?: 'website' | 'article'
  noindex?: boolean
  publishedAt?: string
  modifiedAt?: string
}

const {
  title: rawTitle,
  description:
    rawDescription = 'Fusion Party Victoria — Reignite Democracy. Explore our policies, research and practical plans for housing, transport, integrity and civil liberties.',
  image = '/og/default.png',
  imageAlt = 'Fusion Party Victoria — Reignite Democracy.',
  type = 'website',
  noindex = false,
  publishedAt,
  modifiedAt,
} = Astro.props

// Sanity stega-encodes editable strings with invisible characters; strip them
// before they land in <title>/<meta> where they'd otherwise leak into the DOM.
const title = stegaClean(rawTitle)
const description = stegaClean(rawDescription)
const siteConfig = await getSiteConfig()
const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true'

const siteUrl = Astro.site ?? new URL('https://vic.fusionparty.org.au')
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteUrl).href
const canonicalImage = new URL(stegaClean(image), siteUrl)
const utilityPages = new Set([
  '/404',
  '/403',
  '/500',
  '/503',
  '/offline',
  '/login',
  '/slides',
  '/letterhead',
  '/design-system',
  '/no-results',
  '/coming-soon',
])
const isUtilityPage = utilityPages.has(Astro.url.pathname.replace(/\/$/, ''))
const shouldNoindex = noindex || isUtilityPage || visualEditingEnabled
const breadcrumbs = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((segment, index, segments) => ({
    '@type': 'ListItem',
    position: index + 2,
    name:
      index === segments.length - 1
        ? title.split(' | ')[0]
        : segment.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
    item: new URL('/' + segments.slice(0, index + 1).join('/'), siteUrl).href,
  }))
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl.href },
    ...breadcrumbs,
  ],
}
const organizationId = 'https://vic.fusionparty.org.au/#organization'
const nationalOrganizationId = 'https://fusionparty.org.au/#organization'
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: 'Fusion Party Victoria',
  alternateName: ['Fusion Victoria', 'Fusion Party VIC'],
  url: 'https://vic.fusionparty.org.au/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://vic.fusionparty.org.au/logo.png',
  },
  description:
    'The Victorian branch of Fusion Party Australia, publishing current Victorian policy, research, news and analysis.',
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Victoria, Australia',
  },
  parentOrganization: {
    '@type': 'Organization',
    '@id': nationalOrganizationId,
    name: 'Fusion Party Australia',
    url: 'https://fusionparty.org.au/',
  },
  sameAs: [
    'https://www.facebook.com/FusionPartyAus',
    'https://www.instagram.com/fusionpartyaus',
    'https://www.youtube.com/c/fusionpartyaus',
    'https://mastodon.au/@FusionPartyAus',
  ],
}
const webSiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://vic.fusionparty.org.au/#website',
  url: 'https://vic.fusionparty.org.au/',
  name: 'Fusion Party Victoria',
  inLanguage: 'en-AU',
  publisher: { '@id': organizationId },
}
---

<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalUrl}
      noindex={shouldNoindex}
      openGraph={{
        basic: {
          title,
          type,
          image: canonicalImage.href,
          url: canonicalUrl,
        },
        optional: {
          description,
          siteName: 'Fusion Party Victoria',
          locale: 'en_AU',
        },
        image: {
          url: canonicalImage.href,
          width: 1200,
          height: 630,
          alt: imageAlt,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: canonicalImage.href,
        imageAlt,
      }}
    />
    {
      type === 'article' && publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    {
      type === 'article' && modifiedAt && (
        <meta property="article:modified_time" content={modifiedAt} />
      )
    }
    {
      breadcrumbs.length > 0 && !shouldNoindex && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="icon" href="/icons/favicon.ico" />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical entity graph. Keep this explicit so policy/article publisher IDs resolve
         to a stable Victorian organisation rather than an inferred or historical entity. -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationStructuredData).replace(/</g, '\\u003c')}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(webSiteStructuredData).replace(/</g, '\\u003c')}
    />

    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#D428D4" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Fusion Party Victoria" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Fusion Party Victoria"
      href="/rss.xml"
    />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://analytics.fusionparty.org.au/js/pa-HF_gBIYZhzFUGLXpsvgWh.js"
    ></script>
    <script is:inline src="/plausible-init.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class:list={{ 'public-editorial': !isUtilityPage }}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#234080] focus:text-white focus:px-4 focus:py-2 focus:border focus:border-white focus:font-black focus:uppercase focus:text-sm"
    >
      Skip to main content
    </a>
    <slot />

    <!-- Site-wide Secret Features -->
    <KonamiCode konami={siteConfig?.konamiCode} />

    <VisualEditing enabled={visualEditingEnabled} />

    <!-- PWA Service Worker Registration & Install Prompt -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js')
            .then((_registration) => {
              // console.log('Service Worker registered:', registration)
            })
            .catch((_error) => {
              // console.log('Service Worker registration failed:', error)
            })
        })
      }

      // PWA Install Prompt
      let deferredPrompt
      const installPrompt = document.getElementById('pwa-install-prompt')
      const installButton = document.getElementById('pwa-install')
      const closeButton = document.getElementById('pwa-close')

      window.addEventListener('beforeinstallprompt', (e) => {
        // Prevent the mini-infobar from appearing
        e.preventDefault()
        deferredPrompt = e

        // Show our custom install prompt after a short delay
        setTimeout(() => {
          if (installPrompt) {
            installPrompt.classList.remove('hidden')
            installPrompt.style.animation = 'slideInRight 0.5s ease-out'
          }
        }, 3000) // Show after 3 seconds
      })

      if (installButton) {
        installButton.addEventListener('click', async () => {
          if (!deferredPrompt) return

          deferredPrompt.prompt()
          const { outcome: _outcome } = await deferredPrompt.userChoice

          // console.log(`User response: ${outcome}`)
          deferredPrompt = null

          if (installPrompt) {
            installPrompt.classList.add('hidden')
          }
        })
      }

      if (closeButton) {
        closeButton.addEventListener('click', () => {
          if (installPrompt) {
            installPrompt.classList.add('hidden')
          }
        })
      }

      // Hide prompt if already installed
      window.addEventListener('appinstalled', () => {
        // console.log('PWA installed')
        if (installPrompt) {
          installPrompt.classList.add('hidden')
        }
      })
    </script>

    <style is:inline>
      @keyframes slideInRight {
        from {
          opacity: 0;
          transform: translateX(100%);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
    </style>
  </body>
</html>
