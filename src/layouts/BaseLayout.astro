---
import { getSiteConfig } from '../lib/sanity'
import { KonamiCode } from '@/features/engagement'
import { VisualEditing } from '@sanity/astro/visual-editing'
import { stegaClean } from '@sanity/client/stega'

interface Props {
  title: string
  description?: string
}

const {
  title: rawTitle,
  description: rawDescription = 'Fusion Party Victoria - Taking back what they stole.',
} = Astro.props

// Sanity stega-encodes editable strings with invisible characters; strip them
// before they land in <title>/<meta> where they'd otherwise leak into the DOM.
const title = stegaClean(rawTitle)
const description = stegaClean(rawDescription)

const siteConfig = await getSiteConfig()
const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true'
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="icon" href="/icons/favicon.ico" />

    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#D428D4" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Fusion Party Victoria" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-yellow focus:text-black focus:px-4 focus:py-2 focus:border-4 focus:border-black focus:font-black focus:uppercase focus:text-sm"
    >
      Skip to main content
    </a>
    <slot />

    <!-- Site-wide Secret Features -->
    <KonamiCode konami={siteConfig?.konamiCode} />

    <VisualEditing enabled={visualEditingEnabled} />

    <!-- PWA Install Prompt -->
    <div id="pwa-install-prompt" class="fixed bottom-6 right-6 z-50 hidden">
      <div
        class="bg-grey-dark border border-white/10 rounded-sm border-t-2 border-t-magenta p-6 max-w-sm"
      >
        <button
          id="pwa-close"
          class="absolute -top-3 -right-3 w-8 h-8 bg-yellow rounded-full flex items-center justify-center font-black text-lg text-white hover:scale-110 transition-all"
        >
          ✕
        </button>
        <div class="flex items-start gap-4 mb-4">
          <div
            class="w-12 h-12 bg-magenta rounded-sm flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl">📱</span>
          </div>
          <div>
            <h3
              class="text-lg font-black uppercase text-magenta mb-2"
              style="font-family: 'Barlow Condensed', sans-serif;"
            >
              Install Fusion App
            </h3>
            <p class="text-sm font-bold text-white leading-normal">
              Add to your home screen for quick access & offline use!
            </p>
          </div>
        </div>
        <button
          id="pwa-install"
          class="w-full px-4 py-3 bg-magenta text-white rounded-sm font-black uppercase hover:bg-magenta-bright transition-all"
          style="font-family: 'Barlow Condensed', sans-serif;"
        >
          Install Now
        </button>
      </div>
    </div>

    <!-- PWA Service Worker Registration & Install Prompt -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js')
            .then((_registration) => {
              // console.log('Service Worker registered:', registration)
            })
            .catch((_error) => {
              // console.log('Service Worker registration failed:', error)
            })
        })
      }

      // PWA Install Prompt
      let deferredPrompt
      const installPrompt = document.getElementById('pwa-install-prompt')
      const installButton = document.getElementById('pwa-install')
      const closeButton = document.getElementById('pwa-close')

      window.addEventListener('beforeinstallprompt', (e) => {
        // Prevent the mini-infobar from appearing
        e.preventDefault()
        deferredPrompt = e

        // Show our custom install prompt after a short delay
        setTimeout(() => {
          if (installPrompt) {
            installPrompt.classList.remove('hidden')
            installPrompt.style.animation = 'slideInRight 0.5s ease-out'
          }
        }, 3000) // Show after 3 seconds
      })

      if (installButton) {
        installButton.addEventListener('click', async () => {
          if (!deferredPrompt) return

          deferredPrompt.prompt()
          const { outcome: _outcome } = await deferredPrompt.userChoice

          // console.log(`User response: ${outcome}`)
          deferredPrompt = null

          if (installPrompt) {
            installPrompt.classList.add('hidden')
          }
        })
      }

      if (closeButton) {
        closeButton.addEventListener('click', () => {
          if (installPrompt) {
            installPrompt.classList.add('hidden')
          }
        })
      }

      // Hide prompt if already installed
      window.addEventListener('appinstalled', () => {
        // console.log('PWA installed')
        if (installPrompt) {
          installPrompt.classList.add('hidden')
        }
      })
    </script>

    <style is:inline>
      @keyframes slideInRight {
        from {
          opacity: 0;
          transform: translateX(100%) rotate(1deg);
        }
        to {
          opacity: 1;
          transform: translateX(0) rotate(1deg);
        }
      }
    </style>
  </body>
</html>
