---
import { foldedRibbon, ribbonSweep, RIBBON_COLORS } from '@/lib/horizon-ribbons'
interface Props {
  accent?: string
  variant?: 'hero' | 'band' | 'sweep'
  /** Unique within a page when a variant is repeated. */
  id?: string
}
const {
  accent = RIBBON_COLORS.victoriaAccent,
  variant = 'hero',
  id = `horizon-ribbon-${variant}`,
} = Astro.props
const surfaces = variant === 'sweep' ? ribbonSweep(accent) : foldedRibbon(accent)
---

<svg
  class:list={['ribbon', `ribbon--${variant}`]}
  viewBox={variant === 'sweep' ? '0 0 1000 500' : '0 0 1000 1000'}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <defs
    >{
      surfaces.map((surface, index) => (
        <linearGradient
          id={`${id}-${index}`}
          gradientUnits="userSpaceOnUse"
          x1={surface.points[0]}
          y1={surface.points[1]}
          x2={surface.points[2]}
          y2={surface.points[3]}
        >
          {surface.stops.map(([offset, color]) => (
            <stop offset={offset} stop-color={color} />
          ))}
        </linearGradient>
      ))
    }</defs
  >
  <g>{surfaces.map((surface, index) => <path d={surface.path} fill={`url(#${id}-${index})`} />)}</g>
</svg>
<style>
  .ribbon {
    position: absolute;
    pointer-events: none;
    overflow: hidden;
  }
  .ribbon--hero {
    right: -5%;
    top: 0;
    width: 65%;
    height: 100%;
  }
  .ribbon--band {
    right: 0;
    top: 0;
    width: 35%;
    height: 100%;
    opacity: 0.65;
    transform: rotate(180deg);
  }
  .ribbon--sweep {
    right: 0;
    bottom: 0;
    width: 15rem;
    height: 5rem;
    opacity: 0.16;
  }
  @media (max-width: 760px) {
    .ribbon--hero {
      top: auto;
      bottom: 0;
      right: -8%;
      width: 80%;
      height: 48%;
    }
    .ribbon--band {
      width: 65%;
      opacity: 0.25;
    }
    .ribbon--sweep {
      width: 11rem;
      height: 3rem;
    }
  }
</style>
