---
interface Props {
  accent?: string
  variant?: 'hero' | 'band'
}
const { accent = 'var(--fusion-accent)', variant = 'hero' } = Astro.props
---

<svg
  class:list={['ribbon', `ribbon--${variant}`]}
  style={`--ribbon-accent:${accent}`}
  viewBox="0 0 600 900"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path class="ribbon__accent" d="M600 0H443C365 176 367 307 493 437 579 526 566 699 424 900h176V0Z"
  ></path>
  <path class="ribbon__light" d="M600 0h-74c-68 187-50 313 52 419 82 85 68 271-87 481h109V0Z"
  ></path>
  <path class="ribbon__base" d="M600 0h-36c-53 189-29 308 63 394 83 77 75 270-27 506h0V0Z"></path>
</svg>
<style>
  .ribbon {
    position: absolute;
    inset: 0 auto 0 0;
    width: clamp(7rem, 17vw, 16rem);
    height: 100%;
    pointer-events: none;
  }
  .ribbon--hero {
    right: 50%;
    left: auto;
    width: clamp(14rem, 26vw, 30rem);
    transform: translateX(20%);
  }
  .ribbon__accent {
    fill: var(--ribbon-accent);
  }
  .ribbon__light {
    fill: #fff;
  }
  .ribbon__base {
    fill: #32105a;
  }
  .ribbon--band {
    width: 15rem;
    right: 0;
    left: auto;
    opacity: 0.95;
  }
  @media (max-width: 760px) {
    .ribbon--hero {
      top: auto;
      right: 0;
      bottom: 0;
      left: auto;
      width: clamp(9rem, 42vw, 16rem);
      height: 48%;
      transform: none;
    }
  }
</style>
