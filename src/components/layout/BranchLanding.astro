---
import { DEPLOYMENT } from '@/lib/deployment'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { BrutalButton } from '@/components/ui'
import '@/styles/global.css'
interface Props {
  title?: string
  description?: string
}
const {
  title = DEPLOYMENT.tagline,
  description = 'Help shape our policies and build our movement.',
} = Astro.props
---

<BaseLayout title={`${title} | ${DEPLOYMENT.label}`} description={description}>
  <Header />
  <main id="main-content" class="branch-landing max-w-6xl mx-auto px-6 py-20 sm:py-28">
    <p class="text-magenta font-bold mb-6">{DEPLOYMENT.label}</p>
    <h1 class="font-display text-fg text-6xl sm:text-8xl font-black max-w-4xl leading-none">
      {title}
    </h1>
    <p class="text-muted text-xl max-w-2xl mt-8 leading-relaxed">{description}</p>
    <div class="flex flex-wrap gap-4 mt-10">
      <BrutalButton href={DEPLOYMENT.cta.contact} variant="magenta">Get involved</BrutalButton>
      <BrutalButton href="/policies" variant="mint">Explore our policies</BrutalButton>
    </div>
    <slot />
  </main>
  <Footer />
</BaseLayout>
