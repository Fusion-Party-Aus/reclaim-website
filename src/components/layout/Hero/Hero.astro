---
import { DEPLOYMENT } from '@/lib/deployment'
import { Icon } from 'astro-icon/components'

interface Props {
  eyebrow?: string
  title: string
  subtitle?: string
  stats?: Array<{ number: string; label: string }>
  showCTA?: boolean
  compact?: boolean
  bgImage?: string
}

const {
  eyebrow = DEPLOYMENT.label,
  title,
  subtitle,
  stats,
  showCTA = false,
  compact = false,
  bgImage = '/hero.png',
} = Astro.props
---

<header class:list={['editorial-masthead', { 'editorial-masthead-feature': !compact }]}>
  <div class="editorial-shell editorial-hero-grid">
    <div>
      <slot name="breadcrumbs" />
      <p class="editorial-kicker">{eyebrow}</p>
      <h1 class="editorial-title">{title}</h1>
      {subtitle && <p class="editorial-deck">{subtitle}</p>}
      {
        stats?.length && (
          <dl class="home-stats">
            {stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.number}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        showCTA && (
          <div class="home-actions">
            <a class="editorial-action" href="/get-involved">
              Get involved <Icon name="mdi:arrow-right" class="w-4 h-4" />
            </a>
            <a href="/policies">Explore the platform →</a>
          </div>
        )
      }
      <slot />
    </div>
    {
      !compact && bgImage && (
        <figure class="editorial-hero-image" aria-hidden="true">
          <img src={bgImage} alt="" width="960" height="720" loading="eager" fetchpriority="high" />
          <figcaption>{DEPLOYMENT.state} · A better common future</figcaption>
        </figure>
      )
    }
  </div>
</header>
