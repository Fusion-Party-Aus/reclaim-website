---
import { getDocuments } from '@/lib/sanity'
import { Image } from 'astro:assets'
import logoMonoWhite from '@/assets/brand/logo-rings-mono-white.png'

const currentPath = Astro.url.pathname

interface DropdownItem {
  label: string
  href: string
  description?: string
}

interface NavItem {
  label: string
  href?: string
  order: number
  highlight?: boolean
  children?: DropdownItem[]
}

interface Navigation {
  _id: string
  title: string
  mainNav: NavItem[]
  ctaButton: { label: string; href: string; style: string }
  logo: { mainText: string; subText: string; tagline?: string }
}

const navigations = await getDocuments<Navigation>('navigation')
const navigation = navigations[0]

// Ensure all hrefs are root-relative (protect against Sanity entries missing the leading slash)
const ensureRootRelative = (href: string) =>
  href && !href.startsWith('/') && !href.startsWith('http') ? `/${href}` : href

const rawNavItems = navigation?.mainNav?.sort((a, b) => a.order - b.order) || [
  { href: '/', label: 'Home', order: 0 },
  { href: '/about', label: 'About', order: 1 },
  { href: '/policies', label: 'Policies', order: 2 },
  { href: '/vision', label: 'Vision', order: 3 },
]

const navItems = rawNavItems.map((item) => ({
  ...item,
  href: item.href ? ensureRootRelative(item.href) : item.href,
  children: item.children?.map((child) => ({
    ...child,
    href: ensureRootRelative(child.href),
  })),
}))

const ctaButton = navigation?.ctaButton || {
  label: 'Get Involved',
  href: '/get-involved',
  style: 'primary',
}

const logo = navigation?.logo || {
  mainText: 'FUSION',
  subText: 'VICTORIA',
  tagline: 'Reignite Democracy',
}
---

<header class="bg-black sticky top-0 z-50">
  {/* Triple stripe — mirrors hero top edge */}
  <div class="h-1 w-full bg-magenta animate-pulse-gentle"></div>
  <div class="h-0.5 w-full bg-mint"></div>
  <div class="h-px w-full bg-yellow"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      {/* ── Logo ── */}
      <a
        href="/"
        class="flex items-center gap-3 no-underline group shrink-0"
        aria-label="Fusion Party Victoria Home"
      >
        <div class="relative overflow-hidden group-hover:opacity-90 transition-all">
          <Image src={logoMonoWhite} alt="Fusion Party Victoria" class="h-9 w-auto" />
        </div>
        <div class="flex flex-col leading-none">
          <div class="flex items-baseline gap-1">
            <span
              class="font-black text-magenta text-xl md:text-2xl tracking-tighter uppercase"
              style="font-family: 'Barlow Condensed', sans-serif;"
            >
              {logo.mainText}
            </span>
            {
              logo.subText && (
                <span
                  class="font-black text-yellow text-[9px] tracking-wider uppercase bg-black px-1.5 py-0.5 border border-yellow ml-1.5"
                  style="font-family: 'Barlow Condensed', sans-serif;"
                >
                  {logo.subText}
                </span>
              )
            }
          </div>
          <span
            class="text-[9px] font-black text-white tracking-[0.22em] uppercase mt-1 opacity-90"
            style="font-family: 'Barlow', sans-serif;"
          >
            {logo.tagline}
          </span>
        </div>
      </a>

      {/* ── Mobile menu toggle ── */}
      <button
        class="md:hidden text-white px-3 py-2 border border-white/15 rounded-sm bg-black hover:bg-mint hover:text-black cursor-pointer font-black uppercase text-sm transition-all"
        aria-label="Toggle menu"
        id="mobile-menu-toggle"
      >
        <span class="menu-icon text-lg">☰</span>
      </button>

      {/* ── Desktop nav ── */}
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2.5" id="main-nav">
        {
          navItems.map((item) => {
            const hasDropdown = item.children && item.children.length > 0
            const isActive =
              item.href &&
              (currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href)))

            if (hasDropdown) {
              return (
                <div class="nav-dropdown-wrapper relative group">
                  <button
                    class={`nav-link px-3 py-2 text-white font-black text-sm uppercase tracking-wider flex items-center gap-1.5 border-2 border-transparent hover:border-mint hover:bg-white/5 transition-all ${isActive ? 'text-mint' : ''}`}
                    style="font-family: 'Barlow Condensed', sans-serif; background: none; cursor: pointer;"
                  >
                    {item.label}
                    <span class="text-xs dropdown-arrow transition-transform duration-200 group-hover:rotate-180">
                      ▼
                    </span>
                  </button>
                  {/* Dropdown */}
                  <div
                    class="dropdown-menu absolute top-full left-0 pt-2 hidden group-hover:block"
                    style="min-width: 240px; z-index: 100;"
                  >
                    <div class="bg-black border border-white/10 rounded-sm p-1.5 border-t-2 border-t-magenta">
                      {item.children?.map((child) => (
                        <a
                          href={child.href}
                          class="block px-4 py-3 text-white hover:bg-mint hover:text-black transition-all border-b border-white/10 last:border-b-0 font-black uppercase text-xs tracking-wider"
                          style="font-family: 'Barlow Condensed', sans-serif;"
                        >
                          {child.label}
                          {child.description && (
                            <div class="text-[10px] mt-1 opacity-60 font-normal normal-case tracking-normal">
                              {child.description}
                            </div>
                          )}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              )
            }

            return (
              <a
                href={item.href}
                class={`nav-link relative px-3 py-2 font-black text-sm uppercase tracking-wider transition-all border-2 border-transparent hover:border-mint hover:bg-white/5 ${isActive ? 'text-yellow' : 'text-white hover:text-mint'}`}
                style="font-family: 'Barlow Condensed', sans-serif;"
              >
                {item.label}
                {/* Active indicator — thin yellow border on bottom */}
                {isActive && <span class="absolute bottom-0 left-3 right-3 h-1 bg-yellow" />}
              </a>
            )
          })
        }

        {/* CTA Button — solid, high-contrast */}
        <a
          href={ctaButton.href}
          class:list={[
            'ml-4 px-5 py-2 text-sm font-black uppercase rounded-sm transition-all hover:scale-[1.02]',
            ctaButton.style === 'primary' && 'bg-magenta text-white',
            ctaButton.style === 'yellow' && 'bg-yellow text-white',
            ctaButton.style === 'mint' && 'bg-mint text-black',
            !['primary', 'yellow', 'mint'].includes(ctaButton.style) && 'bg-mint text-black',
          ]}
          style="font-family: 'Barlow Condensed', sans-serif;"
        >
          {ctaButton.label}
        </a>
      </nav>
    </div>

    {/* ── Mobile navigation ── */}
    <nav class="mobile-nav hidden" id="mobile-nav">
      <div class="flex flex-col gap-2 py-5 border-t border-white/10 mt-0">
        {
          navItems.map((item) => {
            const hasDropdown = item.children && item.children.length > 0
            const isActive =
              item.href &&
              (currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href)))

            if (hasDropdown) {
              return (
                <div class="mobile-dropdown">
                  <button
                    class="mobile-dropdown-toggle w-full text-left px-4 py-3 font-black uppercase text-sm rounded-sm bg-black text-white border border-white/10 hover:bg-mint hover:text-black transition-all flex justify-between items-center"
                    style="font-family: 'Barlow Condensed', sans-serif;"
                  >
                    {item.label}
                    <span class="text-xs dropdown-arrow">▼</span>
                  </button>
                  <div class="mobile-dropdown-content hidden mt-1.5 ml-4 space-y-1">
                    {item.children?.map((child) => (
                      <a
                        href={child.href}
                        class="block px-4 py-2.5 font-bold text-sm border-l-2 border-mint bg-black text-white hover:bg-mint hover:text-black transition-all"
                        style="font-family: 'Barlow Condensed', sans-serif;"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }

            return (
              <a
                href={item.href}
                class={`block px-4 py-3 font-black uppercase text-sm rounded-sm border transition-all ${
                  isActive
                    ? 'bg-magenta text-white border-transparent'
                    : 'bg-black text-white border-white/10 hover:bg-mint hover:text-black'
                }`}
                style="font-family: 'Barlow Condensed', sans-serif;"
              >
                {item.label}
              </a>
            )
          })
        }
        <a
          href={ctaButton.href}
          class:list={[
            'block px-4 py-3 text-center font-black uppercase text-sm rounded-sm transition-all text-white',
            ctaButton.style === 'primary' ? 'bg-magenta' : 'bg-yellow',
          ]}
          style="font-family: 'Barlow Condensed', sans-serif;"
        >
          {ctaButton.label}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link:hover {
    color: #00ddb8 !important;
  }

  .dropdown-menu {
    animation: dropdownSlide 0.15s ease-out;
  }

  @keyframes dropdownSlide {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav {
    animation: slideDown 0.25s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-dropdown-content {
    animation: slideDown 0.2s ease-out;
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle')
  const mobileNav = document.getElementById('mobile-nav')

  toggle?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden')
  })

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav?.classList.add('hidden')
    })
  })

  document.querySelectorAll('.mobile-dropdown-toggle').forEach((button) => {
    button.addEventListener('click', (e) => {
      e.preventDefault()
      const dropdown = button.nextElementSibling
      dropdown?.classList.toggle('hidden')
      const arrow = button.querySelector('.dropdown-arrow') as HTMLElement | null
      if (arrow) {
        arrow.style.transform = dropdown?.classList.contains('hidden')
          ? 'rotate(0deg)'
          : 'rotate(180deg)'
        arrow.style.transition = 'transform 0.25s ease'
      }
    })
  })

  document.addEventListener('click', (e) => {
    if (!mobileNav?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      mobileNav?.classList.add('hidden')
    }
  })
</script>
