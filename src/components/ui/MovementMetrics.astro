---
interface Metric {
  label: string
  current: number
  goal: number
  icon: string
  color: 'magenta' | 'mint' | 'yellow'
  suffix?: string
  prefix?: string
}

interface Props {
  metrics: Metric[]
  showMotivation?: boolean
  compact?: boolean
  bare?: boolean
}

const { metrics, showMotivation = true, compact = false, bare = false } = Astro.props

const overallProgress = Math.round(
  metrics.reduce((sum, m) => sum + (m.current / m.goal) * 100, 0) / metrics.length
)
---

{
  bare ? (
    /* ─── Bare mode: numbers as structural elements, no card chrome ─── */
    <div style="background: #0F0018;">
      <div class="grid grid-cols-2 lg:grid-cols-4" style="gap: 4px;">
        {metrics.map((metric, index) => {
          const progress = Math.round((metric.current / metric.goal) * 100)
          return (
            <div class="flex flex-col gap-3 px-6 py-8" style="background: #2E004D;">
              <div style="display: flex; align-items: baseline; gap: 0.2rem; flex-wrap: wrap;">
                {metric.prefix && (
                  <span
                    class="font-black text-white"
                    style="font-family: 'Barlow Condensed', sans-serif; font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1;"
                  >
                    {metric.prefix}
                  </span>
                )}
                <span
                  class="font-black leading-none counter"
                  style={`font-family: 'Barlow Condensed', sans-serif; font-size: clamp(3rem, 4.5vw + 0.5rem, 5.5rem); color: #4A7AEB;`}
                  data-target={metric.current}
                  data-delay={index * 80}
                >
                  0
                </span>
                {metric.suffix && (
                  <span
                    class="font-black text-white/60"
                    style="font-size: clamp(0.875rem, 1.5vw, 1.125rem); line-height: 1; align-self: flex-end; padding-bottom: 0.2rem;"
                  >
                    {metric.suffix}
                  </span>
                )}
              </div>

              <p
                class="font-black uppercase text-white/60"
                style="font-size: 0.625rem; letter-spacing: 0.1em;"
              >
                {metric.label}
              </p>

              <div style="margin-top: auto; display: flex; flex-direction: column; gap: 0.35rem;">
                <div style="height: 3px; background: rgba(255,255,255,0.15);">
                  <div
                    class="progress-bar"
                    style="height: 100%; width: 100%; transform: scaleX(0); transform-origin: left; background: #4A7AEB;"
                    data-progress={progress}
                    data-delay={index * 80}
                  />
                </div>
                <span
                  class="font-black text-white/40"
                  style="font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase;"
                >
                  {progress}% of goal
                </span>
              </div>
            </div>
          )
        })}
      </div>
    </div>
  ) : (
    /* ─── Card mode: existing layout, no rotations ─── */
    <div class={`bg-transparent p-0 ${compact ? '' : 'lg:py-6'}`}>
      {/* Header */}
      <div class="text-center mb-8">
        <div class="inline-block bg-magenta px-6 py-3 mb-4 rounded-sm">
          <p class="text-white font-black uppercase text-xl tracking-wide">Building the movement</p>
        </div>

        {!compact && (
          <p class="text-white/80 text-lg font-bold mb-2">
            Every number is a person who said{' '}
            <strong class="text-magenta">enough is enough.</strong>
          </p>
        )}

        <div class="mt-6">
          <div class="flex items-center justify-between text-white mb-2">
            <span class="font-black uppercase text-sm">Overall Progress</span>
            <span
              class="font-black text-magenta text-xl"
              style="font-family: 'Space Mono', monospace;"
            >
              {overallProgress}%
            </span>
          </div>
          <div class="h-2 bg-white/10 rounded-full relative overflow-hidden">
            <div
              class="h-full bg-magenta transition-transform duration-700 ease-out origin-left rounded-full"
              style={`width: 100%; transform: scaleX(${overallProgress / 100});`}
              data-progress-bar
            />
          </div>
        </div>
      </div>

      {/* Metrics Grid */}
      <div
        class={`grid ${compact ? 'md:grid-cols-2' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'} gap-8 md:gap-10 lg:gap-8 px-4 md:px-0`}
      >
        {metrics.map((metric, index) => {
          const progress = Math.round((metric.current / metric.goal) * 100)
          const colorConfigs = {
            magenta: {
              bg: '#2E004D',
              shadow: '#D428D4',
              text: '#FFFFFF',
              iconBg: '#0F0018',
              iconColor: '#D428D4',
            },
            mint: {
              bg: '#2E004D',
              shadow: '#00DDB8',
              text: '#FFFFFF',
              iconBg: '#0F0018',
              iconColor: '#00DDB8',
            },
            yellow: {
              bg: '#2E004D',
              shadow: '#4A7AEB',
              text: '#FFFFFF',
              iconBg: '#0F0018',
              iconColor: '#4A7AEB',
            },
          }
          const config = colorConfigs[metric.color]

          return (
            <div
              class="p-6 rounded-sm transition-all duration-200 hover:-translate-y-1 group relative mx-auto w-full max-w-sm lg:max-w-none"
              style={`background-color: ${config.bg}; border-top: 2px solid ${config.shadow};`}
            >
              <div class="relative z-10 mt-2">
                {/* Icon Badge */}
                <div
                  class="mb-4 inline-block p-3 rounded-sm"
                  style={`background-color: ${config.iconBg};`}
                >
                  <span class="text-3xl md:text-4xl" aria-hidden="true">
                    {metric.icon}
                  </span>
                </div>

                {/* Counter */}
                <div class="mb-4">
                  <div class="flex items-baseline gap-1">
                    {metric.prefix && (
                      <span
                        class="text-lg md:text-xl font-black"
                        style={`color: ${config.text}; font-family: 'Barlow Condensed', sans-serif;`}
                      >
                        {metric.prefix}
                      </span>
                    )}
                    <span
                      class="text-4xl md:text-5xl font-black counter leading-none"
                      style={`color: ${config.text}; font-family: 'Barlow Condensed', sans-serif;`}
                      data-target={metric.current}
                      data-delay={index * 100}
                    >
                      0
                    </span>
                  </div>
                  {metric.suffix && (
                    <span
                      class="text-sm md:text-base font-black block mt-1"
                      style={`color: ${config.text}; font-family: 'Barlow Condensed', sans-serif;`}
                    >
                      {metric.suffix}
                    </span>
                  )}
                </div>

                {/* Label */}
                <div class="border-t border-white/15 pt-3 mt-2">
                  <p
                    class="text-xs md:text-sm font-black uppercase tracking-widest leading-tight mb-2 break-words"
                    style={`color: ${config.text};`}
                  >
                    {metric.label}
                  </p>
                  <p
                    class="text-xs font-bold break-words"
                    style={`color: ${config.text}; opacity: 0.8;`}
                  >
                    Goal: {metric.prefix || ''}
                    {metric.goal.toLocaleString()}
                    {metric.suffix || ''}
                  </p>
                </div>

                {/* Progress Bar */}
                <div class="relative mt-3">
                  <div class="h-1.5 bg-white/15 rounded-full overflow-hidden">
                    <div
                      class="h-full progress-bar"
                      style={`width: 100%; transform: scaleX(0); transform-origin: left; background-color: ${config.text};`}
                      data-progress={progress}
                      data-delay={index * 100}
                    />
                  </div>
                  <span
                    class="text-xs font-black mt-1 block text-right"
                    style={`color: ${config.text};`}
                  >
                    {progress}%
                  </span>
                </div>
              </div>

              {progress >= 90 && (
                <div class="absolute -bottom-3 left-1/2 transform -translate-x-1/2">
                  <div class="bg-yellow text-white px-3 py-1 text-xs font-black uppercase whitespace-nowrap rounded-sm">
                    Almost There!
                  </div>
                </div>
              )}
            </div>
          )
        })}
      </div>

      {showMotivation && (
        <div class="mt-8 text-center">
          <div class="inline-block bg-yellow text-white px-6 py-4 rounded-sm">
            <p class="font-black text-sm md:text-base">
              {overallProgress < 50 && 'Every movement starts somewhere. Join us.'}
              {overallProgress >= 50 &&
                overallProgress < 75 &&
                'Momentum is building. Be part of it.'}
              {overallProgress >= 75 &&
                overallProgress < 90 &&
                "We're gaining speed. Don't miss out."}
              {overallProgress >= 90 && 'This is happening. History is being made.'}
            </p>
          </div>
        </div>
      )}
    </div>
  )
}

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function setCounterFinal(element: HTMLElement, target: number) {
    element.textContent = Math.round(target).toLocaleString()
  }

  function animateCounter(element: HTMLElement, target: number, delay: number) {
    if (prefersReducedMotion) {
      setCounterFinal(element, target)
      return
    }
    setTimeout(() => {
      const duration = 1400
      const steps = 50
      const increment = target / steps
      let current = 0
      const stepDuration = duration / steps
      const timer = setInterval(() => {
        current += increment
        if (current >= target) {
          element.textContent = Math.round(target).toLocaleString()
          clearInterval(timer)
        } else {
          element.textContent = Math.round(current).toLocaleString()
        }
      }, stepDuration)
    }, delay)
  }

  function animateProgressBar(element: HTMLElement, progress: number, delay: number) {
    if (prefersReducedMotion) {
      element.style.transform = `scaleX(${progress / 100})`
      return
    }
    setTimeout(() => {
      element.style.transform = `scaleX(${progress / 100})`
    }, delay)
  }

  let hasAnimated = false

  function initAnimations() {
    if (hasAnimated) return
    hasAnimated = true
    document.querySelectorAll('.counter').forEach((counter) => {
      const target = parseInt(counter.getAttribute('data-target') || '0')
      const delay = parseInt(counter.getAttribute('data-delay') || '0')
      animateCounter(counter as HTMLElement, target, delay)
    })
    document.querySelectorAll('.progress-bar').forEach((bar) => {
      const progress = parseInt(bar.getAttribute('data-progress') || '0')
      const delay = parseInt(bar.getAttribute('data-delay') || '0')
      animateProgressBar(bar as HTMLElement, progress, delay)
    })
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            initAnimations()
            observer.disconnect()
          }
        })
      },
      { threshold: 0.15 }
    )
    const target =
      document.querySelector('.counter')?.closest('section') ||
      document.querySelector('[data-progress-bar]')?.closest('div')
    if (target) observer.observe(target)
  } else {
    initAnimations()
  }
</script>

<style>
  .counter {
    font-variant-numeric: tabular-nums;
  }
  .progress-bar {
    transition: transform 1.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left;
  }
</style>
