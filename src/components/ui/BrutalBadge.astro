---
/**
 * BrutalBadge - Reusable Neo-Brutalist Badge/Tag Component
 *
 * Small labeled tags with brutal styling.
 * Used for categories, tags, labels, etc.
 *
 * @param {string} variant - Color variant: 'magenta' | 'mint' | 'yellow' | 'lavender' | 'black' | 'white'
 * @param {string} size - Badge size: 'sm' | 'md' | 'lg'
 * @param {string} icon - Optional MDI icon name
 * @param {string} class - Additional CSS classes
 */

import { Icon } from 'astro-icon/components'

interface Props {
  variant?: 'magenta' | 'mint' | 'yellow' | 'lavender' | 'black' | 'white'
  size?: 'sm' | 'md' | 'lg'
  icon?: string
  class?: string
}

const { variant = 'magenta', size = 'md', icon, class: className = '' } = Astro.props

// Subtle tinted background + solid text colour + left accent bar — Space Mono label
const variantStyles: Record<string, { text: string; bg: string; border: string }> = {
  magenta: { text: 'text-magenta', bg: 'bg-magenta/10', border: 'border-magenta' },
  mint: { text: 'text-mint', bg: 'bg-mint/10', border: 'border-mint' },
  yellow: { text: 'text-yellow', bg: 'bg-yellow/10', border: 'border-yellow' },
  lavender: { text: 'text-lavender', bg: 'bg-lavender/10', border: 'border-lavender' },
  black: { text: 'text-white', bg: 'bg-white/5', border: 'border-white/30' },
  white: { text: 'text-black', bg: 'bg-black/5', border: 'border-black/30' },
}

// Size styles
const sizeStyles = {
  sm: 'px-2 py-0.5 text-[10px]',
  md: 'px-2.5 py-1 text-xs',
  lg: 'px-3 py-1.5 text-sm',
}

const iconSizes = {
  sm: 'w-3 h-3',
  md: 'w-4 h-4',
  lg: 'w-5 h-5',
}

const v = variantStyles[variant]
---

<span
  class={`
    inline-flex items-center gap-1.5
    ${v.bg} ${v.text}
    ${sizeStyles[size]}
    border-l-2 ${v.border}
    font-bold uppercase tracking-widest
    ${className}
  `}
  style="font-family: 'Space Mono', monospace;"
>
  {icon && <Icon name={icon} class={iconSizes[size]} />}
  <slot />
</span>
