---
/**
 * BrutalCard - Reusable Card Component
 *
 * Default ('surface') is the Reclaim system's primary card: a dark raised
 * panel with a hairline border and a 2px brand-coloured top accent — no
 * heavy border, no glow shadow. Solid-fill variants (magenta/mint/etc) stay
 * available for accent callouts, used sparingly.
 *
 * @param {string} variant - 'surface' (default, dark panel) | 'white' | 'magenta' | 'mint' | 'yellow' | 'lavender' | 'black'
 * @param {string} shadow - Top accent colour, either a named accent ('magenta' | 'mint' | 'yellow' | 'lavender' | 'black' | 'white') or any CSS color
 * @param {string} padding - Padding size: 'sm' | 'md' | 'lg'
 * @param {number} rotation - Rotation in degrees (e.g., -0.5, 1, 2) or 0 for none
 * @param {boolean} hover - Enable hover effect (border brightens slightly)
 * @param {string} class - Additional CSS classes
 * @param {string} id - HTML id attribute
 */

interface Props {
  variant?: 'surface' | 'white' | 'magenta' | 'mint' | 'yellow' | 'lavender' | 'black'
  shadow?: string
  padding?: 'sm' | 'md' | 'lg' | 'xl'
  rotation?: number
  hover?: boolean
  class?: string
  id?: string
  style?: string
}

const {
  variant = 'surface',
  shadow = 'magenta',
  padding = 'md',
  rotation = 0,
  hover = true,
  class: className = '',
  id,
  style: customStyle,
} = Astro.props

// Background colors. 'surface' is the raised panel used everywhere by default.
// Text + hairline colours come from semantic tokens so branch themes repaint them.
const bgColors = {
  surface: 'bg-grey-dark text-fg border border-line',
  white: 'bg-white text-black border border-black/10',
  magenta: 'bg-magenta text-on-primary border border-white/10',
  mint: 'bg-mint text-on-secondary border border-black/10',
  yellow: 'bg-yellow text-on-accent border border-white/10',
  lavender: 'bg-lavender text-on-tertiary border border-white/10',
  black: 'bg-black text-fg border border-white/10',
}

// Padding sizes
const paddingSizes = {
  sm: 'p-4',
  md: 'p-6 md:p-8',
  lg: 'p-8 md:p-10',
  xl: 'p-10 md:p-12',
}

// Named accents resolve to the shared role tokens; anything else (a hex/rgba
// string) passes through, so branch themes can recolour card accents too.
const accentColors: Record<string, string> = {
  magenta: 'var(--color-magenta)',
  mint: 'var(--color-mint)',
  yellow: 'var(--color-yellow)',
  lavender: 'var(--color-lavender)',
  black: 'var(--color-black)',
  white: 'var(--color-white)',
  /* Queensland branch names */
  maroon: 'var(--color-maroon)',
  gold: 'var(--color-gold)',
  ochre: 'var(--color-gold-deep)',
  eucalyptus: 'var(--color-eucalyptus)',
  bottlebrush: 'var(--color-bottlebrush)',
}
const resolvedAccent = accentColors[shadow] ?? shadow

// Calculate rotation style
const rotationStyle = rotation !== 0 ? `rotate(${rotation}deg)` : 'rotate(0deg)'

const cardStyle = `border-top: 2px solid ${resolvedAccent}; transform: ${rotationStyle}; ${customStyle || ''}`
---

<div
  id={id}
  data-card-variant={variant}
  class:list={[
    bgColors[variant],
    'rounded-sm',
    paddingSizes[padding],
    'transition-colors duration-200',
    { 'hover:border-line-strong': hover && variant === 'surface' },
    className,
  ]}
  style={cardStyle}
>
  <slot />
</div>
