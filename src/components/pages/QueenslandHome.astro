---
import { getHomePage, client } from '@/lib/sanity'
const home = await getHomePage()
const issues = await client.fetch(`*[_type == 'investigation' && readyForPublication == true && defined(slug.current) && featuredOnHome == true && defined(publishedAt)] | order(homeOrder asc) { _id, title, summary, slug, shortTagline, nationalPolicyUrl, nationalPolicyName }`)
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import '@/styles/global.css'
---
<BaseLayout title={home?.seo?.metaTitle || home?.title || "Help shape our state"} description={home?.seo?.metaDescription || home?.hero?.subtitle || "Explore issues and help shape state policy."}>
<Header />
<main id="main-content" class="qld-home">
<header class="hero"><div class="shell"><p class="eyebrow">{home?.hero?.eyebrow || "Your state, your ideas"}</p><h1>{home?.hero?.title || "What should our state do differently?"}</h1><p>{home?.hero?.subtitle || "Explore the issues and help shape solutions."}</p><div class="actions"><a class="primary" href="#issues">Explore the issues ↓</a><a href="/contact">Share an idea →</a></div><small>These are starting points for discussion, not adopted Queensland policies.</small></div></header>
<section class="intro"><div class="shell steps">{[["01 / UNDERSTAND","Start with the issue"],["02 / KNOW THE LEVERS","See what the state can do"],["03 / READ THE FOUNDATION","Explore national policy"],["04 / HELP SHAPE IT","Recommend a state response"]].map(([number,label]) => <div><span>{number}</span><strong>{label}</strong></div>)}</div></section>
<section id="issues" class="section"><div class="shell"><p class="eyebrow">Starting points</p><h2>What matters to you?</h2><p class="lead">Each issue crosses federal and state responsibilities. Read Fusion's national position, then tell us what Queensland should do.</p><div class="issues">{issues.map((issue: any, index: number) => <article class="issue"><span class="num">{String(index + 1).padStart(2, '0')} / {String(issues.length).padStart(2, '0')}</span><h3>{issue.title}</h3><p>{issue.shortTagline || issue.summary}</p><a href={`/investigations/${issue.slug.current}`}>Explore the investigation →</a>{issue.nationalPolicyUrl && <a href={issue.nationalPolicyUrl} target="_blank" rel="noopener noreferrer">National policy ↗</a>}<a href="/contact">Share your perspective →</a></article>)}</div></div></section>
<section class="section alternate"><div class="shell"><p class="eyebrow">Participate beyond this site</p><h2>Have your say. Where it counts.</h2><p class="lead">Use official channels to comment on public decisions and petitions. Check eligibility and closing dates at the source.</p><div class="resources">{home?.participatoryResources?.map((resource: any) => <a href={resource.url} target="_blank" rel="noopener noreferrer">{resource.label} ↗</a>)}</div></div></section>
<section class="section"><div class="shell"><p class="eyebrow">From contribution to consideration</p><h2>How an idea could become policy</h2><p class="lead">Submitting an idea starts a conversation, not an endorsement or guarantee of adoption.</p><div class="stages">{home?.participatoryStages?.map((stage: any,i: number)=><div><span>{i+1}</span><strong>{stage.title}</strong><small>{stage.description}</small></div>)}</div><p class="fine">Proposed pathway only. Formal decisions must follow Fusion’s applicable party rules.</p></div></section>
<section class="section alternate"><div class="shell"><p class="eyebrow">Follow the evidence</p><h2>Investigations and evidence</h2><p class="lead">Questions worth examining, evidence worth sharing. Investigations are not adopted party policy.</p><a class="primary" href="/investigations">Explore investigations →</a></div></section>
<section class="section"><div class="shell"><p class="eyebrow">Help build the response</p><h2>Your experience matters.</h2><p class="lead">Tell us what is happening in your community, what should change and what evidence we should examine. Contributions inform discussion; they are not automatically endorsed as policy.</p><div class="actions"><a class="primary" href="/contact">Send your recommendation →</a><a href="https://www.fusionparty.org.au/policy">Read national policies ↗</a></div></div></section>
</main><Footer />
</BaseLayout>
<style>
.qld-home{color:var(--color-fg,#233d3a);background:#f9f7f2}.shell{max-width:1120px;margin:auto;padding:0 1.5rem}.hero{background:#27143d;color:#fff;padding:clamp(5rem,10vw,9rem) 0}.eyebrow{text-transform:uppercase;font-size:.8rem;letter-spacing:.16em;font-weight:800;color:#b4e5dc;margin-bottom:1.5rem}.hero h1{font-size:clamp(3rem,8vw,6rem);line-height:1.05;max-width:900px;font-weight:900;letter-spacing:-.04em}.hero h1 em{font-style:normal;color:#ffe078}.hero p{font-size:clamp(1.15rem,2.5vw,1.5rem);max-width:650px;margin:2rem 0}.actions{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:2rem 0}.actions a,.primary{display:inline-block;padding:1rem 1.4rem;font-weight:800;border:2px solid currentColor;text-decoration:none}.actions .primary,.primary{background:#6432aa;color:#fff;border-color:#6432aa}.hero .primary{background:#fff;color:#6432aa;border-color:#fff}.hero small{display:block;opacity:.8}.section{padding:clamp(4rem,8vw,7rem) 0}.section .eyebrow{color:#087b75}.section h2{font-size:clamp(2.3rem,5vw,4rem);font-weight:900;line-height:1.1}.lead{font-size:1.2rem;max-width:740px;margin:1.5rem 0 2.5rem}.issues{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem}.issue{background:white;border:1px solid #ddd5d8;border-radius:14px;padding:1.8rem;display:flex;flex-direction:column;gap:1rem}.issue .num{color:#6432aa;font-weight:800;font-size:.85rem}.issue h3{font-size:1.4rem;line-height:1.2;font-weight:800}.issue p{flex:1;color:#53505a}.issue a{font-weight:800;color:#087b75}.alternate{background:#efeaf5}
</style>
<style>.intro{padding:2rem 0;border-bottom:1px solid #dfd9e6}.steps,.stages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.steps div,.stages div{padding:1rem}.steps span,.stages span{display:block;color:#087b75;font-size:.8rem;font-weight:800}.steps strong,.stages strong{display:block;margin-top:.3rem}.stages div{background:white;border:1px solid #dfd9e6;border-radius:9px}.resources{display:flex;gap:1rem;flex-wrap:wrap}.resources a{padding:1.2rem;background:white;color:#6432aa;font-weight:800;border:1px solid #dfd9e6}.fine{margin-top:1rem;font-size:.9rem;opacity:.8}@media(max-width:650px){.steps,.stages{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{padding:3.5rem 0}}</style>