---
import { getHomePage, client } from '@/lib/sanity'
const home = await getHomePage()
const issues = await client.fetch(`*[_type == 'investigation' && readyForPublication == true && defined(slug.current) && attribution match '*Stewart Brooker*'] | order(_createdAt asc) { _id, title, summary, slug, body }`)
const nationalLink = (issue: any) => issue.body?.flatMap((block: any) => block.markDefs || []).find((mark: any) => mark._type === 'link' && typeof mark.href === 'string' && mark.href.startsWith('https://www.fusionparty.org.au/'))?.href
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import '@/styles/global.css'
---
<BaseLayout title="Help shape Queensland | Fusion Party Queensland" description="Explore ten issues facing Queensland, read Fusion's national policy foundations and help develop Queensland's response.">
<Header />
<main id="main-content" class="qld-home">
<header class="hero"><div class="shell"><p class="eyebrow">{home?.hero?.eyebrow || "Your state, your ideas"}</p><h1>{home?.hero?.title || "What should our state do differently?"}</h1><p>{home?.hero?.subtitle || "Explore the issues and help shape solutions."}</p><div class="actions"><a class="primary" href="#issues">Explore the issues ↓</a><a href="/contact">Share an idea →</a></div><small>These are starting points for discussion, not adopted Queensland policies.</small></div></header>
<section id="issues" class="section"><div class="shell"><p class="eyebrow">Starting points</p><h2>What matters to you?</h2><p class="lead">Each issue crosses federal and state responsibilities. Read Fusion's national position, then tell us what Queensland should do.</p><div class="issues">{issues.map((issue: any, index: number) => <article class="issue"><span class="num">{String(index + 1).padStart(2, '0')} / {String(issues.length).padStart(2, '0')}</span><h3>{issue.title}</h3><p>{issue.summary}</p><a href={`/investigations/${issue.slug.current}`}>Explore the investigation →</a>{nationalLink(issue) && <a href={nationalLink(issue)} target="_blank" rel="noopener noreferrer">National policy ↗</a>}<a href="/contact">Share your perspective →</a></article>)}</div></div></section>
<section class="section alternate"><div class="shell"><p class="eyebrow">Follow the evidence</p><h2>Queensland investigations</h2><p class="lead">Questions worth examining, evidence worth sharing. Investigations are not adopted party policy.</p><a class="primary" href="/investigations">Explore investigations →</a></div></section>
<section class="section"><div class="shell"><p class="eyebrow">Help build the response</p><h2>Your experience matters.</h2><p class="lead">Tell us what is happening in your community, what should change and what evidence we should examine. Contributions inform discussion; they are not automatically endorsed as policy.</p><div class="actions"><a class="primary" href="/contact">Send your recommendation →</a><a href="https://www.fusionparty.org.au/policy">Read national policies ↗</a></div></div></section>
</main><Footer />
</BaseLayout>
<style>
.qld-home{color:var(--color-fg,#233d3a);background:#fffaf3}.shell{max-width:1120px;margin:auto;padding:0 1.5rem}.hero{background:#233d3a;color:#fff7ec;padding:clamp(5rem,10vw,9rem) 0}.eyebrow{text-transform:uppercase;font-size:.8rem;letter-spacing:.16em;font-weight:800;color:#8fe0c8;margin-bottom:1.5rem}.hero h1{font-size:clamp(3rem,8vw,6rem);line-height:1.05;max-width:900px;font-weight:900;letter-spacing:-.04em}.hero h1 em{font-style:normal;color:#f4cd75}.hero p{font-size:clamp(1.15rem,2.5vw,1.5rem);max-width:650px;margin:2rem 0}.actions{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:2rem 0}.actions a,.primary{display:inline-block;padding:1rem 1.4rem;font-weight:800;border:2px solid currentColor;text-decoration:none}.actions .primary,.primary{background:#731e32;color:#fff7ec;border-color:#731e32}.hero .primary{background:#fff7ec;color:#233d3a;border-color:#fff7ec}.hero small{display:block;opacity:.8}.section{padding:clamp(4rem,8vw,7rem) 0}.section .eyebrow{color:#137c71}.section h2{font-size:clamp(2.3rem,5vw,4rem);font-weight:900;line-height:1.1}.lead{font-size:1.2rem;max-width:740px;margin:1.5rem 0 2.5rem}.issues{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem}.issue{background:white;border:1px solid #ddd5d8;border-radius:14px;padding:1.8rem;display:flex;flex-direction:column;gap:1rem}.issue .num{color:#731e32;font-weight:800;font-size:.85rem}.issue h3{font-size:1.4rem;line-height:1.2;font-weight:800}.issue p{flex:1;color:#53505a}.issue a{font-weight:800;color:#14796e}.alternate{background:#f0e9f3}
</style>