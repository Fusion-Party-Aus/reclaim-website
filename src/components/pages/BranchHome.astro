---
import { DEPLOYMENT } from '@/lib/deployment'
import { starterContent } from '../../../config/starter-content.mjs'
import { getHomePage, getPolicies, getElectorates } from '@/lib/sanity'
import BranchLanding from '@/components/layout/BranchLanding.astro'
interface BranchHomeContent {
  hero?: { title?: string; subtitle?: string }
  theftSection?: { heading?: string; description?: string }
  electoratesSection?: { heading?: string; description?: string }
}
const home = ((await getHomePage()) ||
  starterContent(DEPLOYMENT)[0]) as unknown as BranchHomeContent
const [policies, electorates] = await Promise.all([getPolicies(), getElectorates()])
---

<BranchLanding title={home.hero?.title} description={home.hero?.subtitle}>
  <section class="mt-20 border-t border-line pt-10" aria-labelledby="branch-policies">
    <h2 id="branch-policies" class="font-display font-bold text-4xl text-fg">
      {home.theftSection?.heading || 'Our policies'}
    </h2>
    <p class="text-muted mt-4 max-w-2xl">{home.theftSection?.description}</p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        policies
          .filter((policy) => policy.slug?.current)
          .map((policy) => (
            <li class="border border-line p-6 bg-surface-raised">
              <h3 class="font-display font-bold text-2xl">
                <a class="text-magenta" href={`/policies/${policy.slug.current}`}>
                  {policy.title}
                </a>
              </h3>
              <p class="text-muted mt-3">{policy.summary}</p>
            </li>
          ))
      }
    </ul>
  </section>
  <section class="mt-16 border-t border-line pt-10" aria-labelledby="branch-candidates">
    <h2 id="branch-candidates" class="font-display font-bold text-4xl text-fg">
      {home.electoratesSection?.heading || 'Our candidates'}
    </h2>
    <p class="text-muted mt-4">{home.electoratesSection?.description}</p>
    <ul class="mt-6 space-y-4">
      {
        electorates
          .filter((item) => item.slug?.current)
          .map((item) => (
            <li>
              <a class="text-magenta font-bold" href={`/electorates/${item.slug.current}`}>
                {item.candidateName || item.name}
              </a>
            </li>
          ))
      }
    </ul>
  </section>
</BranchLanding>
