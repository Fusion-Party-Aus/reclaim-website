---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Header } from '@/components/layout/Header'
import { Footer } from '@/components/layout/Footer'
import Ribbon from '@/components/horizon/Ribbon.astro'
import {
  getHomePage,
  getPolicies,
  getResearchResources,
  getLatestPosts,
  getElectionGuides,
  getElectionArticles,
  urlFor,
} from '@/lib/sanity'
import { selectPolicies, selectResearch, formatDate } from '@/lib/homepage'
import type { Policy, SanityImageAsset } from '@/types/sanity'
import '@/styles/global.css'
interface EditorialHome {
  title?: string
  seo?: { metaTitle?: string; metaDescription?: string }
  hero?: {
    eyebrow?: string
    title?: string
    subtitle?: string
    image?: SanityImageAsset & { alt?: string }
  }
  theftSection?: { heading?: string; description?: string; featuredPolicies?: Policy[] }
  manifestoSection?: { heading?: string; description?: string }
  joinSection?: { heading?: string; description?: string }
}
const [home, posts, resources, policies, guides, electionArticles] = await Promise.all([
  getHomePage(),
  getLatestPosts(),
  getResearchResources(),
  getPolicies({ adoptedOnly: true }),
  getElectionGuides(),
  getElectionArticles(),
])
const hp = (home || {}) as EditorialHome
const featuredPolicies = selectPolicies(hp.theftSection?.featuredPolicies, policies)
const research = selectResearch(resources)
const heroImage = hp.hero?.image?.asset
  ? urlFor(hp.hero.image).width(1400).auto('format').url()
  : null
---

<BaseLayout
  title={hp.seo?.metaTitle || 'Fusion Victoria'}
  description={hp.seo?.metaDescription ||
    'Fusion Victoria: policies, research, public submissions and election analysis.'}
>
  <Header />
  <main id="main-content" class="horizon-home">
    <section class="horizon-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{hp.hero?.eyebrow || 'Fusion Victoria'}</p>
        <h1 id="hero-title">{hp.hero?.title || 'Better places. Better systems. More freedom.'}</h1>
        <p class="hero-intro">
          {
            hp.hero?.subtitle ||
              'Evidence-led policies, independent research and practical reform for Victoria.'
          }
        </p>
        <div class="horizon-actions">
          <a class="horizon-button" href="/policies">Explore our policies</a><a
            class="horizon-button outline"
            href="/get-involved">Get involved</a
          >
        </div>
      </div>
      {
        heroImage && (
          <div class="hero-photo">
            <img src={heroImage} alt={hp.hero?.image?.alt || ''} fetchpriority="high" />
          </div>
        )
      }
      <Ribbon />
    </section>
    {
      posts[0] && (
        <aside class="latest-strip horizon-shell" aria-label="Latest update">
          <>
            <span class="eyebrow">Latest update</span>
            <a href={`/blog/${posts[0].slug.current}`}>
              {posts[0].title} <span aria-hidden="true">→</span>
            </a>
            <time datetime={posts[0].publishedAt}>{formatDate(posts[0].publishedAt)}</time>
          </>
        </aside>
      )
    }
    <section class="horizon-shell horizon-section intro" aria-labelledby="beliefs-heading">
      <h2 id="beliefs-heading">Ideas judged by<br />what they deliver.</h2>
      <div>
        <p class="eyebrow">Reason. Rights. Results.</p><p>
          {
            hp.manifestoSection?.description ||
              'A strong common floor, wide freedom above it, and government that shows its work.'
          }
        </p><a href="/manifesto">How we think <span aria-hidden="true">→</span></a>
      </div>
      <Ribbon variant="sweep" />
    </section>
    <section class="horizon-section tinted" aria-labelledby="latest-heading">
      <div class="horizon-shell">
        <div class="section-heading">
          <h2 id="latest-heading">Latest from Fusion</h2><a href="/blog"
            >All news &amp; analysis →</a
          >
        </div>
        <div class="horizon-grid">
          {
            posts.map((post) => (
              <article class="horizon-card">
                {post.featuredImage?.asset && (
                  <a
                    class="card-image"
                    href={`/blog/${post.slug.current}`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={urlFor(post.featuredImage).width(800).fit('max').auto('format').url()}
                      alt=""
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="card-copy">
                  <h3>
                    <a href={`/blog/${post.slug.current}`}>{post.title}</a>
                  </h3>
                  {post.excerpt && <p>{post.excerpt}</p>}
                </div>
              </article>
            ))
          }
        </div>
        {
          !posts.length && (
            <p>
              New articles will appear here when published.{' '}
              <a href="/blog">Visit news &amp; analysis</a>.
            </p>
          )
        }
      </div>
    </section>
    {
      (guides.length > 0 || electionArticles.length > 0) && (
        <section class="horizon-section horizon-shell" aria-labelledby="election-heading">
          <div class="section-heading">
            <>
              <h2 id="election-heading">Victoria votes, 2026</h2>
              <a href="/election">Election coverage →</a>
            </>
          </div>
          <p class="section-deck">
            Fusion Victoria is not contesting this election. Our coverage examines documented
            commitments and publishes editorially approved voting recommendations.
          </p>
          <div class="horizon-grid">
            {electionArticles.slice(0, 3).map((post) => (
              <article class="horizon-card card-copy">
                <p class="card-meta">
                  Analysis · <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                </p>
                <h3>
                  <a href={`/blog/${post.slug.current}`}>{post.title}</a>
                </h3>
                <p>{post.excerpt}</p>
              </article>
            ))}
            {guides.slice(0, 3).map((guide) => (
              <article class="horizon-card card-copy">
                <p class="card-meta">
                  {guide.house === 'upper'
                    ? 'Legislative Council region'
                    : 'Legislative Assembly district'}
                </p>
                <h3>
                  <a href={`/election/${guide.slug.current}`}>{guide.electorateName}</a>
                </h3>
                <p>{guide.summary}</p>
                <p class="card-meta">Updated {formatDate(guide.updatedAt || guide.publishedAt)}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }
    <section class="horizon-section horizon-shell" aria-labelledby="research-heading">
      <div class="section-heading">
        <h2 id="research-heading">Research and evidence</h2><a href="/research">All research →</a>
      </div>
      <p class="section-deck">
        Examine the sources, methods and limitations behind our work. Research findings inform
        debate; they are distinct from adopted party policy.
      </p>
      <div class="horizon-grid">
        {
          research.map((resource) => (
            <article class="horizon-card card-copy">
              <>
                <p class="card-meta">
                  {resource.researchArea} · {resource.resourceType}
                </p>
                <h3>
                  <a href={`/research/${resource.slug.current}`}>{resource.title}</a>
                </h3>
                <p>{resource.abstract}</p>
                <p class="card-meta">
                  <time datetime={resource.publishedAt}>{formatDate(resource.publishedAt)}</time>
                  {resource.version && <span>Version {resource.version}</span>}
                </p>
              </>
            </article>
          ))
        }
      </div>
      {
        !research.length && (
          <p>
            Published research will appear here.{' '}
            <a href="/research">Explore our research collection</a>.
          </p>
        )
      }
    </section>
    <section class="horizon-section tinted" aria-labelledby="policies-heading">
      <div class="horizon-shell">
        <div class="section-heading">
          <h2 id="policies-heading">{hp.theftSection?.heading || 'Our policies'}</h2><a
            href="/policies">All policies →</a
          >
        </div>
        <p class="section-deck">
          {
            hp.theftSection?.description ||
              'Explore Fusion Victoria’s adopted policy positions and the evidence behind them.'
          }
        </p>
        <div class="horizon-grid">
          {
            featuredPolicies.map((policy) => (
              <article class="horizon-card card-copy">
                <>
                  <p class="card-meta">Adopted policy</p>
                  <h3>
                    <a href={`/policies/${policy.slug.current}`}>{policy.title}</a>
                  </h3>
                  <p>{policy.summary}</p>
                  <a href={`/policies/${policy.slug.current}`}>Read the policy →</a>
                </>
              </article>
            ))
          }
        </div>
        {
          !featuredPolicies.length && (
            <p>
              <a href="/policies">Explore the policy collection</a>.
            </p>
          )
        }
      </div>
    </section>
    <section class="horizon-section participation" aria-labelledby="participate-heading">
      <div class="horizon-shell">
        <p class="eyebrow">Participate between elections</p><h2 id="participate-heading">
          {hp.joinSection?.heading || 'Take part in public life'}
        </h2><p class="section-deck">
          {
            hp.joinSection?.description ||
              'Help develop policy, contribute research, make public submissions and organise in your community.'
          }
        </p>
        <div class="horizon-actions">
          <a class="horizon-button" href="https://fusionparty.org.au/join">Join Fusion</a><a
            class="horizon-button outline"
            href="/contact">Contribute research or volunteer</a
          ><a class="horizon-button outline" href="/get-involved">Ways to get involved</a>
        </div>
      </div><Ribbon variant="band" />
    </section>
  </main>
  <Footer />
</BaseLayout>
