---
interface TableBlock {
  _type: 'table'
  rows?: Array<{ _type: string; cells: string[] }>
}

const block = Astro.props.node as TableBlock
const rows = block.rows || []
---

<div class="table-wrapper" style="overflow-x: auto; margin-bottom: 2rem;">
  <table
    class="w-full text-left border-collapse border border-line rounded-sm"
    style="min-width: 600px;"
  >
    <tbody>
      {
        rows.map((row, rowIndex) => (
          <tr>
            {row.cells.map((cellText) =>
              rowIndex === 0 ? (
                <th class="border border-line bg-yellow p-4 font-bold text-lg text-on-accent surface-accent">
                  {cellText || ''}
                </th>
              ) : (
                <td class="border border-line p-4 bg-grey-dark text-fg font-medium surface-paper">
                  {cellText || ''}
                </td>
              )
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
